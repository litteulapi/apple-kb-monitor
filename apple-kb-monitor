}


def identify_chip(pid):
    for (lo, hi), chip in BCM_CHIPS.items():
        if lo <= pid <= hi:
            return chip
    return "Broadcom (unknown variant)"


# ---------------------------------------------------------------------------
# Device discovery
# ---------------------------------------------------------------------------

def find_devices():
    """Find all Apple Bluetooth keyboards via hidraw sysfs."""
    devices = []
    for hidraw in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        uevent_path = os.path.join(hidraw, "device", "uevent")
        try:
            uevent = Path(uevent_path).read_text()
        except OSError:
            continue
        props = dict(
            line.split("=", 1)
            for line in uevent.strip().splitlines()
            if "=" in line
        )
        hid_id = props.get("HID_ID", "")
        parts = hid_id.split(":")
        if len(parts) != 3:
            continue
        bus, vid, pid = parts
        if bus != "0005":
            continue
        if int(vid, 16) != APPLE_VID:
            continue

        pid_int = int(pid, 16)
        mac = props.get("HID_UNIQ", "")
        devnode = f"/dev/{os.path.basename(hidraw)}"
        ps_path = f"/sys/class/power_supply/hid-{mac}-battery" if mac else None

        # Find evdev input
        evdev = None
        for inp in glob.glob(os.path.join(hidraw, "device", "input", "input*")):
            for ev in glob.glob(os.path.join(inp, "event*")):
                evdev = f"/dev/input/{os.path.basename(ev)}"
                break

        devices.append({
            "path": devnode,
            "sysfs": hidraw,
            "name": props.get("HID_NAME", "Apple Keyboard"),
            "mac": mac,
            "pid": pid_int,
            "model": APPLE_PRODUCTS.get(pid_int, f"Apple Keyboard (0x{pid_int:04X})"),
            "chip": identify_chip(pid_int),
            "ps_path": ps_path,
            "evdev": evdev,
            "driver": props.get("DRIVER", ""),
        })
    return devices


# ---------------------------------------------------------------------------
# HID Feature Report reads
# ---------------------------------------------------------------------------

def hid_get_feature(devpath, report_id, length=16):
    """Read a HID Feature Report from hidraw device."""
    fd = None
    try:
        fd = os.open(devpath, os.O_RDWR)
        buf = bytearray(length)
        buf[0] = report_id
        fcntl.ioctl(fd, HIDIOCGFEATURE(length), buf)
        return bytes(buf)
    except (OSError, IOError):
        return None
    finally:
        if fd is not None:
            os.close(fd)


def read_all_reports(devpath):
    """Read all known Feature Reports and return decoded dict."""
    r = {}

    # Battery percentage (standard)
    d = hid_get_feature(devpath, REP_BATTERY_PCT)
    if d and d[0] == REP_BATTERY_PCT:
        r["battery_pct"] = d[1]

    # Battery precise (vendor)
    d = hid_get_feature(devpath, REP_BATTERY_FINE)
    if d and d[0] == REP_BATTERY_FINE:
        r["battery_fine"] = d[1]

    # Raw ADC voltage
    d = hid_get_feature(devpath, REP_ADC_VOLTAGE)
    if d and d[0] == REP_ADC_VOLTAGE:
        raw = (d[1] << 8) | d[2]
        r["adc_raw"] = raw
        if raw <= ADC_MAX:
            r["voltage"] = round(raw / ADC_MAX * ADC_VREF, 3)

    # ADC reference
    d = hid_get_feature(devpath, REP_ADC_REF)
    if d and d[0] == REP_ADC_REF:
        r["adc_ref"] = (d[1] << 8) | d[2]

    # Calibration curve (4 x 16-bit thresholds in millivolts)
    d = hid_get_feature(devpath, REP_CALIB_CURVE)
    if d and d[0] == REP_CALIB_CURVE:
        thresholds_mv = []
        for i in range(4):
            off = 1 + i * 2
            thresholds_mv.append((d[off] << 8) | d[off + 1])
        r["calib_thresholds_mv"] = thresholds_mv
        r["calib_voltages"] = [round(t / 1000, 3) for t in thresholds_mv]

    # Voltage reference pair
    d = hid_get_feature(devpath, REP_VOLT_REF)
    if d and d[0] == REP_VOLT_REF:
        r["volt_ref_1"] = (d[1] << 8) | d[2]
        r["volt_ref_2"] = (d[3] << 8) | d[4]

    # Firmware version
    d = hid_get_feature(devpath, REP_FW_VERSION)
    if d and d[0] == REP_FW_VERSION:
        r["fw_byte"] = d[1]
        r["fw_version"] = f"{d[1] >> 4}.{d[1] & 0x0F}"

    # Build/revision
    d = hid_get_feature(devpath, REP_BUILD_REV)
    if d and d[0] == REP_BUILD_REV:
        r["build_number"] = (d[1] << 8) | d[2]
        r["build_flag"] = d[3]

    # Device name (3 chunks)
    name_parts = []
    for rid in [REP_NAME_1, REP_NAME_2, REP_NAME_3]:
        d = hid_get_feature(devpath, rid)
        if d and d[0] == rid:
            name_parts.append(d[1:16].split(b"\x00")[0].decode("ascii", errors="replace"))
    if name_parts:
        r["device_name"] = "".join(name_parts)

    # Device identity (128-bit)
    d = hid_get_feature(devpath, REP_IDENTITY)
    if d and d[0] == REP_IDENTITY:
        r["identity_type"] = d[1]
        r["identity_key"] = d[2:16].hex()

    # Device state
    d = hid_get_feature(devpath, REP_DEVICE_STATE)
    if d and d[0] == REP_DEVICE_STATE:
        r["state_flag"] = d[1]

    # BT connection params
    d = hid_get_feature(devpath, REP_BT_CONN_PARAMS)
    if d and d[0] == REP_BT_CONN_PARAMS:
        r["bt_interval"] = d[1]
        r["bt_latency"] = d[2]

    # BT timing
    d = hid_get_feature(devpath, REP_BT_TIMING)
    if d and d[0] == REP_BT_TIMING:
        r["bt_timeout"] = d[1]
        r["bt_timing_2"] = d[2]

    # Power config
    d = hid_get_feature(devpath, REP_POWER_CFG)
    if d and d[0] == REP_POWER_CFG:
        r["power_cfg"] = d[1]

    # Mode/class
    d = hid_get_feature(devpath, REP_MODE_CLASS)
    if d and d[0] == REP_MODE_CLASS:
        r["mode"] = d[1]
        r["dev_class"] = d[2]

    # Config registers
    for rid, key in [(REP_CFG_REG_1, "cfg_reg_1"), (REP_CFG_REG_2, "cfg_reg_2")]:
        d = hid_get_feature(devpath, rid)
        if d and d[0] == rid:
            r[key] = d[1:4].hex()

    # Calibration ROM mirrors (0x60, 0xEB) — verify consistency with 0x5A
    for rid, key in [(REP_CALIB_MIRROR_1, "calib_mirror_0x60"),
                     (REP_CALIB_MIRROR_2, "calib_mirror_0xEB")]:
        d = hid_get_feature(devpath, rid)
        if d and d[0] == rid:
            thresholds = []
            for i in range(4):
                off = 1 + i * 2
                if off + 1 < len(d):
                    thresholds.append((d[off] << 8) | d[off + 1])
            r[key] = thresholds
            # Flag inconsistency if mirrors differ from primary curve
            primary = r.get("calib_thresholds_mv")
            if primary and thresholds != primary:
                r[f"{key}_mismatch"] = True

    # Interpolated battery % from voltage + calibration curve
    volts = r.get("voltage")
    thresholds = r.get("calib_thresholds_mv")
    if volts is not None and thresholds and len(thresholds) == 4:
        mv = int(volts * 1000)
        # Thresholds: [100%, 75%, 50%, 25%] in mV (descending)
        # Interpolate linearly between segments
        pct_levels = [100, 75, 50, 25, 0]
        mv_levels = thresholds + [0]  # add 0 mV = 0%
        if mv >= mv_levels[0]:
            r["battery_interpolated"] = 100
        elif mv <= 0:
            r["battery_interpolated"] = 0
        else:
            for i in range(len(mv_levels) - 1):
                if mv >= mv_levels[i + 1]:
                    hi_pct, lo_pct = pct_levels[i], pct_levels[i + 1]
                    hi_mv, lo_mv = mv_levels[i], mv_levels[i + 1]
                    if hi_mv == lo_mv:
                        r["battery_interpolated"] = hi_pct
                    else:
                        frac = (mv - lo_mv) / (hi_mv - lo_mv)
                        r["battery_interpolated"] = round(lo_pct + frac * (hi_pct - lo_pct))
                    break

    return r


# ---------------------------------------------------------------------------
# HID Input Report monitoring (async)
# ---------------------------------------------------------------------------

def decode_input_report(data):
    """Decode a HID Input Report from the keyboard."""
    if not data or len(data) < 2:
        return None
    rid = data[0]
    if rid == REP_VENDOR_WAKE:
        # Vendor FF01 — wake/connection signal
        bits = data[1]
        return {
            "report_id": rid,
            "type": "vendor_wake",
            "device_ready": bool(bits & 0x01),       # Usage 0x0A
            "connection_request": bool(bits & 0x02),  # Usage 0x0C (relative)
            "raw": bits,
        }
    return {"report_id": rid, "type": "unknown", "raw": data.hex()}


class HidrawMonitor:
    """Non-blocking async monitor for HID Input Reports on hidraw device."""

    def __init__(self, devpath):
        self.devpath = devpath
        self._fd = None
        self._loop = None
        self.last_wake = None  # timestamp of last wake event

    def start(self, loop, callback):
        """Start monitoring. callback(event_dict) called for each input report."""
        try:
            self._fd = os.open(self.devpath, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            return False
        self._loop = loop
        self._callback = callback
        loop.add_reader(self._fd, self._on_readable)
        return True

    def stop(self):
        if self._fd is not None:
            if self._loop:
                try:
                    self._loop.remove_reader(self._fd)
                except Exception:
                    pass
            os.close(self._fd)
            self._fd = None

    def _on_readable(self):
        try:
            data = os.read(self._fd, 256)
        except BlockingIOError:
            return
        except OSError:
            self.stop()
            return
        if not data:
            return
        event = decode_input_report(data)
        if event:
            if event.get("type") == "vendor_wake":
                self.last_wake = datetime.now().isoformat()
            self._callback(event)


# ---------------------------------------------------------------------------
# Raw dump (all 256 report IDs)
# ---------------------------------------------------------------------------

def dump_all_reports(devpath):
    """Scan all 256 Feature Report IDs, return those with data."""
    results = []
    fd = None
    try:
        fd = os.open(devpath, os.O_RDWR)
        for rid in range(256):
            buf = bytearray(64)
            buf[0] = rid
            try:
                fcntl.ioctl(fd, HIDIOCGFEATURE(64), buf)
                if any(buf[1:]):
                    last = 63
                    while last > 0 and buf[last] == 0:
                        last -= 1
                    results.append((rid, bytes(buf[: last + 1])))
            except (OSError, IOError):
                pass
    finally:
        if fd is not None:
            os.close(fd)
    return results


# ---------------------------------------------------------------------------
# BlueZ MGMT (RSSI / TX Power)
# ---------------------------------------------------------------------------

RSSI_HELPER = Path(__file__).parent / "rssi-helper"
RSSI_HELPER_INSTALLED = Path("/usr/lib/apple-kb-monitor/rssi-helper")


def get_conn_info(mac):
    """Get RSSI and TX power via rssi-helper (CAP_NET_ADMIN) or raw MGMT socket.

    Tries the setcap'd rssi-helper binary first (works without root),
    falls back to direct MGMT socket (requires CAP_NET_ADMIN / root).
    RSSI=0 dBm is valid (optimal signal, "golden range").
    """
    # Try rssi-helper binary (setcap'd, no root needed)
    for helper in [RSSI_HELPER_INSTALLED, RSSI_HELPER]:
        if helper.is_file():
            try:
                r = subprocess.run(
                    [str(helper), mac],
                    capture_output=True, text=True, timeout=3,
                )
                if r.returncode == 0:
                    d = json.loads(r.stdout)
                    return {
                        "rssi_dbm": d["rssi"],
                        "tx_power_dbm": d["tx_power"],
                        "max_tx_power_dbm": d["max_tx_power"],
                    }
            except (subprocess.TimeoutExpired, json.JSONDecodeError, KeyError,
                    FileNotFoundError):
                pass
            break

    # Fallback: direct MGMT socket (needs CAP_NET_ADMIN)
    try:
        sock = socket.socket(31, socket.SOCK_RAW, BTPROTO_HCI)
        sock.bind((0xFFFF, HCI_CHANNEL_CONTROL))
        sock.settimeout(2)

        addr_bytes = bytes(int(x, 16) for x in mac.split(":"))
        addr_le = bytes(reversed(addr_bytes))
        payload = addr_le + struct.pack("B", 0x00)

        header = struct.pack("<HHH", MGMT_OP_GET_CONN_INFO, 0, len(payload))
        sock.send(header + payload)
        data = sock.recv(1024)
        sock.close()

        if len(data) < 19:
            return None
        if struct.unpack_from("<H", data, 0)[0] != MGMT_EV_CMD_COMPLETE:
            return None
        if data[8] != 0:
            return None

        rssi = struct.unpack_from("<b", data, 16)[0]
        tx_power = struct.unpack_from("<b", data, 17)[0]
        max_tx = struct.unpack_from("<b", data, 18)[0]

        return {"rssi_dbm": rssi, "tx_power_dbm": tx_power, "max_tx_power_dbm": max_tx}
    except (OSError, TimeoutError, PermissionError):
        return None


def rssi_quality(rssi):
    if rssi is None:
        return "N/A"
    if rssi >= -10:
        return "Optimal (golden range)"
    if rssi >= -65:
        return "Good"
    if rssi >= -80:
        return "Fair"
    return "Poor"


# ---------------------------------------------------------------------------
# BlueZ D-Bus (async via dbus-fast)
# ---------------------------------------------------------------------------

async def get_bluez_props(bus, mac):
    """Get device properties from BlueZ via D-Bus."""
    obj_path = "/org/bluez/hci0/dev_" + mac.upper().replace(":", "_")
    reply = await bus.call(Message(
        destination=BLUEZ_SERVICE,
        path=obj_path,
        interface="org.freedesktop.DBus.Properties",
        member="GetAll",
        signature="s",
        body=["org.bluez.Device1"],
    ))
    if reply.message_type == MessageType.ERROR:
        return {}
    return {k: v.value for k, v in reply.body[0].items()}


def parse_modalias(modalias):
    if not modalias or not modalias.startswith("usb:"):
        return None
    try:
        p = modalias[4:]
        return {
            "vendor_id": f"0x{int(p[1:5], 16):04X}",
            "product_id": f"0x{int(p[6:10], 16):04X}",
            "fw_version": f"{int(p[11:15], 16) >> 8}.{int(p[11:15], 16) & 0xFF:02d}",
        }
    except (ValueError, IndexError):
        return None


# ---------------------------------------------------------------------------
# sysfs
# ---------------------------------------------------------------------------

def read_sysfs(ps_path):
    if not ps_path or not os.path.isdir(ps_path):
        return {}
    result = {}
    for attr in ["capacity", "status", "present", "scope", "model_name", "type"]:
        try:
            result[attr] = (Path(ps_path) / attr).read_text().strip()
        except OSError:
            pass
    return result


# ---------------------------------------------------------------------------
# Input capabilities
# ---------------------------------------------------------------------------

def read_input_caps(evdev):
    if not evdev:
        return {}
    sysfs = f"/sys/class/input/{os.path.basename(evdev)}/device"
    result = {}
    for attr in ["name", "phys", "uniq"]:
        try:
            result[attr] = (Path(sysfs) / attr).read_text().strip()
        except OSError:
            pass
    cap_dir = Path(sysfs) / "capabilities"
    if cap_dir.is_dir():
        caps = {}
        for f in cap_dir.iterdir():
            try:
                caps[f.name] = f.read_text().strip()
            except OSError:
                pass
        result["capabilities"] = caps
    return result



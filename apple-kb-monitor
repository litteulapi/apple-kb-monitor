                print(f"apple_kb_tx_power_dbm{{{labels}}} {conn['tx_power_dbm']}")
        interval = reps.get("bt_interval")
        if interval is not None:
            print(f"apple_kb_bt_interval_ms{{{labels}}} {interval * 1.25}")
        latency = reps.get("bt_latency")
        if latency is not None:
            print(f"apple_kb_bt_latency{{{labels}}} {latency}")


# ---------------------------------------------------------------------------
# BlueZ Battery Provider
# ---------------------------------------------------------------------------

if HAS_DBUS_FAST:

    class ProviderObjectManager(ServiceInterface):
        """org.freedesktop.DBus.ObjectManager — required by BlueZ to
        discover battery objects under our provider root path."""

        def __init__(self):
            super().__init__("org.freedesktop.DBus.ObjectManager")
            self._objects = {}  # child_path -> {iface_name: {prop_name: Variant}}

        @method()
        def GetManagedObjects(self) -> 'a{oa{sa{sv}}}':
            return self._objects

        @dbus_signal()
        def InterfacesAdded(self, path, ifaces) -> 'oa{sa{sv}}':
            return [path, ifaces]

        @dbus_signal()
        def InterfacesRemoved(self, path, ifaces) -> 'oas':
            return [path, ifaces]

        def add_battery(self, child_path, bluez_dev_path, percentage, source):
            props = {
                "Percentage": Variant("y", percentage),
                "Device": Variant("o", bluez_dev_path),
                "Source": Variant("s", source),
            }
            self._objects[child_path] = {"org.bluez.BatteryProvider1": props}
            self.InterfacesAdded(child_path, {"org.bluez.BatteryProvider1": props})

        def remove_battery(self, child_path):
            if child_path in self._objects:
                del self._objects[child_path]
                self.InterfacesRemoved(child_path, ["org.bluez.BatteryProvider1"])

        def update_percentage(self, child_path, percentage):
            if child_path in self._objects:
                self._objects[child_path]["org.bluez.BatteryProvider1"]["Percentage"] = Variant("y", percentage)


    class BatteryProviderIface(ServiceInterface):
        """org.bluez.BatteryProvider1 — per-device battery object.
        BlueZ reads Percentage from here and exposes it as Battery1
        on the device path, which UPower and KDE pick up natively."""

        def __init__(self, bluez_dev_path, percentage=0, source=""):
            super().__init__("org.bluez.BatteryProvider1")
            self._device = bluez_dev_path
            self._percentage = percentage
            self._source = source

        @dbus_property(access=PropertyAccess.READ)
        def Percentage(self) -> 'y':
            return self._percentage

        @dbus_property(access=PropertyAccess.READ)
        def Device(self) -> 'o':
            return self._device

        @dbus_property(access=PropertyAccess.READ)
        def Source(self) -> 's':
            return self._source

        def update(self, pct):
            old = self._percentage
            self._percentage = max(0, min(100, pct))
            if self._percentage != old:
                self.emit_properties_changed({"Percentage": self._percentage})


    class BatteryProvider:
        """Manages Battery Provider lifecycle with BlueZ.

        Flow: register() -> BlueZ calls GetManagedObjects -> sees our
        battery objects -> creates org.bluez.Battery1 on device path ->
        UPower picks it up -> KDE/GNOME battery widget shows it.
        """

        def __init__(self, bus):
            self.bus = bus
            self.om = ProviderObjectManager()
            self.batteries = {}       # mac -> BatteryProviderIface
            self._registered = False
            bus.export(PROVIDER_ROOT, self.om)

        async def register(self):
            """Register with BlueZ BatteryProviderManager1."""
            reply = await self.bus.call(Message(
                destination=BLUEZ_SERVICE,
                path="/org/bluez/hci0",
                interface=BATTERY_PROVIDER_MANAGER_IFACE,
                member="RegisterBatteryProvider",
                signature="o",
                body=[PROVIDER_ROOT],
            ))
            if reply.message_type == MessageType.ERROR:
                err = reply.body[0] if reply.body else "unknown"
                print(f"[provider] registration failed: {err}", file=sys.stderr)
                return False
            self._registered = True
            return True

        async def unregister(self):
            if not self._registered:
                return
            try:
                await self.bus.call(Message(
                    destination=BLUEZ_SERVICE,
                    path="/org/bluez/hci0",
                    interface=BATTERY_PROVIDER_MANAGER_IFACE,
                    member="UnregisterBatteryProvider",
                    signature="o",
                    body=[PROVIDER_ROOT],
                ))
            except Exception:
                pass
            self._registered = False

        def add_device(self, mac, percentage):
            mac_path = mac.upper().replace(":", "_")
            child_path = f"{PROVIDER_ROOT}/dev_{mac_path}"
            bluez_dev_path = f"/org/bluez/hci0/dev_{mac_path}"
            source = f"apple-kb-monitor v{__version__} (HID 0xEA)"

            bp = BatteryProviderIface(bluez_dev_path, percentage, source)
            self.bus.export(child_path, bp)
            self.batteries[mac] = bp
            self.om.add_battery(child_path, bluez_dev_path, percentage, source)

        def remove_device(self, mac):
            if mac not in self.batteries:
                return
            mac_path = mac.upper().replace(":", "_")
            child_path = f"{PROVIDER_ROOT}/dev_{mac_path}"
            self.bus.unexport(child_path, self.batteries[mac])
            del self.batteries[mac]
            self.om.remove_battery(child_path)

        def update_device(self, mac, percentage):
            if mac not in self.batteries:
                return
            self.batteries[mac].update(percentage)
            mac_path = mac.upper().replace(":", "_")
            child_path = f"{PROVIDER_ROOT}/dev_{mac_path}"
            self.om.update_percentage(child_path, percentage)


# ---------------------------------------------------------------------------
# Async daemon
# ---------------------------------------------------------------------------

async def _setup_provider(bus):
    """Create Battery Provider and register with BlueZ."""
    provider = BatteryProvider(bus)
    devices = find_devices()
    for dev in devices:
        reps = read_all_reports(dev["path"])
        pct = reps.get("battery_fine") or reps.get("battery_pct") or 0
        provider.add_device(dev["mac"], pct)

    ok = await provider.register()
    if ok:
        print(f"[provider] registered — {len(devices)} device(s) exposed to BlueZ", file=sys.stderr)
    else:
        print("[provider] registration failed — BlueZ may not support BatteryProvider", file=sys.stderr)
    return provider


async def daemon_loop(threshold, interval, no_provider=False):
    """Main async daemon: Battery Provider + telemetry monitor."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)

    if not HAS_DBUS_FAST:
        print("dbus-fast not installed — running without Battery Provider", file=sys.stderr)
        no_provider = True

    provider = None
    bus = None
    bluez_reregister = asyncio.Event()

    if not no_provider:
        bus = await MessageBus(bus_type=BusType.SYSTEM).connect()
        provider = await _setup_provider(bus)

        # --- Monitor BlueZ signals ---
        for match_rule in [
            # 1. PropertiesChanged for device connect/disconnect
            "type='signal',sender='org.bluez',"
            "interface='org.freedesktop.DBus.Properties',"
            "member='PropertiesChanged',path_namespace='/org/bluez'",
            # 2. InterfacesAdded for device (re)appearance after adapter power cycle
            "type='signal',sender='org.bluez',"
            "interface='org.freedesktop.DBus.ObjectManager',"
            "member='InterfacesAdded'",
            # 3. InterfacesRemoved for device disappearance
            "type='signal',sender='org.bluez',"
            "interface='org.freedesktop.DBus.ObjectManager',"
            "member='InterfacesRemoved'",
            # 4. NameOwnerChanged for BlueZ daemon restart
            "type='signal',interface='org.freedesktop.DBus',"
            "member='NameOwnerChanged',arg0='org.bluez'",
        ]:
            await bus.call(Message(
                destination="org.freedesktop.DBus",
                path="/org/freedesktop/DBus",
                interface="org.freedesktop.DBus",
                member="AddMatch",
                signature="s",
                body=[match_rule],
            ))

        bluez_reregister = asyncio.Event()

        def on_dbus_signal(msg):
            try:
                _handle_dbus_signal(msg, provider, bluez_reregister)
            except Exception as e:
                print(f"[signal] handler error: {e}", file=sys.stderr)

        def _handle_dbus_signal(msg, prov, reregister_event):
            if msg.message_type != MessageType.SIGNAL:
                return

            # BlueZ daemon restart
            if msg.member == "NameOwnerChanged" and msg.body[0] == "org.bluez":
                old_owner, new_owner = msg.body[1], msg.body[2]
                if old_owner == "" and new_owner != "":
                    print("[event] BlueZ started — scheduling re-registration", file=sys.stderr)
                    reregister_event.set()
                elif old_owner != "" and new_owner == "":
                    print("[event] BlueZ stopped — provider invalidated", file=sys.stderr)
                    prov.batteries.clear()
                    prov._registered = False
                return

            # Device appeared (InterfacesAdded) — happens after adapter power cycle
            if msg.member == "InterfacesAdded":
                obj_path = msg.body[0]
                ifaces = msg.body[1]
                if not obj_path.startswith("/org/bluez/hci0/dev_"):
                    return
                # Check if device has Device1 interface and is connected
                dev1 = ifaces.get("org.bluez.Device1", {})
                connected_v = dev1.get("Connected")
                connected = connected_v.value if connected_v else False
                if connected:
                    mac = obj_path.split("/")[-1].replace("dev_", "").replace("_", ":")
                    new_devs = find_devices()
                    for d in new_devs:
                        if d["mac"].upper() == mac.upper():
                            reps = read_all_reports(d["path"])
                            pct = reps.get("battery_fine") or reps.get("battery_pct") or 0
                            if mac not in prov.batteries:
                                prov.add_device(mac, pct)
                            else:
                                prov.update_device(mac, pct)
                            print(f"[event] {mac} appeared (connected) — battery {pct}%", file=sys.stderr)
                            break
                return

            # Device disappeared (InterfacesRemoved) — adapter power off
            if msg.member == "InterfacesRemoved":
                obj_path = msg.body[0]
                if not obj_path.startswith("/org/bluez/hci0/dev_"):
                    return
                if obj_path == "/org/bluez/hci0":
                    # Adapter removed — schedule re-registration when it comes back
                    print("[event] adapter removed — provider invalidated", file=sys.stderr)
                    prov.batteries.clear()
                    prov._registered = False
                    reregister_event.set()
                    return
                mac = obj_path.split("/")[-1].replace("dev_", "").replace("_", ":")
                prov.remove_device(mac)
                print(f"[event] {mac} removed", file=sys.stderr)
                return

            # PropertiesChanged for device connect/disconnect
            if msg.member != "PropertiesChanged":
                return
            if not msg.path or not msg.path.startswith("/org/bluez/hci0/dev_"):
                return

            iface_name = msg.body[0]
            changed = msg.body[1]

            if iface_name != "org.bluez.Device1":
                return
            if "Connected" not in changed:
                return

            connected = changed["Connected"].value
            mac = msg.path.split("/")[-1].replace("dev_", "").replace("_", ":")

            if connected:
                new_devs = find_devices()
                for d in new_devs:
                    if d["mac"].upper() == mac.upper():
                        reps = read_all_reports(d["path"])
                        pct = reps.get("battery_fine") or reps.get("battery_pct") or 0
                        if mac not in prov.batteries:
                            prov.add_device(mac, pct)
                        print(f"[event] {mac} connected — battery {pct}%", file=sys.stderr)
                        break
            else:
                prov.remove_device(mac)
                print(f"[event] {mac} disconnected", file=sys.stderr)

        bus.add_message_handler(on_dbus_signal)

    # Graceful shutdown
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    for sig_num in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig_num, stop.set)

    # Start HID Input Report monitor for wake/connection events
    hidraw_monitors = []
    def on_input_event(event):
        if event.get("type") == "vendor_wake":
            flags = []
            if event["device_ready"]:
                flags.append("device_ready")
            if event["connection_request"]:
                flags.append("conn_request")
            if flags:
                print(f"[input] Report 0x13: {', '.join(flags)} (raw=0x{event['raw']:02X})", file=sys.stderr)
                # Log wake event to history
                append_history({
                    "t": datetime.now().isoformat(),
                    "event": "wake",
                    "flags": flags,
                    "raw": event["raw"],
                })

    for dev in find_devices():
        mon = HidrawMonitor(dev["path"])
        if mon.start(loop, on_input_event):
            hidraw_monitors.append(mon)
            print(f"[input] monitoring {dev['path']} for wake/connection events", file=sys.stderr)

    print(f"[daemon] polling every {interval}s, threshold {threshold}%", file=sys.stderr)

    try:
        while not stop.is_set():
            # Re-register provider after BlueZ restart
            if provider and bluez_reregister.is_set():
                bluez_reregister.clear()
                await asyncio.sleep(2)  # let BlueZ finish starting
                try:
                    provider = await _setup_provider(bus)
                except Exception as e:
                    print(f"[provider] re-registration failed: {e}", file=sys.stderr)

            for dev in find_devices():
                mac = dev["mac"]
                reps = read_all_reports(dev["path"])
                pct_fine = reps.get("battery_fine")
                pct = reps.get("battery_pct")
                volts = reps.get("voltage")
                adc = reps.get("adc_raw")

                level = pct_fine if pct_fine is not None else pct
                if level is None:
                    continue

                # Update Battery Provider
                if provider:
                    if mac in provider.batteries:
                        provider.update_device(mac, level)
                    else:
                        provider.add_device(mac, level)

                # History
                entry = {
                    "t": datetime.now().isoformat(),
                    "mac": mac,
                    "bat": pct,
                    "fine": pct_fine,
                    "volt": volts,
                    "adc": adc,
                }
                conn = get_conn_info(mac) if mac else None
                if conn:
                    entry["rssi"] = conn["rssi_dbm"]
                    entry["tx"] = conn["tx_power_dbm"]
                append_history(entry)

                # Low battery notification
                if level <= threshold:
                    if not NOTIFIED_FILE.exists():
                        urgency = "critical" if level <= 5 else "normal"
                        icon = "battery-caution" if level <= 5 else "battery-low"
                        v_str = f" ({volts:.2f}V)" if volts else ""
                        notify(
                            f"Batterie faible \u2014 {dev['name']}",
                            f"{level}%{v_str} restant",
                            urgency=urgency, icon=icon,
                        )
                        NOTIFIED_FILE.write_text(str(level))
                elif level > threshold and NOTIFIED_FILE.exists():
                    NOTIFIED_FILE.unlink(missing_ok=True)

            try:
                await asyncio.wait_for(stop.wait(), timeout=interval)
                break
            except asyncio.TimeoutError:
                pass
    finally:
        for mon in hidraw_monitors:
            mon.stop()
        if provider:
            await provider.unregister()
        if bus:
            bus.disconnect()
        print("[daemon] stopped", file=sys.stderr)


# ---------------------------------------------------------------------------
# Watch mode
# ---------------------------------------------------------------------------

async def watch_mode(watch_interval):
    if not HAS_DBUS_FAST:
        print("dbus-fast required for --watch (D-Bus properties)", file=sys.stderr)
        sys.exit(1)

    bus = await MessageBus(bus_type=BusType.SYSTEM).connect()
    try:
        while True:
            sys.stdout.write("\033[2J\033[H")
            sys.stdout.flush()
            devices = find_devices()
            if not devices:
                print("  Waiting for Apple Bluetooth keyboard...")
            for dev in devices:
                r = await collect_report(bus, dev)
                print_report(r)
            print(f"\n  Refresh: {watch_interval}s \u2014 Ctrl+C to quit")
            await asyncio.sleep(watch_interval)
    except (KeyboardInterrupt, asyncio.CancelledError):
        pass
    finally:
        bus.disconnect()



SPARK_CHARS = "\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588"


def print_graph(history_file=HISTORY_FILE):
    """Print voltage/battery history as terminal sparkline graph."""
    if not history_file.exists():
        print("No history yet.", file=sys.stderr)
        return
    try:
        lines = history_file.read_text().splitlines()
    except OSError:
        return

    entries = []
    for line in lines:
        try:
            e = json.loads(line)
            entries.append(e)
        except json.JSONDecodeError:
            pass

    if not entries:
        print("No data in history.", file=sys.stderr)
        return

    W = 70

    # Voltage sparkline
    volts = [e.get("volt") for e in entries if e.get("volt")]
    if volts:
        vmin, vmax = min(volts), max(volts)
        vrange = vmax - vmin if vmax > vmin else 0.1
        spark = ""
        # Sample to fit width
        step = max(1, len(volts) // W)
        sampled = volts[::step][-W:]
        for v in sampled:
            idx = min(7, int((v - vmin) / vrange * 7))
            spark += SPARK_CHARS[idx]
        print(f"  VOLTAGE ({vmin:.3f}V - {vmax:.3f}V)")
        print(f"  {spark}")
        print(f"  {'oldest':<{len(spark)//2}}{'latest':>{len(spark) - len(spark)//2}}")
        print()

    # Battery % sparkline
    bats = [e.get("fine") or e.get("bat") for e in entries if e.get("fine") or e.get("bat")]
    if bats:
        bmin, bmax = min(bats), max(bats)
        brange = bmax - bmin if bmax > bmin else 1
        spark = ""
        step = max(1, len(bats) // W)
        sampled = bats[::step][-W:]
        for b in sampled:
            idx = min(7, int((b - bmin) / brange * 7))
            spark += SPARK_CHARS[idx]
        print(f"  BATTERY ({bmin}% - {bmax}%)")
        print(f"  {spark}")
        print(f"  {'oldest':<{len(spark)//2}}{'latest':>{len(spark) - len(spark)//2}}")
        print()

    # RSSI sparkline
    rssis = [e.get("rssi") for e in entries if e.get("rssi") is not None]
    if rssis:
        rmin, rmax = min(rssis), max(rssis)
        rrange = rmax - rmin if rmax > rmin else 1
        spark = ""
        step = max(1, len(rssis) // W)
        sampled = rssis[::step][-W:]
        for r in sampled:
            idx = min(7, int((r - rmin) / rrange * 7))
            spark += SPARK_CHARS[idx]
        print(f"  RSSI ({rmin} dBm - {rmax} dBm)")
        print(f"  {spark}")
        print(f"  {'oldest':<{len(spark)//2}}{'latest':>{len(spark) - len(spark)//2}}")
        print()

    # Stats
    discharge = estimate_discharge(history_file)
    if discharge:
        print(f"  DISCHARGE RATE")
        print(f"  {'Rate':22s} {discharge['rate_mv_per_hour']:.2f} mV/h")
        print(f"  {'Window':22s} {discharge['window_hours']:.1f}h ({discharge['samples']} samples)")
        print(f"  {'Remaining':22s} {discharge['remaining_display']}")
        btype = detect_battery_type(discharge["end_voltage"])
        print(f"  {'Battery type':22s} {btype['detail']} ({btype['confidence']}% confidence)")
    print()
    print(f"  Total entries: {len(entries)}")



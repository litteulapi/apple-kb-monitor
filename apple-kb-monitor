# Battery type detection
# ---------------------------------------------------------------------------

def detect_battery_type(voltage):
    """Detect battery chemistry from voltage profile (2xAA in series).
    Nominal voltages per cell:
      Alkaline:  1.5V  → 2x = 3.0V fresh, ~2.4V nominal, 1.8V cutoff
      NiMH:      1.2V  → 2x = 2.4V fresh, ~2.4V nominal (flat), 2.0V cutoff
      Lithium:   1.5V  → 2x = 3.0V fresh, ~2.8V nominal (very flat), 1.8V cutoff
    """
    if voltage is None:
        return {"type": "unknown", "confidence": 0}
    if voltage >= 3.1:
        return {"type": "lithium_fresh", "confidence": 80,
                "detail": "Lithium (1.5V/cell) or fresh alkaline"}
    if voltage >= 2.85:
        return {"type": "alkaline_fresh", "confidence": 70,
                "detail": "Alkaline fresh or lithium nominal"}
    if voltage >= 2.5:
        # Ambiguous zone — alkaline declining or NiMH/lithium nominal
        return {"type": "alkaline_or_nimh", "confidence": 40,
                "detail": "Alkaline declining or NiMH/lithium nominal range"}
    if 2.3 <= voltage < 2.5:
        # NiMH flat discharge curve sits here
        return {"type": "nimh_likely", "confidence": 60,
                "detail": "NiMH likely (flat 1.2V/cell discharge curve)"}
    if 2.0 <= voltage < 2.3:
        return {"type": "depleted", "confidence": 80,
                "detail": "Any chemistry near end of life"}
    return {"type": "critical", "confidence": 90,
            "detail": "Below cutoff — replace immediately"}


# ---------------------------------------------------------------------------
# Discharge rate & remaining time estimation
# ---------------------------------------------------------------------------

def estimate_discharge(history_file=HISTORY_FILE, window_hours=24):
    """Estimate discharge rate and remaining time from history data."""
    if not history_file.exists():
        return None
    try:
        lines = history_file.read_text().splitlines()
    except OSError:
        return None

    # Parse entries with voltage data
    entries = []
    for line in lines:
        try:
            e = json.loads(line)
            v = e.get("volt")
            t = e.get("t")
            if v and t:
                ts = datetime.fromisoformat(t)
                entries.append((ts, v))
        except (json.JSONDecodeError, ValueError):
            pass

    if len(entries) < 2:
        return None

    # Filter to window
    now = datetime.now()
    cutoff = now.replace(hour=0, minute=0, second=0) if window_hours >= 24 else now
    recent = [(t, v) for t, v in entries if (now - t).total_seconds() < window_hours * 3600]
    if len(recent) < 2:
        recent = entries[-50:]  # fallback to last 50 entries
    if len(recent) < 2:
        return None

    first_t, first_v = recent[0]
    last_t, last_v = recent[-1]
    hours = (last_t - first_t).total_seconds() / 3600
    if hours < 0.01:
        return None

    rate_mvh = (first_v - last_v) * 1000 / hours  # mV/h (positive = discharging)
    result = {
        "rate_mv_per_hour": round(rate_mvh, 2),
        "window_hours": round(hours, 2),
        "samples": len(recent),
        "start_voltage": first_v,
        "end_voltage": last_v,
    }

    # Estimate remaining time to 2.0V cutoff (25% threshold)
    if rate_mvh > 0.1:
        remaining_mv = (last_v - 2.0) * 1000
        if remaining_mv > 0:
            hours_left = remaining_mv / rate_mvh
            result["remaining_hours"] = round(hours_left, 1)
            if hours_left < 24:
                result["remaining_display"] = f"{hours_left:.1f}h"
            else:
                result["remaining_display"] = f"{hours_left / 24:.1f} days"
        else:
            result["remaining_hours"] = 0
            result["remaining_display"] = "Replace now"
    else:
        result["remaining_display"] = "Stable (no measurable drain)"

    return result



def bar(pct, width=20):
    if pct is None:
        return ""
    filled = round(pct / 100 * width)
    return f"[{'#' * filled}{'.' * (width - filled)}]"


def voltage_health(v):
    """Interpret 2xAA battery voltage."""
    if v is None:
        return ""
    if v >= 2.8:
        return "Fresh"
    if v >= 2.4:
        return "Good"
    if v >= 2.1:
        return "Low"
    if v >= 1.8:
        return "Critical"
    return "Dead"



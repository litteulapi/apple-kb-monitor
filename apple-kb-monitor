# CLI
# ---------------------------------------------------------------------------

def main():
    p = argparse.ArgumentParser(
        description=f"Apple Keyboard Monitor v{__version__} \u2014 BCM2042/BCM20733 telemetry",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
examples:
  apple-kb-monitor --once          Quick battery + voltage
  apple-kb-monitor --status        Full decoded report
  apple-kb-monitor --dump          Raw register dump (RE)
  apple-kb-monitor --watch         Live dashboard
  apple-kb-monitor --json          JSON for scripting
  apple-kb-monitor --waybar        Waybar/polybar JSON
  apple-kb-monitor --history       Battery/voltage log
  apple-kb-monitor                 Daemon (battery provider + monitor)

project: https://github.com/litteulapi/apple-kb-monitor
license: GPL-2.0-or-later
""",
    )
    p.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--once", action="store_true", help="Quick battery + voltage, exit")
    mode.add_argument("--status", action="store_true", help="Full decoded device report")
    mode.add_argument("--dump", action="store_true", help="Raw Feature Report dump")
    mode.add_argument("--watch", action="store_true", help="Live dashboard")
    mode.add_argument("--json", action="store_true", help="JSON output")
    mode.add_argument("--waybar", action="store_true", help="Waybar/polybar JSON output")
    mode.add_argument("--history", action="store_true", help="Show battery/voltage log")
    mode.add_argument("--graph", action="store_true", help="Voltage/battery sparkline graphs")
    mode.add_argument("--export-csv", action="store_true", help="Export history as CSV")
    mode.add_argument("--metrics", action="store_true", help="Prometheus text format metrics")

    p.add_argument("--threshold", type=int, default=15, help="Low battery notification %% (default: 15)")
    p.add_argument("--interval", type=int, default=300, help="Daemon poll interval in seconds (default: 300)")
    p.add_argument("--watch-interval", type=int, default=5, help="Watch refresh in seconds (default: 5)")
    p.add_argument("--no-provider", action="store_true", help="Disable BlueZ Battery Provider registration")
    args = p.parse_args()

    # --- Sync modes (no D-Bus needed) ---

    if args.once:
        devices = find_devices()
        if not devices:
            print("No Apple Bluetooth keyboard found.", file=sys.stderr)
            sys.exit(1)
        for dev in devices:
            reps = read_all_reports(dev["path"])
            pct = reps.get("battery_pct")
            fine = reps.get("battery_fine")
            volts = reps.get("voltage")
            conn = get_conn_info(dev["mac"]) if dev["mac"] else None
            rssi_s = f"  RSSI:{conn['rssi_dbm']}dBm" if conn and conn.get("rssi_dbm") is not None else ""
            volt_s = f"  {volts:.3f}V" if volts else ""
            fine_s = f" (fine:{fine}%)" if fine is not None and fine != pct else ""
            print(f"{dev['model']:48s} {pct}%{fine_s}{volt_s}{rssi_s}")
        return

    if args.dump:
        devices = find_devices()
        if not devices:
            print("No Apple Bluetooth keyboard found.", file=sys.stderr)
            sys.exit(1)
        for dev in devices:
            print(f"\n  Device: {dev['name']} [{dev['mac']}] @ {dev['path']}")
            print_dump(dev["path"])
        return

    if args.history:
        print_history()
        return

    if args.waybar:
        waybar_output(find_devices())
        return

    if args.graph:
        print_graph()
        return

    if args.export_csv:
        export_csv()
        return

    if args.metrics:
        devices = find_devices()
        if not devices:
            print("# no device", file=sys.stderr)
            sys.exit(1)
        print_metrics(devices)
        return

    # --- Async modes (D-Bus) ---

    if args.status:
        if not HAS_DBUS_FAST:
            print("dbus-fast required for --status", file=sys.stderr)
            sys.exit(1)

        async def _status():
            bus = await MessageBus(bus_type=BusType.SYSTEM).connect()
            try:
                devices = find_devices()
                if not devices:
                    print("No Apple Bluetooth keyboard found.", file=sys.stderr)
                    sys.exit(1)
                for dev in devices:
                    print_report(await collect_report(bus, dev))
            finally:
                bus.disconnect()
        asyncio.run(_status())
        return

    if args.json:
        if not HAS_DBUS_FAST:
            print("dbus-fast required for --json", file=sys.stderr)
            sys.exit(1)

        async def _json():
            bus = await MessageBus(bus_type=BusType.SYSTEM).connect()
            try:
                devices = find_devices()
                if not devices:
                    json.dump({"error": "no device"}, sys.stdout, indent=2)
                    sys.exit(1)
                reports = []
                for dev in devices:
                    reports.append(await collect_report(bus, dev))
                json.dump(reports[0] if len(reports) == 1 else reports,
                          sys.stdout, indent=2, ensure_ascii=False)
                print()
            finally:
                bus.disconnect()
        asyncio.run(_json())
        return

    if args.watch:
        asyncio.run(watch_mode(args.watch_interval))
        return

    # --- Default: daemon mode ---
    asyncio.run(daemon_loop(args.threshold, args.interval, args.no_provider))


if __name__ == "__main__":
    main()

msgstr ""
"збережений ключ %1; копія ядра непридатна до читання (debugfs не змонтовано?)"

#: ui/DiagPage.qml:116
msgctxt "doctor finding"
msgid ""
"link quality: %1 disconnection in the last hour, %2 in 24 h, %3 in 7 days"
msgid_plural ""
"link quality: %1 disconnections in the last hour, %2 in 24 h, %3 in 7 days"
msgstr[0] ""
"якість зв'язку: %1 від'єднання за останню годину, %2 за 24 год, %3 за 7 днів"
msgstr[1] ""
"якість зв'язку: %1 від'єднання за останню годину, %2 за 24 год, %3 за 7 днів"
msgstr[2] ""
"якість зв'язку: %1 від'єднань за останню годину, %2 за 24 год, %3 за 7 днів"

#: ui/DiagPage.qml:117
msgctxt "doctor finding, appended"
msgid "; relative signal over 7 days: mean %2 dB, min %3 dB (%1 measurement)"
msgid_plural ""
"; relative signal over 7 days: mean %2 dB, min %3 dB (%1 measurements)"
msgstr[0] ""
"; відносний сигнал за 7 днів: середнє %2 дБ, мін. %3 дБ (%1 вимірювання)"
msgstr[1] ""
"; відносний сигнал за 7 днів: середнє %2 дБ, мін. %3 дБ (%1 вимірювання)"
msgstr[2] ""
"; відносний сигнал за 7 днів: середнє %2 дБ, мін. %3 дБ (%1 вимірювань)"

#: ui/DiagPage.qml:118
msgctxt "doctor finding, appended"
msgid " — UNSTABLE: %1 unexpected within the hour"
msgstr " — НЕСТАБІЛЬНО: неочікуваних за годину: %1"

#: ui/DiagPage.qml:119
msgctxt "doctor finding, %1 = device"
msgid "%1 readable"
msgstr "%1 придатний до читання"

#: ui/DiagPage.qml:120
msgctxt "doctor finding, %1 = device"
msgid "%1 not readable by this user"
msgstr "%1 недоступний для читання цьому користувачу"


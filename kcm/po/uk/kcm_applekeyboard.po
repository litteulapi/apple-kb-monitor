#: ui/DiagPage.qml:66
msgctxt "doctor verdict"
msgid "the pairing is refused or missing: run `akmctl repair`"
msgstr "пов'язування відхилено або відсутнє: виконайте `akmctl repair`"

#: ui/DiagPage.qml:67
msgctxt "doctor verdict"
msgid "no usable pairing: run `akmctl repair`"
msgstr "немає придатного пов'язування: виконайте `akmctl repair`"

#. i18n: %1 = the doctor topics to check, comma-separated
#: ui/DiagPage.qml:69
msgctxt "doctor verdict"
msgid "Link up; to check: %1 (akmctl doctor)"
msgstr "Зв'язок встановлено; перевірити: %1 (akmctl doctor)"

#: ui/DiagPage.qml:70
msgctxt "doctor verdict"
msgid "link up and configuration sound"
msgstr "зв'язок встановлено, налаштування в порядку"

#: ui/DiagPage.qml:71
msgctxt "doctor verdict"
msgid ""
"keyboard not connected: press a key and wait 10 s; the service pages it on "
"its own. Pair it again only if `akmctl doctor` reports auth-failed"
msgstr ""
"клавіатуру не під'єднано: натисніть клавішу і зачекайте 10 с; служба викличе "
"її сама. Повторюйте пов'язування, лише якщо `akmctl doctor` повідомляє auth-"
"failed"

#: ui/DiagPage.qml:78
msgctxt "doctor finding"
msgid "rssi-helper executable, capability cap_net_admin present"
msgstr "rssi-helper виконуваний, capability cap_net_admin наявна"

#: ui/DiagPage.qml:79
msgctxt "doctor finding"
msgid "the rssi-helper utility is not installed"
msgstr "допоміжну програму rssi-helper не встановлено"

#: ui/DiagPage.qml:80
msgctxt "doctor finding"
msgid "the rssi-helper utility failed (missing capability, Bluetooth refused)"
msgstr ""
"допоміжна програма rssi-helper завершилася з помилкою (немає capability, "
"відмова Bluetooth)"

#: ui/DiagPage.qml:81
msgctxt "doctor finding"
msgid "the rssi-helper utility does not answer in time"
msgstr "допоміжна програма rssi-helper не відповідає вчасно"

#: ui/DiagPage.qml:82
msgctxt "doctor finding"
msgid "the Bluetooth adapter gives no measure for this link"
msgstr "адаптер Bluetooth не надає вимірювань для цього зв'язку"

#: ui/DiagPage.qml:83
msgctxt "doctor finding"
msgid "the signal cannot be measured"
msgstr "сигнал неможливо виміряти"

#: ui/DiagPage.qml:84
msgctxt "doctor finding, %1 = settings"
msgid "ignored by bluetoothd: %1"
msgstr "ігнорується bluetoothd: %1"

#: ui/DiagPage.qml:85
msgctxt "doctor finding"
msgid "[Policy] Reconnect* in place"
msgstr "[Policy] Reconnect* на місці"

#: ui/DiagPage.qml:86
msgctxt "doctor finding"
msgid "FastConnectable = true"
msgstr "FastConnectable = true"

#: ui/DiagPage.qml:87
msgctxt "doctor finding"
msgid ""
"FastConnectable off: slower answer to the keyboard's page after a key press"
msgstr ""
"FastConnectable вимкнено: повільніша відповідь на виклик клавіатури після "
"натискання клавіші"

#: ui/DiagPage.qml:88
msgctxt "doctor finding, %1 = file, %2 = error"
msgid "%1: %2"
msgstr "%1: %2"

#: ui/DiagPage.qml:89
msgctxt "doctor finding"
msgid "NoPollBatteries = true (no 30 s HID polling)"
msgstr "NoPollBatteries = true (немає опитування HID кожні 30 с)"

#: ui/DiagPage.qml:90
msgctxt "doctor finding"
msgid ""
"UPower reads the keyboard battery every 30 s (2 GET_REPORT over the air): "
"the keyboard never sleeps"
msgstr ""
"UPower читає заряд клавіатури кожні 30 с (2 GET_REPORT по радіо): клавіатура "
"ніколи не засинає"

#: ui/DiagPage.qml:91
msgctxt "doctor finding"
msgid "adapter is not on USB (or not found)"
msgstr "адаптер не на USB (або не знайдено)"


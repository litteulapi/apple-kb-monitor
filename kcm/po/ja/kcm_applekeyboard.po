#: ui/DiagPage.qml:66
msgctxt "doctor verdict"
msgid "the pairing is refused or missing: run `akmctl repair`"
msgstr ""
"ペアリングが拒否されたか存在しません: `akmctl repair` を実行してください"

#: ui/DiagPage.qml:67
msgctxt "doctor verdict"
msgid "no usable pairing: run `akmctl repair`"
msgstr "使用できるペアリングがありません: `akmctl repair` を実行してください"

#. i18n: %1 = the doctor topics to check, comma-separated
#: ui/DiagPage.qml:69
msgctxt "doctor verdict"
msgid "Link up; to check: %1 (akmctl doctor)"
msgstr "接続確立。要確認: %1 (akmctl doctor)"

#: ui/DiagPage.qml:70
msgctxt "doctor verdict"
msgid "link up and configuration sound"
msgstr "接続は確立しており、設定も正常です"

#: ui/DiagPage.qml:71
msgctxt "doctor verdict"
msgid ""
"keyboard not connected: press a key and wait 10 s; the service pages it on "
"its own. Pair it again only if `akmctl doctor` reports auth-failed"
msgstr ""
"キーボードが接続されていません: キーを押して 10 秒待ってください。サービスが"
"自動的に呼び出します。`akmctl doctor` が auth-failed を報告した場合のみ再ペア"
"リングしてください"

#: ui/DiagPage.qml:78
msgctxt "doctor finding"
msgid "rssi-helper executable, capability cap_net_admin present"
msgstr "rssi-helper は実行可能、ケーパビリティ cap_net_admin あり"

#: ui/DiagPage.qml:79
msgctxt "doctor finding"
msgid "the rssi-helper utility is not installed"
msgstr "rssi-helper ユーティリティがインストールされていません"

#: ui/DiagPage.qml:80
msgctxt "doctor finding"
msgid "the rssi-helper utility failed (missing capability, Bluetooth refused)"
msgstr ""
"rssi-helper ユーティリティが失敗しました (ケーパビリティ不足、Bluetooth が拒"
"否)"

#: ui/DiagPage.qml:81
msgctxt "doctor finding"
msgid "the rssi-helper utility does not answer in time"
msgstr "rssi-helper ユーティリティが時間内に応答しません"

#: ui/DiagPage.qml:82
msgctxt "doctor finding"
msgid "the Bluetooth adapter gives no measure for this link"
msgstr "Bluetooth アダプタがこの接続の測定値を返しません"

#: ui/DiagPage.qml:83
msgctxt "doctor finding"
msgid "the signal cannot be measured"
msgstr "信号を測定できません"

#: ui/DiagPage.qml:84
msgctxt "doctor finding, %1 = settings"
msgid "ignored by bluetoothd: %1"
msgstr "bluetoothd により無視: %1"

#: ui/DiagPage.qml:85
msgctxt "doctor finding"
msgid "[Policy] Reconnect* in place"
msgstr "[Policy] Reconnect* 設定済み"

#: ui/DiagPage.qml:86
msgctxt "doctor finding"
msgid "FastConnectable = true"
msgstr "FastConnectable = true"

#: ui/DiagPage.qml:87
msgctxt "doctor finding"
msgid ""
"FastConnectable off: slower answer to the keyboard's page after a key press"
msgstr ""
"FastConnectable オフ: キー入力後のキーボードからの呼び出しへの応答が遅くなり"
"ます"

#: ui/DiagPage.qml:88
msgctxt "doctor finding, %1 = file, %2 = error"
msgid "%1: %2"
msgstr "%1: %2"

#: ui/DiagPage.qml:89
msgctxt "doctor finding"
msgid "NoPollBatteries = true (no 30 s HID polling)"
msgstr "NoPollBatteries = true (30 秒ごとの HID ポーリングなし)"

#: ui/DiagPage.qml:90
msgctxt "doctor finding"
msgid ""
"UPower reads the keyboard battery every 30 s (2 GET_REPORT over the air): "
"the keyboard never sleeps"
msgstr ""
"UPower が 30 秒ごとにキーボードの電池を読み取っています (無線で GET_REPORT 2 "
"回): キーボードがスリープしません"

#: ui/DiagPage.qml:91
msgctxt "doctor finding"
msgid "adapter is not on USB (or not found)"
msgstr "アダプタが USB 接続ではありません (または見つかりません)"

#: ui/DiagPage.qml:92
msgctxt "doctor finding, %1 = USB id"
msgid "%1 autosuspend off (power/control=on)"
msgstr "%1 USB 自動サスペンド無効 (power/control=on)"

#: ui/DiagPage.qml:94
msgctxt "doctor finding"
msgid ""
"%1 USB autosuspend active (control=%2, delay %3 ms, now %4, %5 s suspended "
"since boot)"
msgstr ""
"%1 USB 自動サスペンド有効 (control=%2、遅延 %3 ms、現在 %4、起動以降 %5 秒サ"
"スペンド)"

#: ui/DiagPage.qml:95
msgctxt "doctor finding, appended"
msgid "; rule installed but not applied yet"
msgstr "; ルールはインストール済みだがまだ適用されていません"

#: ui/DiagPage.qml:96
msgctxt "doctor finding"
msgid "btusb enable_autosuspend = %1"
msgstr "btusb enable_autosuspend = %1"

#: ui/DiagPage.qml:97
msgctxt "doctor finding"
msgid "Bluetooth adapter powered"
msgstr "Bluetooth アダプタ電源オン"

#: ui/DiagPage.qml:98
msgctxt "doctor finding"
msgid "Bluetooth adapter off"
msgstr "Bluetooth アダプタ電源オフ"

#: ui/DiagPage.qml:99
msgctxt "doctor finding"
msgid "BlueZ unreachable (bluetooth.service stopped?)"
msgstr "BlueZ に到達できません (bluetooth.service が停止?)"

#: ui/DiagPage.qml:100
msgctxt "doctor finding"
msgid "no paired Apple keyboard known to BlueZ"
msgstr "BlueZ が認識しているペアリング済み Apple キーボードはありません"

#: ui/DiagPage.qml:101
msgctxt "doctor finding, %1 = address"
msgid "%1 is not paired"
msgstr "%1 はペアリングされていません"

#: ui/DiagPage.qml:103
msgctxt "doctor finding, %1 = address, %2 = name"
msgid "%1 “%2” paired"
msgstr "%1「%2」ペアリング済み"

#: ui/DiagPage.qml:104
msgctxt "doctor finding, appended"
msgid ", bonded"
msgstr "、ボンディング済み"

#: ui/DiagPage.qml:105
msgctxt "doctor finding, appended"
msgid ", legacy PIN pairing"
msgstr "、旧式の PIN ペアリング"

#: ui/DiagPage.qml:106
msgctxt "doctor finding"
msgid "not trusted: BlueZ may refuse the keyboard's own reconnection"
msgstr ""
"信頼されていません: BlueZ がキーボード側からの再接続を拒否する可能性がありま"
"す"

#: ui/DiagPage.qml:107
msgctxt "doctor finding"
msgid "blocked in BlueZ"
msgstr "BlueZ でブロック中"

#: ui/DiagPage.qml:108
msgctxt "doctor finding"
msgid "connected"
msgstr "接続済み"

#: ui/DiagPage.qml:109
msgctxt "doctor finding"
msgid "not connected (asleep? press a key)"
msgstr "未接続 (スリープ中? キーを押してください)"

#: ui/DiagPage.qml:110
msgctxt "doctor finding"
msgid "link key not checked (needs root: sudo akmctl doctor)"
msgstr "リンクキー未確認 (root が必要: sudo akmctl doctor)"

#: ui/DiagPage.qml:111
msgctxt "doctor finding"
msgid "no [LinkKey] stored for the keyboard"
msgstr "キーボードの [LinkKey] が保存されていません"

#: ui/DiagPage.qml:112
msgctxt "doctor finding"
msgid "stored key == kernel key (fingerprint %1)"
msgstr "保存キー == カーネルのキー (フィンガープリント %1)"

#: ui/DiagPage.qml:113
msgctxt "doctor finding"
msgid "stored key %1 != kernel key %2: will change at next restart"
msgstr "保存キー %1 != カーネルのキー %2: 次回の再起動で変わります"

#: ui/DiagPage.qml:114
msgctxt "doctor finding"
msgid "stored key %1; kernel copy not readable (debugfs not mounted?)"
msgstr "保存キー %1; カーネル側のコピーを読み取れません (debugfs 未マウント?)"

#: ui/DiagPage.qml:116
msgctxt "doctor finding"
msgid ""
"link quality: %1 disconnection in the last hour, %2 in 24 h, %3 in 7 days"
msgid_plural ""
"link quality: %1 disconnections in the last hour, %2 in 24 h, %3 in 7 days"
msgstr[0] "接続品質: 直近 1 時間に %1 回、24 時間に %2 回、7 日間に %3 回切断"

#: ui/DiagPage.qml:117
msgctxt "doctor finding, appended"
msgid "; relative signal over 7 days: mean %2 dB, min %3 dB (%1 measurement)"
msgid_plural ""
"; relative signal over 7 days: mean %2 dB, min %3 dB (%1 measurements)"
msgstr[0] "。7 日間の相対信号: 平均 %2 dB、最小 %3 dB (測定回数: %1)"

#: ui/DiagPage.qml:118
msgctxt "doctor finding, appended"
msgid " — UNSTABLE: %1 unexpected within the hour"
msgstr " — 不安定: 1 時間以内の予期しない切断 %1 回"

#: ui/DiagPage.qml:119
msgctxt "doctor finding, %1 = device"
msgid "%1 readable"
msgstr "%1 読み取り可能"

#: ui/DiagPage.qml:120
msgctxt "doctor finding, %1 = device"
msgid "%1 not readable by this user"
msgstr "%1 はこのユーザーから読み取れません"

#: ui/DiagPage.qml:121
msgctxt "doctor finding"
msgid "connected but no hidraw node (uhid not created yet?)"
msgstr "接続済みだが hidraw ノードなし (uhid がまだ作成されていない?)"

#: ui/DiagPage.qml:122
msgctxt "doctor finding"
msgid "no bluetoothd error in the last 6 hours of this boot"
msgstr "今回の起動の直近 6 時間に bluetoothd のエラーなし"

#: ui/DiagPage.qml:123
msgctxt "doctor finding"
msgid ""
"bluetoothd journal not readable (add yourself to group systemd-journal, or "
"use sudo)"
msgstr ""
"bluetoothd のジャーナルを読み取れません (systemd-journal グループに参加する"
"か sudo を使用してください)"

#: ui/DiagPage.qml:124
msgctxt "doctor finding, %1 = count, %2 = time"
msgid "%1 page timeout (keyboard asleep or not listening), last %2"
msgid_plural "%1 page timeouts (keyboard asleep or not listening), last %2"
msgstr[0] ""
"ページタイムアウト %1 回 (キーボードがスリープ中か応答待機していない)、最終 "
"%2"

#: ui/DiagPage.qml:125
msgctxt "doctor finding, %1 = count, %2 = time"
msgid "%1 HIDP GET_REPORT timeout, last %2"
msgid_plural "%1 HIDP GET_REPORT timeouts, last %2"
msgstr[0] "HIDP GET_REPORT タイムアウト %1 回、最終 %2"

#: ui/DiagPage.qml:126
msgctxt "doctor finding, %1 = count, %2 = time"
msgid "%1 authentication / key error, last %2"
msgid_plural "%1 authentication / key errors, last %2"
msgstr[0] "認証 / キーのエラー %1 回、最終 %2"

#: ui/DiagPage.qml:127
msgctxt "doctor finding, %1 = count, %2 = time"
msgid "%1 connection reset/refused by the keyboard, last %2"
msgid_plural "%1 connections reset/refused by the keyboard, last %2"
msgstr[0] "キーボードによる接続のリセット/拒否 %1 回、最終 %2"

#: ui/DiagPage.qml:128

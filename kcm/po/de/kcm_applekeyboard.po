msgstr "Weitere Benachrichtigungen"

#: ui/AlertsPage.qml:441 ui/StatePage.qml:152
msgid "Connection:"
msgstr "Verbindung:"

#: ui/AlertsPage.qml:442
msgid "Notify on disconnection and reconnection"
msgstr "Bei Trennung und Neuverbindung benachrichtigen"

#: ui/AlertsPage.qml:448
msgid "New batteries:"
msgstr "Neue Batterien:"

#: ui/AlertsPage.qml:449
msgid "Notify when new batteries are detected"
msgstr "Benachrichtigen, wenn neue Batterien erkannt werden"

#: ui/AlertsPage.qml:455
msgctxt "@title:group"
msgid "Shutdown"
msgstr "Herunterfahren"

#: ui/AlertsPage.qml:460
msgid "WillShutdown:"
msgstr "WillShutdown:"

#: ui/AlertsPage.qml:461
msgid "Tell the keyboard when the computer shuts down or restarts"
msgstr ""
"Der Tastatur mitteilen, wenn der Computer herunterfährt oder neu startet"

#: ui/AlertsPage.qml:470
msgid ""
"What macOS sends at every shutdown (one message, nothing else is written). "
"Off = the keyboard is left untouched."
msgstr ""
"Was macOS bei jedem Herunterfahren sendet (eine Nachricht, sonst wird nichts "
"geschrieben). Aus = die Tastatur bleibt unberührt."


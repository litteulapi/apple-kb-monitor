msgstr "unbekannt"

#: ui/AlertsPage.qml:415
msgid "Battery type"
msgstr "Batterietyp"

#: ui/AlertsPage.qml:424
msgid ""
"Used for the estimated charge and its range; the keyboard's own indication "
"does not depend on it."
msgstr ""
"Wird für die geschätzte Ladung und ihren Bereich verwendet; die eigene "
"Anzeige der Tastatur hängt nicht davon ab."

#: ui/AlertsPage.qml:429
msgid "Display:"
msgstr "Anzeige:"

#: ui/AlertsPage.qml:430
msgid "Also show the percentage as macOS shows it"
msgstr "Prozentwert auch so anzeigen, wie macOS ihn anzeigt"

#: ui/AlertsPage.qml:436
msgctxt "@title:group"

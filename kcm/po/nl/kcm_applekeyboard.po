msgid "Link up; to check: %1 (akmctl doctor)"
msgstr "Verbinding actief; te controleren: %1 (akmctl doctor)"

#: ui/DiagPage.qml:70
msgctxt "doctor verdict"
msgid "link up and configuration sound"
msgstr "verbinding actief en configuratie in orde"

#: ui/DiagPage.qml:71
msgctxt "doctor verdict"
msgid ""
"keyboard not connected: press a key and wait 10 s; the service pages it on "
"its own. Pair it again only if `akmctl doctor` reports auth-failed"
msgstr ""
"toetsenbord niet verbonden: druk op een toets en wacht 10 s; de dienst roept "
"het zelf op. Koppel het alleen opnieuw als `akmctl doctor` auth-failed meldt"

#: ui/DiagPage.qml:78
msgctxt "doctor finding"
msgid "rssi-helper executable, capability cap_net_admin present"
msgstr "rssi-helper uitvoerbaar, capability cap_net_admin aanwezig"

#: ui/DiagPage.qml:79
msgctxt "doctor finding"
msgid "the rssi-helper utility is not installed"
msgstr "het hulpprogramma rssi-helper is niet geïnstalleerd"


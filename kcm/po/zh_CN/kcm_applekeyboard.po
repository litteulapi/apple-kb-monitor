msgid_plural ""
"%1 BlueZ storage write failures (a new link key may be lost at reboot), last "
"%2"
msgstr[0] ""
"%1 次 BlueZ 存储写入失败（新的链接密钥可能在重启时丢失），最近一次 %2"

#: ui/DiagPage.qml:130
msgctxt "doctor finding"
msgid "apple-kb-monitord link keeper not reachable (no automatic reconnection)"
msgstr "无法访问 apple-kb-monitord 的连接守护（不会自动重新连接）"

#: ui/DiagPage.qml:131
msgctxt "doctor finding, %1 = state"
msgid "link health: %1"
msgstr "连接状态：%1"

#: ui/DiagPage.qml:132
msgctxt "doctor finding"
msgid "keeper running, keyboard not tracked"
msgstr "守护正在运行，未跟踪键盘"

#: ui/DiagPage.qml:133
msgctxt "doctor finding, %1 = program, %2 = pid, %3 = path"
msgid ""
"%1 (pid %2) still runs the replaced binary %3 (deleted): the old version"
msgstr "%1（pid %2）仍在运行已被替换的二进制文件 %3（已删除）：旧版本"

#: ui/DiagPage.qml:134
msgctxt "doctor finding, %1 = pid"
msgid ""

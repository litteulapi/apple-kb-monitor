#: ui/DiagPage.qml:131
msgctxt "doctor finding, %1 = state"
msgid "link health: %1"
msgstr "tilkoblingens tilstand: %1"

#: ui/DiagPage.qml:132
msgctxt "doctor finding"
msgid "keeper running, keyboard not tracked"
msgstr "vakten kjører, tastaturet følges ikke"

#: ui/DiagPage.qml:133
msgctxt "doctor finding, %1 = program, %2 = pid, %3 = path"
msgid ""
"%1 (pid %2) still runs the replaced binary %3 (deleted): the old version"
msgstr ""
"%1 (pid %2) kjører fortsatt den erstattede binærfilen %3 (slettet): den "
"gamle versjonen"

#: ui/DiagPage.qml:134

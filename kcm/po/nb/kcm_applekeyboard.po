#: ui/DiagPage.qml:66
msgctxt "doctor verdict"
msgid "the pairing is refused or missing: run `akmctl repair`"
msgstr "paringen avvises eller mangler: kjør `akmctl repair`"

#: ui/DiagPage.qml:67
msgctxt "doctor verdict"
msgid "no usable pairing: run `akmctl repair`"
msgstr "ingen brukbar paring: kjør `akmctl repair`"

#. i18n: %1 = the doctor topics to check, comma-separated
#: ui/DiagPage.qml:69
msgctxt "doctor verdict"
msgid "Link up; to check: %1 (akmctl doctor)"
msgstr "Forbindelsen oppe; å sjekke: %1 (akmctl doctor)"

#: ui/DiagPage.qml:70
msgctxt "doctor verdict"
msgid "link up and configuration sound"
msgstr "tilkoblingen er oppe og konfigurasjonen er i orden"

#: ui/DiagPage.qml:71
msgctxt "doctor verdict"
msgid ""
"keyboard not connected: press a key and wait 10 s; the service pages it on "
"its own. Pair it again only if `akmctl doctor` reports auth-failed"
msgstr ""
"tastaturet er ikke tilkoblet: trykk på en tast og vent 10 s; tjenesten "
"kaller det selv. Par på nytt bare hvis `akmctl doctor` melder auth-failed"

#: ui/DiagPage.qml:78
msgctxt "doctor finding"
msgid "rssi-helper executable, capability cap_net_admin present"
msgstr "rssi-helper kjørbar, capability cap_net_admin finnes"

#: ui/DiagPage.qml:79
msgctxt "doctor finding"
msgid "the rssi-helper utility is not installed"
msgstr "verktøyet rssi-helper er ikke installert"

#: ui/DiagPage.qml:80

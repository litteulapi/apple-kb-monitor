msgstr "alkalické"

#: ui/AlertsPage.qml:414 ui/StatePage.qml:57
msgctxt "battery chemistry"
msgid "NiMH (rechargeable)"
msgstr "NiMH (nabíjecí)"

#: ui/AlertsPage.qml:414 ui/StatePage.qml:58
msgctxt "battery chemistry"
msgid "lithium"
msgstr "lithiové"

#: ui/AlertsPage.qml:414 ui/StatePage.qml:59
msgctxt "battery chemistry"
msgid "unknown"
msgstr "neznámé"

#: ui/AlertsPage.qml:415
msgid "Battery type"
msgstr "Typ baterií"

#: ui/AlertsPage.qml:424
msgid ""
"Used for the estimated charge and its range; the keyboard's own indication "
"does not depend on it."
msgstr ""
"Slouží k odhadu nabití a jeho rozsahu; vlastní údaj klávesnice na tom "
"nezávisí."

#: ui/AlertsPage.qml:429
msgid "Display:"
msgstr "Zobrazení:"

#: ui/AlertsPage.qml:430
msgid "Also show the percentage as macOS shows it"
msgstr "Zobrazit také procento tak, jak jej ukazuje macOS"

#: ui/AlertsPage.qml:436
msgctxt "@title:group"
msgid "Other notifications"
msgstr "Další oznámení"

#: ui/AlertsPage.qml:441 ui/StatePage.qml:152
msgid "Connection:"
msgstr "Spojení:"

#: ui/AlertsPage.qml:442
msgid "Notify on disconnection and reconnection"
msgstr "Upozornit při odpojení a opětovném připojení"

#: ui/AlertsPage.qml:448
msgid "New batteries:"
msgstr "Nové baterie:"

#: ui/AlertsPage.qml:449
msgid "Notify when new batteries are detected"
msgstr "Upozornit při zjištění nových baterií"

#: ui/AlertsPage.qml:455
msgctxt "@title:group"
msgid "Shutdown"
msgstr "Vypnutí"

#: ui/AlertsPage.qml:460
msgid "WillShutdown:"
msgstr "WillShutdown:"

#: ui/AlertsPage.qml:461
msgid "Tell the keyboard when the computer shuts down or restarts"
msgstr "Oznámit klávesnici vypnutí nebo restart počítače"

#: ui/AlertsPage.qml:470
msgid ""
"What macOS sends at every shutdown (one message, nothing else is written). "
"Off = the keyboard is left untouched."
msgstr ""
"Co macOS posílá při každém vypnutí (jedna zpráva, nic jiného se nezapisuje). "
"Vypnuto = klávesnice zůstane nedotčena."


msgctxt "@action:button"
msgid "Write"
msgstr "Scrivi"

#: ui/NamePage.qml:97
msgid "Write “%1” into the keyboard's memory?"
msgstr "Scrivere «%1» nella memoria della tastiera?"

#: ui/NamePage.qml:114
msgctxt "@title:group"
msgid "Name on this computer"
msgstr "Nome su questo computer"

#: ui/NamePage.qml:118
msgid "Shown as:"
msgstr "Mostrato come:"

#: ui/NamePage.qml:125
msgid "Keyboard's own name:"
msgstr "Nome proprio della tastiera:"


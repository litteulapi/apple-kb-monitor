msgstr ", устаревшее сопряжение по PIN"

#: ui/DiagPage.qml:106
msgctxt "doctor finding"
msgid "not trusted: BlueZ may refuse the keyboard's own reconnection"
msgstr ""
"не доверенная: BlueZ может отклонить переподключение со стороны клавиатуры"

#: ui/DiagPage.qml:107
msgctxt "doctor finding"
msgid "blocked in BlueZ"
msgstr "заблокирована в BlueZ"

#: ui/DiagPage.qml:108
msgctxt "doctor finding"
msgid "connected"
msgstr "подключена"

#: ui/DiagPage.qml:109
msgctxt "doctor finding"
msgid "not connected (asleep? press a key)"
msgstr "не подключена (спит? нажмите клавишу)"

#: ui/DiagPage.qml:110
msgctxt "doctor finding"
msgid "link key not checked (needs root: sudo akmctl doctor)"
msgstr "ключ связи не проверен (нужен root: sudo akmctl doctor)"

#: ui/DiagPage.qml:111
msgctxt "doctor finding"
msgid "no [LinkKey] stored for the keyboard"
msgstr "для клавиатуры не сохранён [LinkKey]"

#: ui/DiagPage.qml:112
msgctxt "doctor finding"
msgid "stored key == kernel key (fingerprint %1)"
msgstr "сохранённый ключ == ключ ядра (отпечаток %1)"

#: ui/DiagPage.qml:113
msgctxt "doctor finding"
msgid "stored key %1 != kernel key %2: will change at next restart"
msgstr ""
"сохранённый ключ %1 != ключ ядра %2: изменится при следующей перезагрузке"

#: ui/DiagPage.qml:114
msgctxt "doctor finding"
msgid "stored key %1; kernel copy not readable (debugfs not mounted?)"
msgstr "сохранённый ключ %1; копия ядра нечитаема (debugfs не смонтирована?)"

#: ui/DiagPage.qml:116
msgctxt "doctor finding"
msgid ""
"link quality: %1 disconnection in the last hour, %2 in 24 h, %3 in 7 days"
msgid_plural ""
"link quality: %1 disconnections in the last hour, %2 in 24 h, %3 in 7 days"
msgstr[0] ""
"качество связи: %1 отключение за последний час, %2 за 24 ч, %3 за 7 дней"
msgstr[1] ""
"качество связи: %1 отключения за последний час, %2 за 24 ч, %3 за 7 дней"
msgstr[2] ""
"качество связи: %1 отключений за последний час, %2 за 24 ч, %3 за 7 дней"

#: ui/DiagPage.qml:117
msgctxt "doctor finding, appended"
msgid "; relative signal over 7 days: mean %2 dB, min %3 dB (%1 measurement)"
msgid_plural ""
"; relative signal over 7 days: mean %2 dB, min %3 dB (%1 measurements)"
msgstr[0] ""
"; относительный сигнал за 7 дней: среднее %2 дБ, мин. %3 дБ (%1 измерение)"
msgstr[1] ""
"; относительный сигнал за 7 дней: среднее %2 дБ, мин. %3 дБ (%1 измерения)"
msgstr[2] ""
"; относительный сигнал за 7 дней: среднее %2 дБ, мин. %3 дБ (%1 измерений)"

#: ui/DiagPage.qml:118
msgctxt "doctor finding, appended"
msgid " — UNSTABLE: %1 unexpected within the hour"
msgstr " — НЕСТАБИЛЬНО: неожиданных за час: %1"

#: ui/DiagPage.qml:119
msgctxt "doctor finding, %1 = device"
msgid "%1 readable"
msgstr "%1 читаем"

#: ui/DiagPage.qml:120
msgctxt "doctor finding, %1 = device"
msgid "%1 not readable by this user"
msgstr "%1 нечитаем для этого пользователя"

#: ui/DiagPage.qml:121
msgctxt "doctor finding"
msgid "connected but no hidraw node (uhid not created yet?)"
msgstr "подключена, но нет узла hidraw (uhid ещё не создан?)"

#: ui/DiagPage.qml:122
msgctxt "doctor finding"
msgid "no bluetoothd error in the last 6 hours of this boot"
msgstr "нет ошибок bluetoothd за последние 6 часов с момента загрузки"

#: ui/DiagPage.qml:123
msgctxt "doctor finding"
msgid ""
"bluetoothd journal not readable (add yourself to group systemd-journal, or "
"use sudo)"
msgstr ""
"журнал bluetoothd нечитаем (добавьте себя в группу systemd-journal или "
"используйте sudo)"

#: ui/DiagPage.qml:124
msgctxt "doctor finding, %1 = count, %2 = time"
msgid "%1 page timeout (keyboard asleep or not listening), last %2"
msgid_plural "%1 page timeouts (keyboard asleep or not listening), last %2"
msgstr[0] ""

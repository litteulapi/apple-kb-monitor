#: ui/DiagPage.qml:66
msgctxt "doctor verdict"
msgid "the pairing is refused or missing: run `akmctl repair`"
msgstr "сопряжение отклонено или отсутствует: выполните `akmctl repair`"

#: ui/DiagPage.qml:67
msgctxt "doctor verdict"
msgid "no usable pairing: run `akmctl repair`"
msgstr "нет пригодного сопряжения: выполните `akmctl repair`"

#. i18n: %1 = the doctor topics to check, comma-separated
#: ui/DiagPage.qml:69
msgctxt "doctor verdict"
msgid "Link up; to check: %1 (akmctl doctor)"
msgstr "Связь установлена; проверить: %1 (akmctl doctor)"

#: ui/DiagPage.qml:70
msgctxt "doctor verdict"
msgid "link up and configuration sound"
msgstr "связь установлена, конфигурация в порядке"

#: ui/DiagPage.qml:71
msgctxt "doctor verdict"
msgid ""
"keyboard not connected: press a key and wait 10 s; the service pages it on "
"its own. Pair it again only if `akmctl doctor` reports auth-failed"
msgstr ""
"клавиатура не подключена: нажмите клавишу и подождите 10 с; служба вызовет "
"её сама. Повторяйте сопряжение, только если `akmctl doctor` сообщает auth-"
"failed"

#: ui/DiagPage.qml:78
msgctxt "doctor finding"
msgid "rssi-helper executable, capability cap_net_admin present"
msgstr "rssi-helper исполняемый, capability cap_net_admin присутствует"

#: ui/DiagPage.qml:79
msgctxt "doctor finding"
msgid "the rssi-helper utility is not installed"
msgstr "утилита rssi-helper не установлена"

#: ui/DiagPage.qml:80
msgctxt "doctor finding"
msgid "the rssi-helper utility failed (missing capability, Bluetooth refused)"
msgstr ""
"утилита rssi-helper завершилась с ошибкой (нет capability, отказ Bluetooth)"

#: ui/DiagPage.qml:81
msgctxt "doctor finding"
msgid "the rssi-helper utility does not answer in time"
msgstr "утилита rssi-helper не отвечает вовремя"

#: ui/DiagPage.qml:82
msgctxt "doctor finding"
msgid "the Bluetooth adapter gives no measure for this link"
msgstr "адаптер Bluetooth не даёт измерений для этой связи"

#: ui/DiagPage.qml:83
msgctxt "doctor finding"
msgid "the signal cannot be measured"
msgstr "сигнал невозможно измерить"

#: ui/DiagPage.qml:84
msgctxt "doctor finding, %1 = settings"
msgid "ignored by bluetoothd: %1"
msgstr "игнорируется bluetoothd: %1"

#: ui/DiagPage.qml:85
msgctxt "doctor finding"
msgid "[Policy] Reconnect* in place"
msgstr "[Policy] Reconnect* на месте"

#: ui/DiagPage.qml:86
msgctxt "doctor finding"
msgid "FastConnectable = true"
msgstr "FastConnectable = true"

#: ui/DiagPage.qml:87
msgctxt "doctor finding"
msgid ""
"FastConnectable off: slower answer to the keyboard's page after a key press"
msgstr ""
"FastConnectable выключен: более медленный ответ на вызов клавиатуры после "
"нажатия клавиши"

#: ui/DiagPage.qml:88
msgctxt "doctor finding, %1 = file, %2 = error"
msgid "%1: %2"
msgstr "%1: %2"

#: ui/DiagPage.qml:89
msgctxt "doctor finding"
msgid "NoPollBatteries = true (no 30 s HID polling)"
msgstr "NoPollBatteries = true (нет опроса HID каждые 30 с)"

#: ui/DiagPage.qml:90
msgctxt "doctor finding"
msgid ""
"UPower reads the keyboard battery every 30 s (2 GET_REPORT over the air): "
"the keyboard never sleeps"
msgstr ""
"UPower читает заряд клавиатуры каждые 30 с (2 GET_REPORT по радио): "
"клавиатура никогда не засыпает"

#: ui/DiagPage.qml:91
msgctxt "doctor finding"
msgid "adapter is not on USB (or not found)"
msgstr "адаптер не на USB (или не найден)"

#: ui/DiagPage.qml:92
msgctxt "doctor finding, %1 = USB id"
msgid "%1 autosuspend off (power/control=on)"
msgstr "%1 автоприостановка USB выключена (power/control=on)"

#: ui/DiagPage.qml:94
msgctxt "doctor finding"
msgid ""
"%1 USB autosuspend active (control=%2, delay %3 ms, now %4, %5 s suspended "

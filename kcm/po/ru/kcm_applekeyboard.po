msgid "; rule installed but not applied yet"
msgstr "; правило установлено, но ещё не применено"

#: ui/DiagPage.qml:96
msgctxt "doctor finding"
msgid "btusb enable_autosuspend = %1"
msgstr "btusb enable_autosuspend = %1"

#: ui/DiagPage.qml:97
msgctxt "doctor finding"
msgid "Bluetooth adapter powered"
msgstr "адаптер Bluetooth включён"

#: ui/DiagPage.qml:98
msgctxt "doctor finding"
msgid "Bluetooth adapter off"
msgstr "адаптер Bluetooth выключен"

#: ui/DiagPage.qml:99
msgctxt "doctor finding"
msgid "BlueZ unreachable (bluetooth.service stopped?)"
msgstr "BlueZ недоступен (bluetooth.service остановлена?)"


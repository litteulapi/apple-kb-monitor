msgstr " — EPÄVAKAA: odottamattomia tunnin sisällä: %1"

#: ui/DiagPage.qml:119
msgctxt "doctor finding, %1 = device"
msgid "%1 readable"
msgstr "%1 luettavissa"

#: ui/DiagPage.qml:120
msgctxt "doctor finding, %1 = device"
msgid "%1 not readable by this user"
msgstr "%1 ei luettavissa tälle käyttäjälle"

#: ui/DiagPage.qml:121
msgctxt "doctor finding"
msgid "connected but no hidraw node (uhid not created yet?)"
msgstr "yhdistetty, mutta ei hidraw-solmua (uhid ei vielä luotu?)"

#: ui/DiagPage.qml:122
msgctxt "doctor finding"
msgid "no bluetoothd error in the last 6 hours of this boot"
msgstr "ei bluetoothd-virheitä tämän käynnistyksen viimeisten 6 tunnin aikana"

#: ui/DiagPage.qml:123
msgctxt "doctor finding"
msgid ""
"bluetoothd journal not readable (add yourself to group systemd-journal, or "
"use sudo)"
msgstr ""
"bluetoothd-journalia ei voi lukea (liity ryhmään systemd-journal tai käytä "
"sudoa)"

#: ui/DiagPage.qml:124
msgctxt "doctor finding, %1 = count, %2 = time"
msgid "%1 page timeout (keyboard asleep or not listening), last %2"
msgid_plural "%1 page timeouts (keyboard asleep or not listening), last %2"
msgstr[0] ""
"%1 page-aikakatkaisu (näppäimistö nukkuu tai ei kuuntele), viimeisin %2"
msgstr[1] ""
"%1 page-aikakatkaisua (näppäimistö nukkuu tai ei kuuntele), viimeisin %2"

#: ui/DiagPage.qml:125
msgctxt "doctor finding, %1 = count, %2 = time"
msgid "%1 HIDP GET_REPORT timeout, last %2"
msgid_plural "%1 HIDP GET_REPORT timeouts, last %2"
msgstr[0] "%1 HIDP GET_REPORT -aikakatkaisu, viimeisin %2"
msgstr[1] "%1 HIDP GET_REPORT -aikakatkaisua, viimeisin %2"

#: ui/DiagPage.qml:126
msgctxt "doctor finding, %1 = count, %2 = time"
msgid "%1 authentication / key error, last %2"
msgid_plural "%1 authentication / key errors, last %2"
msgstr[0] "%1 todennus-/avainvirhe, viimeisin %2"
msgstr[1] "%1 todennus-/avainvirhettä, viimeisin %2"

#: ui/DiagPage.qml:127
msgctxt "doctor finding, %1 = count, %2 = time"
msgid "%1 connection reset/refused by the keyboard, last %2"
msgid_plural "%1 connections reset/refused by the keyboard, last %2"
msgstr[0] "%1 näppäimistön nollaama/hylkäämä yhteys, viimeisin %2"
msgstr[1] "%1 näppäimistön nollaamaa/hylkäämää yhteyttä, viimeisin %2"

#: ui/DiagPage.qml:128
msgctxt "doctor finding, %1 = count, %2 = time"
msgid "%1 main.conf key ignored by bluetoothd at start, last %2"
msgid_plural "%1 main.conf keys ignored by bluetoothd at start, last %2"

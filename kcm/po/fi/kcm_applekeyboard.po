msgid "Not renamed: %1"
msgstr "Ei nimetty uudelleen: %1"

#: ui/NamePage.qml:160
msgid "Use the keyboard's own name"
msgstr "Käytä näppäimistön omaa nimeä"

#: ui/NamePage.qml:168
msgid "The keyboard's own name is used again."
msgstr "Näppäimistön omaa nimeä käytetään taas."

#: ui/NamePage.qml:180
msgid "Renaming needs the keyboard service."
msgstr "Uudelleennimeäminen vaatii näppäimistöpalvelun."


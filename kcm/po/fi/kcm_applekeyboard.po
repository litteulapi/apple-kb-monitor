#: ui/DiagPage.qml:66
msgctxt "doctor verdict"
msgid "the pairing is refused or missing: run `akmctl repair`"
msgstr "paritus hylätään tai puuttuu: suorita `akmctl repair`"

#: ui/DiagPage.qml:67
msgctxt "doctor verdict"
msgid "no usable pairing: run `akmctl repair`"
msgstr "ei käyttökelpoista paritusta: suorita `akmctl repair`"

#. i18n: %1 = the doctor topics to check, comma-separated
#: ui/DiagPage.qml:69
msgctxt "doctor verdict"
msgid "Link up; to check: %1 (akmctl doctor)"
msgstr "Yhteys ylhäällä; tarkistettavaa: %1 (akmctl doctor)"

#: ui/DiagPage.qml:70
msgctxt "doctor verdict"
msgid "link up and configuration sound"
msgstr "yhteys toimii ja asetukset ovat kunnossa"

#: ui/DiagPage.qml:71
msgctxt "doctor verdict"
msgid ""
"keyboard not connected: press a key and wait 10 s; the service pages it on "
"its own. Pair it again only if `akmctl doctor` reports auth-failed"
msgstr ""
"näppäimistö ei ole yhteydessä: paina näppäintä ja odota 10 s; palvelu kutsuu "
"sitä itse. Paritä uudelleen vain, jos `akmctl doctor` ilmoittaa auth-failed"

#: ui/DiagPage.qml:78
msgctxt "doctor finding"
msgid "rssi-helper executable, capability cap_net_admin present"
msgstr "rssi-helper suoritettava, capability cap_net_admin on olemassa"

#: ui/DiagPage.qml:79
msgctxt "doctor finding"
msgid "the rssi-helper utility is not installed"
msgstr "apuohjelmaa rssi-helper ei ole asennettu"

#: ui/DiagPage.qml:80
msgctxt "doctor finding"
msgid "the rssi-helper utility failed (missing capability, Bluetooth refused)"
msgstr ""
"apuohjelma rssi-helper epäonnistui (capability puuttuu, Bluetooth kieltäytyi)"

#: ui/DiagPage.qml:81
msgctxt "doctor finding"
msgid "the rssi-helper utility does not answer in time"
msgstr "apuohjelma rssi-helper ei vastaa ajoissa"

#: ui/DiagPage.qml:82
msgctxt "doctor finding"
msgid "the Bluetooth adapter gives no measure for this link"
msgstr "Bluetooth-sovitin ei anna mittausta tälle yhteydelle"

#: ui/DiagPage.qml:83
msgctxt "doctor finding"
msgid "the signal cannot be measured"
msgstr "signaalia ei voi mitata"

#: ui/DiagPage.qml:84
msgctxt "doctor finding, %1 = settings"
msgid "ignored by bluetoothd: %1"
msgstr "bluetoothd ohittaa: %1"

#: ui/DiagPage.qml:85
msgctxt "doctor finding"
msgid "[Policy] Reconnect* in place"
msgstr "[Policy] Reconnect* paikallaan"

#: ui/DiagPage.qml:86
msgctxt "doctor finding"
msgid "FastConnectable = true"
msgstr "FastConnectable = true"

#: ui/DiagPage.qml:87
msgctxt "doctor finding"
msgid ""
"FastConnectable off: slower answer to the keyboard's page after a key press"
msgstr ""
"FastConnectable pois: hitaampi vastaus näppäimistön kutsuun "
"näppäinpainalluksen jälkeen"

#: ui/DiagPage.qml:88
msgctxt "doctor finding, %1 = file, %2 = error"
msgid "%1: %2"
msgstr "%1: %2"

#: ui/DiagPage.qml:89
msgctxt "doctor finding"
msgid "NoPollBatteries = true (no 30 s HID polling)"
msgstr "NoPollBatteries = true (ei HID-kyselyä 30 s välein)"

#: ui/DiagPage.qml:90
msgctxt "doctor finding"
msgid ""
"UPower reads the keyboard battery every 30 s (2 GET_REPORT over the air): "
"the keyboard never sleeps"
msgstr ""
"UPower lukee näppäimistön pariston 30 s välein (2 GET_REPORT radioteitse): "
"näppäimistö ei koskaan mene lepotilaan"

#: ui/DiagPage.qml:91
msgctxt "doctor finding"
msgid "adapter is not on USB (or not found)"
msgstr "sovitin ei ole USB:ssä (tai sitä ei löytynyt)"

#: ui/DiagPage.qml:92
msgctxt "doctor finding, %1 = USB id"
msgid "%1 autosuspend off (power/control=on)"
msgstr "%1 USB-automaattinen keskeytys pois (power/control=on)"

#: ui/DiagPage.qml:94
msgctxt "doctor finding"
msgid ""
"%1 USB autosuspend active (control=%2, delay %3 ms, now %4, %5 s suspended "
"since boot)"
msgstr ""
"%1 USB-automaattinen keskeytys käytössä (control=%2, viive %3 ms, nyt %4, %5 "
"s keskeytettynä käynnistyksestä)"

#: ui/DiagPage.qml:95
msgctxt "doctor finding, appended"
msgid "; rule installed but not applied yet"
msgstr "; sääntö asennettu, mutta ei vielä käytössä"

#: ui/DiagPage.qml:96
msgctxt "doctor finding"
msgid "btusb enable_autosuspend = %1"
msgstr "btusb enable_autosuspend = %1"

#: ui/DiagPage.qml:97
msgctxt "doctor finding"
msgid "Bluetooth adapter powered"
msgstr "Bluetooth-sovitin päällä"

#: ui/DiagPage.qml:98
msgctxt "doctor finding"
msgid "Bluetooth adapter off"
msgstr "Bluetooth-sovitin pois päältä"

#: ui/DiagPage.qml:99
msgctxt "doctor finding"
msgid "BlueZ unreachable (bluetooth.service stopped?)"
msgstr "BlueZ ei tavoitettavissa (bluetooth.service pysäytetty?)"

#: ui/DiagPage.qml:100
msgctxt "doctor finding"
msgid "no paired Apple keyboard known to BlueZ"
msgstr "BlueZ ei tunne yhtään paritettua Apple-näppäimistöä"

#: ui/DiagPage.qml:101
msgctxt "doctor finding, %1 = address"
msgid "%1 is not paired"
msgstr "%1 ei ole paritettu"

#: ui/DiagPage.qml:103
msgctxt "doctor finding, %1 = address, %2 = name"
msgid "%1 “%2” paired"
msgstr "%1 ”%2” paritettu"

#: ui/DiagPage.qml:104
msgctxt "doctor finding, appended"
msgid ", bonded"
msgstr ", sidottu"

#: ui/DiagPage.qml:105
msgctxt "doctor finding, appended"
msgid ", legacy PIN pairing"
msgstr ", vanha PIN-paritus"

#: ui/DiagPage.qml:106
msgctxt "doctor finding"
msgid "not trusted: BlueZ may refuse the keyboard's own reconnection"
msgstr "ei luotettu: BlueZ voi hylätä näppäimistön oman uudelleenyhdistämisen"

#: ui/DiagPage.qml:107
msgctxt "doctor finding"
msgid "blocked in BlueZ"
msgstr "estetty BlueZissa"

#: ui/DiagPage.qml:108
msgctxt "doctor finding"
msgid "connected"
msgstr "yhdistetty"

#: ui/DiagPage.qml:109
msgctxt "doctor finding"
msgid "not connected (asleep? press a key)"
msgstr "ei yhteydessä (lepotilassa? paina näppäintä)"

#: ui/DiagPage.qml:110
msgctxt "doctor finding"
msgid "link key not checked (needs root: sudo akmctl doctor)"
msgstr "yhteysavainta ei tarkistettu (vaatii rootin: sudo akmctl doctor)"

#: ui/DiagPage.qml:111
msgctxt "doctor finding"
msgid "no [LinkKey] stored for the keyboard"
msgstr "näppäimistölle ei ole tallennettu [LinkKey]-avainta"

#: ui/DiagPage.qml:112
msgctxt "doctor finding"

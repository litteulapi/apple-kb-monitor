msgid "%1 — %2"
msgstr "%1 — %2"

#: ui/KeysPage.qml:31
msgid ""
"No answer in time: nothing was confirmed. Check the state before trying "
"again."
msgstr ""
"Pas de réponse à temps : rien n'a été confirmé. Vérifiez l'état avant de "
"réessayer."

#: ui/KeysPage.qml:33 ui/main.qml:38
msgid "unknown error"
msgstr "erreur inconnue"

#: ui/KeysPage.qml:40

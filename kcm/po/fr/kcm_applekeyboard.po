msgctxt "diagnosis level"
msgid "OK"
msgstr "OK"

#: ui/DiagPage.qml:39
msgctxt "diagnosis level"
msgid "information"
msgstr "information"

#: ui/DiagPage.qml:40
msgctxt "diagnosis level"
msgid "warning"
msgstr "avertissement"

#: ui/DiagPage.qml:41
msgctxt "diagnosis level"
msgid "problem"
msgstr "problème"

#: ui/DiagPage.qml:49 ui/DiagPage.qml:64

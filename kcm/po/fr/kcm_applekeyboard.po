msgstr "aucune réponse en 60 secondes"

#: ui/DiagPage.qml:100
msgid "Check the link"
msgstr "Vérifier la liaison"

#: ui/DiagPage.qml:103
msgid ""
"Runs akmctl doctor: Bluetooth, pairing, configuration, journal, service. "
"Reads only."
msgstr ""
"Lance akmctl doctor : Bluetooth, appairage, configuration, journal, service. "
"Lecture seule."

#: ui/DiagPage.qml:107
msgid "Self-check"
msgstr "Autotest"

#: ui/DiagPage.qml:109
msgid ""
"Runs akmctl selftest: service, link, journal, crashes, disk. Reads only."
msgstr ""
"Lance akmctl selftest : service, liaison, journal, plantages, disque. "
"Lecture seule."

#: ui/DiagPage.qml:114
msgid "Reconnect"
msgstr "Reconnecter"

#: ui/DiagPage.qml:117
msgid ""
"Asks the service to page the keyboard now (at most once every 20 seconds)"
msgstr ""
"Demande au service d'appeler le clavier maintenant (au plus une fois toutes "
"les 20 secondes)"

#: ui/DiagPage.qml:123
msgid "Reconnection requested. Press a key on the keyboard if it is asleep."
msgstr ""
"Reconnexion demandée. Appuyez sur une touche du clavier s'il est en veille."

#: ui/DiagPage.qml:124
msgid "refused by the service (asleep, too soon, or pairing refused)"
msgstr "refusée par le service (veille, trop tôt, ou appairage refusé)"

#: ui/DiagPage.qml:124

#. i18n: %1 = the doctor topics to check, comma-separated
#: ui/DiagPage.qml:69
msgctxt "doctor verdict"
msgid "Link up; to check: %1 (akmctl doctor)"
msgstr "Forbindelsen oppe; at kontrollere: %1 (akmctl doctor)"

#: ui/DiagPage.qml:70
msgctxt "doctor verdict"
msgid "link up and configuration sound"
msgstr "forbindelsen er oppe, og konfigurationen er sund"

#: ui/DiagPage.qml:71
msgctxt "doctor verdict"
msgid ""
"keyboard not connected: press a key and wait 10 s; the service pages it on "
"its own. Pair it again only if `akmctl doctor` reports auth-failed"
msgstr ""
"tastaturet er ikke forbundet: tryk på en tast, og vent 10 s; tjenesten "
"kalder det selv. Par det kun igen, hvis `akmctl doctor` melder auth-failed"

#: ui/DiagPage.qml:78
msgctxt "doctor finding"
msgid "rssi-helper executable, capability cap_net_admin present"
msgstr "rssi-helper eksekverbar, capability cap_net_admin til stede"

#: ui/DiagPage.qml:79

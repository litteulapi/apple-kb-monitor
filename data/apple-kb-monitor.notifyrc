# KNotification events of the Apple Keyboard Monitor daemon (apple-kb-monitord).
# Installed in /usr/share/knotifications6/. The daemon sends these hints:
#   x-kde-appname=apple-kb-monitor
#   x-kde-eventId=<id of an [Event/<id>] below>
# Plasma then lists the application in System Settings > Notifications and applies
# the user's choices (popup, sound, history, Do Not Disturb) per event.
# Documentation: docs/NOTIFICATIONS.md

[Global]
IconName=apihub-scarab
Name=Apple Keyboard Monitor
Name[fr]=Moniteur de clavier Apple
Name[de]=Apple-Tastaturmonitor
Name[es]=Monitor del teclado Apple
Name[it]=Monitor della tastiera Apple
Name[pt]=Monitor do teclado Apple

"""
apple-brightness-daemon — Direct I2C DDC/CI brightness for Apple Keyboards.

20x faster than ddcutil (23ms vs 500ms) by writing DDC/CI VCP commands
directly to /dev/i2c-* via ioctl. Supports key repeat without I2C flood.

Design:
  - Direct I2C: open once, write VCP Set packets, no subprocess fork
  - Rate limited: 50ms min between DDC writes (DDC/CI spec)
  - Non-blocking evdev via select()
  - Coalescing: rapid keypresses merged into single I2C write
  - KDE OSD via qdbus6
"""

import fcntl
import os
import signal
import struct
import subprocess
import sys
import time
from select import select

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

VERSION = "2.4.0"
KEYD_VIRTUAL_KB = "/dev/input/event30"

# DDC/CI
DDC_ADDR = 0x37          # I2C slave address for DDC/CI
I2C_SLAVE = 0x0703       # ioctl I2C_SLAVE
VCP_BRIGHTNESS = 0x10    # VCP code for brightness
DDC_MIN_INTERVAL = 0.05  # 50ms — DDC/CI spec minimum between commands
STEP = 5

# evdev
EV_KEY = 0x01
KEY_BRIGHTNESSDOWN = 224
KEY_BRIGHTNESSUP = 225
EVENT_FMT = "qqHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)


# ---------------------------------------------------------------------------
# I2C DDC/CI
# ---------------------------------------------------------------------------

class DDCBrightness:
    """Direct I2C DDC/CI brightness control."""

    __slots__ = ("_fd", "_value", "_last_write", "_i2c_path")

    def __init__(self, i2c_path: str):
        self._i2c_path = i2c_path
        self._fd = os.open(i2c_path, os.O_RDWR)
        fcntl.ioctl(self._fd, I2C_SLAVE, DDC_ADDR)
        self._value = self._read()
        self._last_write = 0.0

    def _read(self) -> int:
        """Read current brightness via ddcutil (one-time at startup)."""
        try:
            r = subprocess.run(
                ["ddcutil", "getvcp", str(VCP_BRIGHTNESS), "--brief",
                 "--noverify", "--bus", self._i2c_path.split("-")[-1]],
                capture_output=True, text=True, timeout=5,
            )
            if r.returncode == 0:
                parts = r.stdout.split()
                if len(parts) >= 4:
                    return int(parts[3])
        except (subprocess.TimeoutExpired, ValueError, IndexError):
            pass
        return 50

    def _write_vcp(self, code: int, value: int) -> None:
        """Send DDC/CI VCP Set command directly over I2C."""
        payload = bytes([
            0x51,                          # source address
            0x80 | 4,                      # length: 4 bytes | flag
            0x03,                          # opcode: VCP Set
            code,                          # VCP code
            value >> 8,                    # value high
            value & 0xFF,                  # value low
        ])
        chk = 0x6E                         # destination address
        for b in payload:
            chk ^= b
        os.write(self._fd, payload + bytes([chk & 0xFF]))

    def adjust(self, delta: int) -> int:
        """Adjust brightness by delta. Returns new value."""
        self._value = max(0, min(100, self._value + delta))
        now = time.monotonic()
        if now - self._last_write >= DDC_MIN_INTERVAL:
            self._write_vcp(VCP_BRIGHTNESS, self._value)
            self._last_write = now
        return self._value

    def flush(self) -> None:
        """Write pending brightness if rate limit has passed."""
        now = time.monotonic()
        if now - self._last_write >= DDC_MIN_INTERVAL:
            self._write_vcp(VCP_BRIGHTNESS, self._value)
            self._last_write = now

    def close(self) -> None:
        if self._fd >= 0:
            os.close(self._fd)
            self._fd = -1

    @property
    def value(self) -> int:
        return self._value


# ---------------------------------------------------------------------------
# I2C bus detection
# ---------------------------------------------------------------------------

def find_ddc_i2c() -> str:
    """Find the I2C bus with a DDC/CI capable display."""
    try:
        r = subprocess.run(
            ["ddcutil", "detect", "--brief"],
            capture_output=True, text=True, timeout=10,
        )
        for line in r.stdout.splitlines():
            if "I2C bus:" in line or "i2c-" in line:
                for part in line.split():
                    if part.startswith("/dev/i2c-") or part.startswith("i2c-"):
                        bus = part if part.startswith("/dev/") else f"/dev/{part}"
                        return bus
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass
    return "/dev/i2c-6"


# ---------------------------------------------------------------------------
# OSD
# ---------------------------------------------------------------------------

def show_osd(value: int) -> None:
    subprocess.Popen(
        ["qdbus6", "org.kde.plasmashell", "/org/kde/osdService",
         "org.kde.osdService.brightnessChanged", str(value)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> int:
    os.environ.setdefault(
        "DBUS_SESSION_BUS_ADDRESS", f"unix:path=/run/user/{os.getuid()}/bus"
    )

    if not os.path.exists(KEYD_VIRTUAL_KB):
        print(f"[brightness] {KEYD_VIRTUAL_KB} not found", file=sys.stderr)
        return 1

    i2c_bus = find_ddc_i2c()
    try:
        brightness = DDCBrightness(i2c_bus)
    except PermissionError:
        print(f"[brightness] {i2c_bus}: permission denied (add user to i2c group)", file=sys.stderr)
        return 1
    except OSError as e:
        print(f"[brightness] {i2c_bus}: {e}", file=sys.stderr)
        return 1

    print(
        f"[brightness] v{VERSION} i2c={i2c_bus} current={brightness.value}% "
        f"step={STEP}% latency=~23ms",
        file=sys.stderr,
    )

    fd = os.open(KEYD_VIRTUAL_KB, os.O_RDONLY | os.O_NONBLOCK)
    stop = False
    pending_osd = False

    def shutdown(signum, frame):
        nonlocal stop
        stop = True

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    try:
        while not stop:
            ready, _, _ = select([fd], [], [], DDC_MIN_INTERVAL)

            if ready:
                try:
                    while True:
                        raw = os.read(fd, EVENT_SIZE)
                        if len(raw) < EVENT_SIZE:
                            break
                        _, _, ev_type, ev_code, ev_value = struct.unpack(EVENT_FMT, raw)
                        if ev_type != EV_KEY or ev_value not in (1, 2):
                            continue
                        if ev_code == KEY_BRIGHTNESSDOWN:
                            brightness.adjust(-STEP)
                            pending_osd = True
                        elif ev_code == KEY_BRIGHTNESSUP:
                            brightness.adjust(STEP)
                            pending_osd = True
                except BlockingIOError:
                    pass

            # Flush coalesced writes + show OSD
            brightness.flush()
            if pending_osd:
                show_osd(brightness.value)
                pending_osd = False
    finally:
        brightness.close()
        os.close(fd)

    return 0


if __name__ == "__main__":
    sys.exit(main())

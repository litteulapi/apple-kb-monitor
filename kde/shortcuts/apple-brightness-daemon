"""Apple Keyboard F1/F2 brightness — uses ddc-tool Rust binary."""
import os
import signal
import struct
import subprocess
import sys
from select import select

os.environ.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path=/run/user/{os.getuid()}/bus")

KEYD_VIRTUAL_KB = "/dev/input/event30"
KEY_BRIGHTNESSDOWN = 224
KEY_BRIGHTNESSUP = 225
EVENT_FMT = "qqHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)
STEP = 5

_brightness = None

def init():
    global _brightness
    try:
        r = subprocess.run(["ddc-tool", "read", "6", "0x10"],
                           capture_output=True, text=True, timeout=3)
        if r.returncode == 0:
            _brightness = int(r.stdout.split()[0])
            return
    except Exception:
        pass
    _brightness = 50

def adjust(delta):
    global _brightness
    _brightness = max(0, min(100, _brightness + delta))
    subprocess.Popen(["ddc-tool", "write", "6", "0x10", str(_brightness)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen(["qdbus6", "org.kde.plasmashell", "/org/kde/osdService",
                      "org.kde.osdService.brightnessChanged", str(_brightness)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if not os.path.exists(KEYD_VIRTUAL_KB):
    sys.exit(1)

init()
print(f"[brightness] ddc-tool backend, current={_brightness}% step={STEP}%", file=sys.stderr)

fd = os.open(KEYD_VIRTUAL_KB, os.O_RDONLY | os.O_NONBLOCK)
stop = False
signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
signal.signal(signal.SIGINT, lambda *_: sys.exit(0))

try:
    while not stop:
        ready, _, _ = select([fd], [], [], 1.0)
        if not ready:
            continue
        try:
            while True:
                data = os.read(fd, EVENT_SIZE)
                if len(data) < EVENT_SIZE:
                    break
                _, _, typ, code, value = struct.unpack(EVENT_FMT, data)
                if typ == 1 and value in (1, 2):
                    if code == KEY_BRIGHTNESSDOWN:
                        adjust(-STEP)
                    elif code == KEY_BRIGHTNESSUP:
                        adjust(STEP)
        except BlockingIOError:
            pass
finally:
    os.close(fd)

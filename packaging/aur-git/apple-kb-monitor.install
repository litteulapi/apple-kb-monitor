# shellcheck shell=bash
# System sleep units are enabled by the `*.target.wants/` links the package
# ships under /usr/lib/systemd/system; user units by the preset
# /usr/lib/systemd/user-preset/90-apple-kb-monitor.preset, the user enabling
# them (Arch: a package starts and enables no unit). The scriptlet enables,
# starts and restarts nothing: it only prints the command.
_akm_root=""
_akm_system_units="apple-kb-monitor-suspend.service apple-kb-monitor-resume.service"
_akm_user_units="apple-kb-monitord.service apple-kb-monitor-shutdown.service apple-kb-monitor-selfcheck.timer"

# Remove the /etc/systemd links of our units, if any (written by the
# 3.1.0-16 scriptlet, or by `systemctl enable`): `systemctl disable` only
# touches /etc, a mask stays. `system` limits it to the system units, whose
# package links make /etc ones redundant; a `--global enable` of the user
# units is an admin's choice, dropped only when the package goes.
_akm_drop_etc_links() {  # [system]
    sys=0 usr=0
    for u in $_akm_system_units; do
        for l in "$_akm_root"/etc/systemd/system/*.wants/"$u"; do [ -L "$l" ] && sys=1; done
    done
    [ "${1:-}" = system ] || for u in $_akm_user_units; do
        for l in "$_akm_root"/etc/systemd/user/*.wants/"$u"; do [ -L "$l" ] && usr=1; done
    done
    # shellcheck disable=SC2086
    [ $sys = 1 ] && { systemctl disable $_akm_system_units >/dev/null 2>&1 || true; }
    # shellcheck disable=SC2086
    [ $usr = 1 ] && { systemctl --global disable $_akm_user_units >/dev/null 2>&1 || true; }
    return 0
}

# Leftovers of a version older than the package: mqtt-bridge.py and a
# .bak of it, root-executable in the helpers' directory, owned by no package.
_akm_drop_orphans() {
    for f in "$_akm_root"/usr/lib/apple-kb-monitor/mqtt-bridge.py "$_akm_root"/usr/lib/apple-kb-monitor/mqtt-bridge.py.bak*; do
        [ -f "$f" ] || [ -L "$f" ] || continue
        if pacman -Qqo "$f" >/dev/null 2>&1; then continue; fi
        rm -f "$f" && echo ">>> removed a leftover owned by no package: $f"
    done
    return 0
}

# plasmashell keeps the widget it loaded at its start: said, per user,
# never restarted here.
_akm_stale_notice() {
    for d in "$_akm_root"/proc/[0-9]*; do
        [ "$(readlink "$d/exe" 2>/dev/null)" = /usr/bin/plasmashell ] || continue
        sed -n 's/^Uid:[[:space:]]*\([0-9]*\).*/\1/p' "$d/status" 2>/dev/null
    done | sort -un | while read -r uid; do
        name=$(getent passwd "$uid" 2>/dev/null | cut -d: -f1)
        echo ">>> ${name:-uid $uid}: the ApiHub widget is updated at the next login (or now, as that user:"
        echo "    systemctl --user restart plasma-plasmashell.service)."
    done
    return 0
}

# A rule of the same name in /etc/udev/rules.d replaces the packaged one
# entirely (udev precedence): on 2026-10-01 such a leftover, owned by no
# package, gave the ACL to every Apple HID device instead of the closed list
# of keyboards. Not removed here (it may be a deliberate override):
# said, with the command.
_akm_udev_override_notice() {
    f="$_akm_root/etc/udev/rules.d/70-apple-kb-hidraw.rules"
    [ -e "$f" ] || return 0
    cmp -s "$f" "$_akm_root/usr/lib/udev/rules.d/70-apple-kb-hidraw.rules" && return 0
    owner=$(pacman -Qqo "$f" 2>/dev/null) || owner=
    echo ">>> WARNING: $f replaces the packaged udev rule"
    echo "    (same name: udev reads only the /etc one)${owner:+, it belongs to $owner}. The keyboard list"
    echo "    of the package is not applied. Unless this override is deliberate:"
    echo "      sudo rm $f && sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=hidraw"
}

post_install() {
    # Reload udev rules and re-apply the uaccess ACL on already-connected keyboards
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=hidraw 2>/dev/null || true

    # keyd is optional and never touched by the package: no reload, no
    # restart. `keyd reload` crashes keyd 2.6.0 (dangling active_kbd, SEGV).

    # The Fn mode of a connected keyboard is not changed: modprobe.d (fnmode=1)
    # applies when hid_apple loads next; now: akmctl set fnmode 1.

    _akm_drop_etc_links system
    _akm_drop_orphans
    _akm_message
    _akm_udev_override_notice
}

post_upgrade() {
    # 3.1.0-6 removed the Python CLI (apple-kb-monitor, apihub-settings) and its unit.
    if [ "$(vercmp "$2" 3.1.0-6)" -lt 0 ]; then
        echo ">>> The Python CLI is gone: use akmctl (status, history, graph, waybar, metrics, led, dump)."
        echo "    If you had enabled its unit:  systemctl --user disable apple-kb-monitor.service"
        echo '    Keep its volatile history (as your user, before a reboot):'
        # shellcheck disable=SC2016  # printed for the user to run, not expanded here
        echo '      akmctl history import "$XDG_RUNTIME_DIR/apple-kb-monitor/history.jsonl"'
    fi
    # Up to 3.1.0-29 rssi-helper needed the group akm; it now answers only for an
    # Apple keyboard and needs no group. The group is not removed here.
    if [ "$(vercmp "$2" 3.1.0-30)" -lt 0 ] && getent group akm >/dev/null 2>&1; then
        echo ">>> The group 'akm' is no longer used (signal strength needs no group). Optional: sudo groupdel akm"
    fi
    if [ "$(vercmp "$2" 3.1.0-10)" -lt 0 ]; then
        _akm_keyd_notice
    fi
    if [ "$(vercmp "$2" 3.1.0-11)" -lt 0 ]; then
        _akm_kde_keys_hint
    fi
    # 3.1.0-20: SUSPEND / EXIT_SUSPEND are off unless explicitly enabled.
    if [ "$(vercmp "$2" 3.1.0-20)" -lt 0 ]; then
        _akm_hid_suspend_notice
    fi
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=hidraw 2>/dev/null || true
    _akm_drop_etc_links system
    _akm_drop_orphans
    # keyd: never reloaded nor restarted.
    # fnmode is deliberately left alone (user choice / modprobe.d).
    # 3.2.0-3 dropped the vendor user .wants links for a preset.
    if [ "$(vercmp "$2" 3.2.0-3)" -lt 0 ]; then
        echo ">>> The user units are no longer enabled by the package. To keep them at each login:"
        _akm_enable_hint
    fi
    # Running daemons are not restarted (Arch: no service restart in a scriptlet).
    echo ">>> New daemon: systemctl --user try-restart apple-kb-monitord.service (or log in again)."
    _akm_stale_notice
    _akm_udev_override_notice
}

# Before the unit files go: drop any /etc link to them (nothing may point to a
# removed unit). The package's own links and preset leave with the package.
pre_remove() {
    _akm_drop_etc_links
}

post_remove() {
    udevadm control --reload-rules 2>/dev/null || true
    if [ -e /etc/udev/hwdb.d/90-apple-kb-monitor.hwdb ]; then
        echo ">>> Your key mapping (akmctl keymap apply) is still installed. To drop it:"
        echo "      sudo rm /etc/udev/hwdb.d/90-apple-kb-monitor.hwdb* && sudo systemd-hwdb update"
        echo "      then switch the keyboard off and on (the kernel keeps the mapping until then)"
    fi
    echo ">>> The units left with the package (no link remains under /etc/systemd)."
    echo "    A daemon still running keeps running until its user manager stops (at logout, never"
    echo "    with Linger=yes). Stop it now, as the user:  systemctl --user stop apple-kb-monitord.service"
    _akm_user_links_notice
    echo "    Per-user state, kept: ~/.config/apple-kb-monitor/ and ~/.local/state/apple-kb-monitor/"
}

# `systemctl --user enable` (the preset way, or a scriptlet older than 3.1.0-17)
# leaves links to our units under ~/.config/systemd/user, which dangle once the
# package is gone. Root does not edit users' homes: said, per user.
_akm_user_links_notice() {
    getent passwd 2>/dev/null | awk -F: '$3 == 0 || ($3 >= 1000 && $3 < 60000) {print $1 ":" $6}' |
    while IFS=: read -r name home; do
        links=""
        for u in $_akm_user_units; do
            for l in "$_akm_root$home"/.config/systemd/user/*.wants/"$u"; do
                [ -L "$l" ] && links="$links ${l#"$_akm_root"}"
            done
        done
        [ -n "$links" ] || continue
        echo ">>> Links to the removed units remain for $name (dangling now). As $name:"
        echo "      rm$links"
        echo "      systemctl --user daemon-reload"
    done
    return 0
}


# Up to 3.1.0-9 the package shipped /etc/keyd/apple-keyboard.conf and ran
# `keyd reload`, which crashed keyd 2.6.0 on the test PC. The file is now an
# example under /usr/share/doc; pacman removed it from /etc/keyd (or kept a
# .pacsave if it had been edited). A running keyd keeps the old mapping in
# memory until its next restart: tell the user, do not touch the service.
_akm_keyd_notice() {
    echo ">>> keyd is now optional: /etc/keyd/apple-keyboard.conf is no longer installed."
    echo "    The kernel (hid_apple fnmode=1) already sends brightness, Expose, media and volume;"
    echo "    optional remapping without keyd: akmctl keymap (udev hwdb). keyd is left untouched."
    echo "    - keep keyd off (recommended):  sudo systemctl disable --now keyd"
    echo "    - or keep the keyd macros:      sudo install -Dm644 /usr/share/doc/apple-kb-monitor/examples/keyd/apple-keyboard.conf /etc/keyd/"
    echo "                                    sudo systemctl restart keyd   (never 'keyd reload': it crashes keyd 2.6.0)"
    echo "    Details: /usr/share/doc/apple-kb-monitor/KEYD.md"
}

# F4 (Launchpad) and Eject are bound to nothing in KDE Plasma. The
# package changes no KDE shortcut by itself: it only says how to bind F4.
_akm_kde_keys_hint() {
    echo ">>> KDE shortcuts: F4 (Launchpad) and Eject are bound to nothing by default in Plasma."
    echo "    The package does not touch your KDE configuration. To bind F4 to the application"
    echo "    launcher, as a user (no sudo):"
    echo "      akmctl keymap kde-apply --dry-run     # shows what would be added"
    echo "      akmctl keymap kde-apply               # applies it; --undo removes exactly those keys"
    echo "    Eject stays unbound: /usr/share/doc/apple-kb-monitor/KEYS.md section 5 maps it by hand."
    echo "    Which key does what right now: akmctl keys --check"
}

# system units apple-kb-monitor-{suspend,resume}.service, enabled through
# the .wants symlinks of the package (pacman's systemd hook reloads the units).
_akm_hid_suspend_notice() {
    echo ">>> Sleep/wake bytes of macOS: HID_CONTROL SUSPEND (0x13) before the computer"
    echo "    sleeps and EXIT_SUSPEND (0x14) at wake are OFF by default since 2026-10-02:"
    echo "    measured on an A1314, SUSPEND leaves the keyboard connected but mute. Nothing is"
    echo "    sent unless /etc/apple-kb-monitor/hid-suspend.conf says enabled = true (file or"
    echo "    key absent = off). Look without sending: akmctl hid-control suspend --dry-run"
    # An edited file is kept by pacman (backup=, new one in .pacnew): say so if
    # it still turns the feature on. Read only, nothing is changed here.
    if grep -qsE '^[[:space:]]*enabled[[:space:]]*=[[:space:]]*true' /etc/apple-kb-monitor/hid-suspend.conf; then
        echo ">>> WARNING: /etc/apple-kb-monitor/hid-suspend.conf still says enabled = true (your"
        echo "    edited file was kept): SUSPEND is sent before each sleep and can leave the"
        echo "    keyboard mute after the wake. The packaged default is enabled = false."
    fi
}

_akm_enable_hint() {
    echo "      systemctl --user enable --now apple-kb-monitord.service apple-kb-monitor-shutdown.service apple-kb-monitor-selfcheck.timer"
}

_akm_message() {
    echo ">>> apple-kb-monitor: enable the daemon, as each user (no sudo):"
    _akm_enable_hint
    echo "    Plasma loads the ApiHub widget and the global shortcuts at the next"
    echo "    login. If the widget is not in the notification area: Configure > Entries > ApiHub."
    echo "    Settings: System Settings > Input & Output > Keyboard > Apple Keyboard. Diagnosis: akmctl doctor"
}

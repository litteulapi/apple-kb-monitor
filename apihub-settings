"""ApiHub Settings — Desktop app for Apple Keyboard + LG Monitor control."""

import json
import subprocess
import sys
import threading
from functools import partial

from PySide6.QtCore import Qt, QTimer, Signal, QObject
from PySide6.QtGui import QIcon, QAction, QFont, QColor, QPalette
from PySide6.QtWidgets import (
    QApplication, QMainWindow, QSystemTrayIcon, QMenu,
    QWidget, QVBoxLayout, QHBoxLayout, QGridLayout,
    QLabel, QSlider, QPushButton, QGroupBox,
    QTabWidget, QFrame, QProgressBar, QStatusBar,
)


# ---------------------------------------------------------------------------
# Data cache — fetch once, use everywhere
# ---------------------------------------------------------------------------

_cache = {"mon": {}, "kb": {}}


class DataLoader(QObject):
    done = Signal(str)

    def load(self):
        mon = _read_monitor()
        kb = _read_keyboard()
        _cache["mon"] = mon
        _cache["kb"] = kb
        self.done.emit(json.dumps({"mon": mon, "kb": kb}))


def _read_monitor():
    """Read 30 essential VCPs — one subprocess call via ddc-tool json."""
    try:
        r = subprocess.run(["ddc-tool", "json", "6"],
                           capture_output=True, text=True, timeout=15)
        if r.returncode == 0:
            return json.loads(r.stdout)
    except Exception:
        pass
    return {}


def _read_keyboard():
    try:
        r = subprocess.run(["apple-kb-monitor", "--json"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            return json.loads(r.stdout)
    except Exception:
        pass
    return {}


def ddc_write(vcp, value):
    subprocess.Popen(["ddc-tool", "write", "6", str(vcp), str(value)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---------------------------------------------------------------------------
# Widgets
# ---------------------------------------------------------------------------

class StatusBadge(QFrame):
    def __init__(self, text, parent=None):
        super().__init__(parent)
        layout = QHBoxLayout(self)
        layout.setContentsMargins(8, 2, 8, 2)
        self.label = QLabel(text)
        self.label.setFont(QFont("monospace", 9))
        layout.addWidget(self.label)
        self.set_active(False)

    def set_active(self, active):
        if active:
            self.setStyleSheet("QFrame{background:#1a3a1a;border:1px solid #4CAF50;border-radius:10px}QLabel{color:#4CAF50}")
        else:
            self.setStyleSheet("QFrame{background:transparent;border:1px solid #555;border-radius:10px}QLabel{color:#888}")


class ValueSlider(QWidget):
    def __init__(self, label, vcp, max_val=100, parent=None):
        super().__init__(parent)
        self.vcp = vcp
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        self.name_label = QLabel(label)
        self.name_label.setFixedWidth(100)
        self.slider = QSlider(Qt.Horizontal)
        self.slider.setMinimum(0)
        self.slider.setMaximum(max_val)
        self.slider.valueChanged.connect(self._on_change)
        self.value_label = QLabel("--")
        self.value_label.setFixedWidth(45)
        self.value_label.setAlignment(Qt.AlignRight | Qt.AlignVCenter)
        self.value_label.setFont(QFont("monospace", 11, QFont.Bold))
        layout.addWidget(self.name_label)
        layout.addWidget(self.slider)
        layout.addWidget(self.value_label)

    def set_value(self, val):
        self.slider.blockSignals(True)
        self.slider.setValue(val)
        self.slider.blockSignals(False)
        self.value_label.setText(f"{val}")

    def _on_change(self, val):
        self.value_label.setText(f"{val}")
        ddc_write(self.vcp, val)


class ButtonGroup(QWidget):
    def __init__(self, label, vcp, options, parent=None):
        super().__init__(parent)
        self.vcp = vcp
        self.buttons = []
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        name = QLabel(label)
        name.setFixedWidth(100)
        layout.addWidget(name)
        for text, val in options:
            btn = QPushButton(text)
            btn.setCheckable(True)
            btn.setMinimumHeight(28)
            btn.clicked.connect(partial(self._on_click, val))
            self.buttons.append((btn, val))
            layout.addWidget(btn)

    def set_active(self, current_val):
        for btn, val in self.buttons:
            btn.setChecked(val == current_val)

    def _on_click(self, val):
        ddc_write(self.vcp, val)
        self.set_active(val)


class InfoRow(QWidget):
    """Label: Value pair for info display."""
    def __init__(self, label, parent=None):
        super().__init__(parent)
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        la = QLabel(label + ":")
        la.setFixedWidth(120)
        la.setStyleSheet("color:#888")
        self.val = QLabel("--")
        self.val.setFont(QFont("sans-serif", 10, QFont.Bold))
        layout.addWidget(la)
        layout.addWidget(self.val)

    def setText(self, text):
        self.val.setText(text)


# ---------------------------------------------------------------------------
# Main Window
# ---------------------------------------------------------------------------

class ApiHubWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("ApiHub Settings")
        self.setWindowIcon(QIcon.fromTheme("apihub-scarab") if QIcon.hasThemeIcon("apihub-scarab") else QIcon.fromTheme("preferences-desktop-peripherals"))
        self.setMinimumSize(620, 520)
        self.resize(680, 580)
        self._apply_dark_theme()

        tabs = QTabWidget()
        self.setCentralWidget(tabs)

        tabs.addTab(self._build_keyboard_tab(), QIcon.fromTheme("input-keyboard"), "Keyboard")
        tabs.addTab(self._build_monitor_tab(), QIcon.fromTheme("video-display"), "Display")
        tabs.addTab(self._build_advanced_tab(), QIcon.fromTheme("configure"), "Advanced")
        tabs.addTab(self._build_system_tab(), QIcon.fromTheme("documentinfo"), "System")

        self.status = QStatusBar()
        self.setStatusBar(self.status)
        self.status.showMessage("Starting...")

        self.loader = DataLoader()
        self.loader.done.connect(self._on_data)

        self.timer = QTimer()
        self.timer.timeout.connect(self._bg_load)
        self.timer.start(30000)
        QTimer.singleShot(100, self._bg_load)

    def _bg_load(self):
        self.status.showMessage("Loading...")
        threading.Thread(target=self.loader.load, daemon=True).start()

    def _on_data(self, data_json):
        try:
            data = json.loads(data_json)
            self._update_all(data.get("mon", {}), data.get("kb", {}))
        except Exception as e:
            self.status.showMessage(f"Error: {e}")

    def _apply_dark_theme(self):
        p = QPalette()
        for role, color in [
            (QPalette.Window, (30, 30, 30)), (QPalette.WindowText, (220, 220, 220)),
            (QPalette.Base, (25, 25, 25)), (QPalette.AlternateBase, (35, 35, 35)),
            (QPalette.Text, (220, 220, 220)), (QPalette.Button, (45, 45, 45)),
            (QPalette.ButtonText, (220, 220, 220)),
            (QPalette.Highlight, (0, 120, 215)), (QPalette.HighlightedText, (255, 255, 255)),
        ]:
            p.setColor(role, QColor(*color))
        QApplication.instance().setPalette(p)

    # --- KEYBOARD ---
    def _build_keyboard_tab(self):
        w = QWidget()
        layout = QVBoxLayout(w)
        layout.setSpacing(8)

        grp = QGroupBox("Battery")
        g = QHBoxLayout(grp)
        self.kb_bat = QLabel("--")
        self.kb_bat.setFont(QFont("monospace", 42, QFont.Bold))
        self.kb_bat.setAlignment(Qt.AlignCenter)
        self.kb_bat.setMinimumWidth(120)
        g.addWidget(self.kb_bat)
        right = QVBoxLayout()
        self.kb_volt = QLabel("-- V")
        self.kb_volt.setFont(QFont("monospace", 13))
        self.kb_rssi = QLabel("-- dBm")
        self.kb_rssi.setFont(QFont("monospace", 13))
        self.kb_bar = QProgressBar()
        self.kb_bar.setRange(0, 100)
        self.kb_bar.setTextVisible(False)
        self.kb_bar.setFixedHeight(6)
        right.addWidget(self.kb_volt)
        right.addWidget(self.kb_rssi)
        right.addWidget(self.kb_bar)
        g.addLayout(right)
        layout.addWidget(grp)

        grp2 = QGroupBox("Device")
        g2 = QVBoxLayout(grp2)
        self.kb_info = {}
        for key in ["model", "firmware", "status", "chip", "mac", "driver",
                     "type", "drain", "interpolated", "health", "bt_interval", "bt_latency"]:
            labels = {"model": "Model", "firmware": "Firmware", "status": "Status",
                      "chip": "Controller", "mac": "MAC", "driver": "Driver",
                      "type": "Battery Type", "drain": "Discharge", "interpolated": "Interpolated",
                      "health": "Cell Health", "bt_interval": "BT Interval", "bt_latency": "BT Latency"}
            row = InfoRow(labels.get(key, key))
            g2.addWidget(row)
            self.kb_info[key] = row
        layout.addWidget(grp2)
        layout.addStretch()
        return w

    # --- MONITOR ---
    def _build_monitor_tab(self):
        w = QWidget()
        layout = QVBoxLayout(w)
        layout.setSpacing(6)

        grp = QGroupBox("Display")
        g = QVBoxLayout(grp)
        self.bri = ValueSlider("Brightness", 16)
        self.con = ValueSlider("Contrast", 18)
        self.sha = ValueSlider("Sharpness", 135)
        self.vol = ValueSlider("Volume", 98)
        self.bst = ValueSlider("Black Stab.", 249)
        for s in [self.bri, self.con, self.sha, self.vol, self.bst]:
            g.addWidget(s)
        layout.addWidget(grp)

        grp2 = QGroupBox("Color")
        g2 = QVBoxLayout(grp2)
        self.red = ValueSlider("Red", 22)
        self.grn = ValueSlider("Green", 24)
        self.blu = ValueSlider("Blue", 26)
        for s in [self.red, self.grn, self.blu]:
            g2.addWidget(s)
        layout.addWidget(grp2)

        self.pic = ButtonGroup("Mode", 21, [
            ("Reader", 1), ("Gamer2", 6), ("Custom", 17), ("RTS", 19),
            ("Vivid", 20), ("sRGB", 21), ("FPS1", 40), ("FPS2", 41)])
        self.inp = ButtonGroup("Input", 96, [("DP-1", 15), ("DP-2", 16), ("HDMI-1", 17), ("HDMI-2", 18)])
        self.cpre = ButtonGroup("Color", 20, [("6500K", 5), ("9300K", 8), ("User", 11)])
        layout.addWidget(self.pic)
        layout.addWidget(self.inp)
        layout.addWidget(self.cpre)
        layout.addStretch()
        return w

    # --- ADVANCED ---
    def _build_advanced_tab(self):
        w = QWidget()
        layout = QVBoxLayout(w)
        layout.setSpacing(6)
        self.rt = ButtonGroup("Response", 247, [("Off", 0), ("Fast", 1), ("Normal", 2), ("Slow", 3)])
        self.fs = ButtonGroup("FreeSync", 248, [("Off", 0), ("On", 1)])
        self.gm = ButtonGroup("Gamma", 254, [("Off", 0), ("M0", 1), ("M1", 2), ("M2", 3)])
        self.se = ButtonGroup("Energy", 246, [("Off", 0), ("Low", 1), ("High", 2)])
        self.ar = ButtonGroup("Aspect", 245, [("Wide", 1), ("Original", 2), ("Cinema1", 3), ("Cinema2", 4)])
        self.pl = ButtonGroup("LED", 253, [("Off", 0), ("On", 1)])
        self.sp = ButtonGroup("Split", 215, [("Off", 1), ("50/50", 5), ("66/33", 3), ("PBP", 0)])
        self.mu = ButtonGroup("Audio", 141, [("Mute", 1), ("Unmute", 2)])
        self.lang = ButtonGroup("Language", 204, [("EN", 0), ("FR", 2), ("DE", 3)])
        self.osd = ButtonGroup("OSD Lock", 202, [("Lock", 1), ("Unlock", 2)])
        for g in [self.rt, self.fs, self.gm, self.se, self.ar, self.pl, self.sp, self.mu, self.lang, self.osd]:
            layout.addWidget(g)

        grp = QGroupBox("Reset")
        h = QHBoxLayout(grp)
        for t, v in [("Factory", 4), ("Bri/Con", 5), ("Color", 8)]:
            b = QPushButton(t)
            b.setStyleSheet("QPushButton{color:#F44;border:1px solid #F44;padding:6px}QPushButton:hover{background:#3a1a1a}")
            b.clicked.connect(partial(ddc_write, v, 1))
            h.addWidget(b)
        layout.addWidget(grp)
        layout.addStretch()
        return w

    # --- SYSTEM ---
    def _build_system_tab(self):
        w = QWidget()
        layout = QVBoxLayout(w)
        grp = QGroupBox("Monitor")
        g = QVBoxLayout(grp)
        self.sys_info = {}
        for key in ["model", "panel", "fw", "ctrl", "vcp", "tech",
                     "hz", "hfreq", "input", "colortemp", "backlight", "hours", "power"]:
            labels = {"model": "Model", "panel": "Panel", "fw": "Firmware", "ctrl": "Controller",
                      "vcp": "VCP Version", "tech": "Display Tech", "hz": "V-Freq", "hfreq": "H-Freq",
                      "input": "Input", "colortemp": "Color Temp", "backlight": "Backlight PWM",
                      "hours": "Usage", "power": "Power"}
            row = InfoRow(labels.get(key, key))
            g.addWidget(row)
            self.sys_info[key] = row
        layout.addWidget(grp)

        grp2 = QGroupBox("Status")
        h = QHBoxLayout(grp2)
        self.badges = {}
        for n in ["FreeSync", "HDR", "SmartEnergy"]:
            b = StatusBadge(n)
            h.addWidget(b)
            self.badges[n] = b
        layout.addWidget(grp2)

        btn = QPushButton("Refresh All")
        btn.setIcon(QIcon.fromTheme("view-refresh"))
        btn.clicked.connect(self._bg_load)
        layout.addWidget(btn)
        layout.addStretch()
        return w

    # --- UPDATE ALL ---
    def _update_all(self, mon, kb):
        def g(k):
            return mon.get(k, {}).get("current", 0)

        if mon:
            self.bri.set_value(g("brightness"))
            self.con.set_value(g("contrast"))
            self.sha.set_value(g("sharpness"))
            self.vol.set_value(g("volume"))
            self.bst.set_value(g("black_stabilizer"))
            self.red.set_value(g("red_gain"))
            self.grn.set_value(g("green_gain"))
            self.blu.set_value(g("blue_gain"))
            self.pic.set_active(g("picture_mode"))
            self.inp.set_active(g("input_source"))
            self.cpre.set_active(g("color_preset"))
            self.rt.set_active(g("response_time"))
            self.fs.set_active(g("freesync"))
            self.gm.set_active(g("gamma"))
            self.se.set_active(g("smart_energy"))
            self.ar.set_active(g("aspect_ratio"))
            self.pl.set_active(g("power_led"))
            self.mu.set_active(g("audio_mute"))
            self.lang.set_active(g("language"))
            self.osd.set_active(g("osd_lock"))
            self.sp.set_active(g("split_mode"))

            fw = g("firmware")
            vcp_v = g("vcp_version")
            self.sys_info["model"].setText("LG 34GN850")
            self.sys_info["panel"].setText("IPS 3440x1440 10-bit")
            self.sys_info["fw"].setText(f"{fw >> 8}.{fw & 0xFF}")
            self.sys_info["ctrl"].setText("Myson Century (ID=6)")
            self.sys_info["vcp"].setText(f"{vcp_v >> 8}.{vcp_v & 0xFF}")
            self.sys_info["tech"].setText({3: "LCD Active Matrix (IPS)", 5: "OLED"}.get(g("display_tech"), str(g("display_tech"))))
            self.sys_info["hz"].setText(f"{g('v_freq') / 100:.1f} Hz")
            self.sys_info["hfreq"].setText(f"{g('h_freq') / 100:.2f} kHz")
            self.sys_info["input"].setText({15: "DP-1", 16: "DP-2", 17: "HDMI-1", 18: "HDMI-2"}.get(g("input_source"), "?"))
            self.sys_info["colortemp"].setText(f"{g('color_temp_kelvin')} K")
            self.sys_info["backlight"].setText(f"{g('backlight_pwm')} / 300")
            self.sys_info["hours"].setText(f"{g('usage_hours')} h ({g('usage_hours') // 24} d)")
            self.sys_info["power"].setText("On" if g("power_mode") == 1 else str(g("power_mode")))

            self.badges["FreeSync"].set_active(g("freesync") == 1)
            self.badges["SmartEnergy"].set_active(g("smart_energy") > 0)

        if kb:
            bat = kb.get("battery", {})
            pct = bat.get("percentage_fine") or bat.get("percentage") or 0
            self.kb_bat.setText(f"{pct}%")
            self.kb_bar.setValue(pct)
            self.kb_volt.setText(f"{bat.get('voltage', 0):.3f} V")
            radio = kb.get("radio", {})
            self.kb_rssi.setText(f"{radio.get('rssi_dbm', '--')} dBm")

            d = kb.get("device", {})
            self.kb_info["model"].setText(d.get("model", "--"))
            self.kb_info["firmware"].setText(kb.get("firmware", {}).get("version", "--"))
            self.kb_info["status"].setText("Connected" if d.get("mac") else "Offline")
            self.kb_info["chip"].setText(d.get("chip", "--"))
            self.kb_info["mac"].setText(d.get("mac", "--"))
            self.kb_info["driver"].setText(d.get("driver", "--"))

            v = bat.get("voltage")
            if v:
                health = "Fresh" if v >= 2.8 else "Good" if v >= 2.4 else "Low" if v >= 2.1 else "Critical"
                self.kb_info["health"].setText(f"{health} ({v:.3f}V)")

            interp = bat.get("percentage_interpolated")
            self.kb_info["interpolated"].setText(f"{interp}%" if interp else "--")

            bt = kb.get("bluetooth", {})
            interval = bt.get("interval")
            if interval:
                self.kb_info["bt_interval"].setText(f"{interval} ({interval * 1.25:.1f} ms)")
            latency = bt.get("latency")
            if latency is not None:
                self.kb_info["bt_latency"].setText(str(latency))

            a = kb.get("analysis", {})
            btype = a.get("battery_type", {})
            self.kb_info["type"].setText(btype.get("detail", "--") if btype else "--")
            dr = a.get("discharge", {})
            self.kb_info["drain"].setText(dr.get("remaining_display", "--") if dr else "--")

        n_mon = len(mon) if mon else 0
        self.status.showMessage(f"Monitor: {n_mon} VCPs | Keyboard: {'OK' if kb else 'N/A'}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    app = QApplication(sys.argv)
    app.setApplicationName("ApiHub Settings")
    icon = QIcon.fromTheme("apihub-scarab") if QIcon.hasThemeIcon("apihub-scarab") else QIcon.fromTheme("preferences-desktop-peripherals")
    app.setWindowIcon(icon)

    window = ApiHubWindow()

    tray = QSystemTrayIcon(icon, app)
    menu = QMenu()
    sa = QAction("Open ApiHub Settings")
    sa.triggered.connect(window.show)
    menu.addAction(sa)
    ra = QAction("Refresh")
    ra.triggered.connect(window._bg_load)
    menu.addAction(ra)
    menu.addSeparator()
    qa = QAction("Quit")
    qa.triggered.connect(app.quit)
    menu.addAction(qa)
    tray.setContextMenu(menu)
    tray.activated.connect(lambda r: window.show() if r == QSystemTrayIcon.Trigger else None)
    tray.show()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()

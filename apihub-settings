"""ApiHub Settings — Desktop app for Apple Bluetooth keyboard status.

Architecture:
  - QThread for background reads (not threading.Thread)
  - subprocess.run everywhere (no zombie Popen)
  - Proper cleanup on close
"""

import json
import subprocess
import sys

from PySide6.QtCore import Qt, QTimer, QThread, Signal, Slot
from PySide6.QtGui import QIcon, QAction, QFont, QColor, QPalette
from PySide6.QtWidgets import (
    QApplication, QMainWindow, QSystemTrayIcon, QMenu,
    QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QPushButton, QGroupBox,
    QProgressBar,
)


def _as_int(v, default=0):
    """Coerce a JSON value (None, str, float...) to int; never raises."""
    if isinstance(v, bool):
        return int(v)
    if isinstance(v, (int, float)):
        return int(v)
    try:
        return int(v)
    except (TypeError, ValueError):
        return default


def _txt(v, default="--"):
    """Text for a QLabel: JSON null/empty -> default, everything else str()."""
    return default if v is None or v == "" else str(v)


# ---------------------------------------------------------------------------
# Background data loader (QThread — proper Qt threading)
# ---------------------------------------------------------------------------

class LoaderThread(QThread):
    """Loads keyboard data in background."""
    data_ready = Signal(str)

    def run(self):
        kb = {}
        try:
            r = subprocess.run(["apple-kb-monitor", "--json"],
                               capture_output=True, text=True, timeout=5)
            if r.returncode == 0 and r.stdout.strip():
                kb = json.loads(r.stdout)
                if isinstance(kb, list):  # several keyboards: show the first
                    kb = kb[0] if kb else {}
                if not isinstance(kb, dict):
                    kb = {}
        except (OSError, subprocess.SubprocessError, ValueError):
            pass

        self.data_ready.emit(json.dumps({"kb": kb}))


# ---------------------------------------------------------------------------
# UI Widgets
# ---------------------------------------------------------------------------

class InfoRow(QWidget):
    def __init__(self, label, parent=None):
        super().__init__(parent)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        la = QLabel(label + ":")
        la.setFixedWidth(120)
        la.setStyleSheet("color:#888")
        lay.addWidget(la)
        self.v = QLabel("--")
        self.v.setFont(QFont("sans-serif", 10, QFont.Bold))
        lay.addWidget(self.v)

    def setText(self, t):
        self.v.setText(t)


# ---------------------------------------------------------------------------
# Main Window
# ---------------------------------------------------------------------------

class ApiHubWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("ApiHub Settings")
        ico = (QIcon.fromTheme("apihub-scarab")
               if QIcon.hasThemeIcon("apihub-scarab")
               else QIcon.fromTheme("preferences-desktop-peripherals"))
        self.setWindowIcon(ico)
        self.setMinimumSize(620, 520)
        self.resize(680, 580)
        self._dark_theme()

        self._loader = None
        self.setCentralWidget(self._kb_tab())

        self.statusBar().showMessage("Starting...")

        self._timer = QTimer(self)
        self._timer.timeout.connect(self._start_load)
        self._timer.start(30000)
        QTimer.singleShot(200, self._start_load)

    def closeEvent(self, event):
        self._timer.stop()
        if self._loader and self._loader.isRunning():
            # run() has no event loop (quit() is a no-op) and blocks in
            # subprocess calls (8 s + 5 s timeouts): wait for it, otherwise
            # Qt aborts with "Destroyed while thread is still running".
            self._loader.wait(15000)
        event.accept()

    def _start_load(self):
        if self._loader and self._loader.isRunning():
            return  # Already loading
        self.statusBar().showMessage("Loading...")
        self._loader = LoaderThread()
        self._loader.data_ready.connect(self._on_data)
        self._loader.start()

    @Slot(str)
    def _on_data(self, raw):
        try:
            d = json.loads(raw)
            self._update(d.get("kb", {}))
        except Exception as e:
            self.statusBar().showMessage(f"Error: {e}")

    def _dark_theme(self):
        p = QPalette()
        for role, c in [
            (QPalette.Window, (30, 30, 30)), (QPalette.WindowText, (220, 220, 220)),
            (QPalette.Base, (25, 25, 25)), (QPalette.AlternateBase, (35, 35, 35)),
            (QPalette.Text, (220, 220, 220)), (QPalette.Button, (45, 45, 45)),
            (QPalette.ButtonText, (220, 220, 220)),
            (QPalette.Highlight, (0, 120, 215)), (QPalette.HighlightedText, (255, 255, 255)),
        ]:
            p.setColor(role, QColor(*c))
        QApplication.instance().setPalette(p)

    # --- Keyboard tab ---
    def _kb_tab(self):
        w = QWidget()
        lo = QVBoxLayout(w)
        lo.setSpacing(8)
        grp = QGroupBox("Battery")
        g = QHBoxLayout(grp)
        self._kb_bat = QLabel("--")
        self._kb_bat.setFont(QFont("monospace", 42, QFont.Bold))
        self._kb_bat.setAlignment(Qt.AlignCenter)
        self._kb_bat.setMinimumWidth(120)
        g.addWidget(self._kb_bat)
        r = QVBoxLayout()
        self._kb_volt = QLabel("-- V")
        self._kb_volt.setFont(QFont("monospace", 13))
        self._kb_rssi = QLabel("-- dBm")
        self._kb_rssi.setFont(QFont("monospace", 13))
        self._kb_bar = QProgressBar()
        self._kb_bar.setRange(0, 100)
        self._kb_bar.setTextVisible(False)
        self._kb_bar.setFixedHeight(6)
        r.addWidget(self._kb_volt)
        r.addWidget(self._kb_rssi)
        r.addWidget(self._kb_bar)
        g.addLayout(r)
        lo.addWidget(grp)

        grp2 = QGroupBox("Device")
        g2 = QVBoxLayout(grp2)
        self._kb = {}
        for k, l in [("model", "Model"), ("firmware", "Firmware"), ("status", "Status"),
                      ("chip", "Controller"), ("mac", "MAC"), ("driver", "Driver"),
                      ("type", "Battery Type"), ("drain", "Discharge"),
                      ("interpolated", "Interpolated"), ("health", "Cell Health"),
                      ("bt_interval", "BT Interval"), ("bt_latency", "BT Latency")]:
            row = InfoRow(l)
            g2.addWidget(row)
            self._kb[k] = row
        lo.addWidget(grp2)
        btn = QPushButton("Refresh")
        btn.setIcon(QIcon.fromTheme("view-refresh"))
        btn.clicked.connect(self._start_load)
        lo.addWidget(btn)
        lo.addStretch()
        return w

    # --- Update all UI from data ---
    def _update(self, kb):
        if kb:
            bat = kb.get("battery") or {}
            pct = _as_int(bat.get("percentage_fine") or bat.get("percentage"))
            self._kb_bat.setText(f"{pct}%")
            self._kb_bar.setValue(max(0, min(100, pct)))
            volt = bat.get("voltage")
            self._kb_volt.setText(
                f"{volt:.3f} V" if isinstance(volt, (int, float)) else "-- V")
            radio = kb.get("radio") or {}
            self._kb_rssi.setText(f"{_txt(radio.get('rssi_dbm'))} dBm")

            d = kb.get("device") or {}
            self._kb["model"].setText(_txt(d.get("model")))
            self._kb["firmware"].setText(_txt((kb.get("firmware") or {}).get("version")))
            self._kb["status"].setText("Connected" if d.get("mac") else "Offline")
            self._kb["chip"].setText(_txt(d.get("chip")))
            self._kb["mac"].setText(_txt(d.get("mac")))
            self._kb["driver"].setText(_txt(d.get("driver")))

            v = bat.get("voltage")
            if isinstance(v, (int, float)) and v:
                h = "Fresh" if v >= 2.8 else "Good" if v >= 2.4 else "Low" if v >= 2.1 else "Critical"
                self._kb["health"].setText(f"{h} ({v:.3f}V)")
            interp = bat.get("percentage_interpolated")
            self._kb["interpolated"].setText(f"{interp}%" if interp else "--")

            bt = kb.get("bluetooth") or {}
            itv = bt.get("interval")
            if isinstance(itv, (int, float)) and itv:
                self._kb["bt_interval"].setText(f"{itv} ({itv * 1.25:.1f} ms)")
            lat = bt.get("latency")
            if lat is not None:
                self._kb["bt_latency"].setText(str(lat))

            an = kb.get("analysis") or {}
            btype = an.get("battery_type") or {}
            self._kb["type"].setText(_txt(btype.get("detail")))
            dr = an.get("discharge") or {}
            self._kb["drain"].setText(_txt(dr.get("remaining_display")))

        self.statusBar().showMessage(f"Keyboard: {'OK' if kb else 'N/A'}")



# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    app = QApplication(sys.argv)
    app.setApplicationName("ApiHub Settings")
    ico = (QIcon.fromTheme("apihub-scarab")
           if QIcon.hasThemeIcon("apihub-scarab")
           else QIcon.fromTheme("preferences-desktop-peripherals"))
    app.setWindowIcon(ico)

    win = ApiHubWindow()

    tray = QSystemTrayIcon(ico, app)
    menu = QMenu()
    a1 = QAction("Open ApiHub Settings")
    a1.triggered.connect(win.show)
    menu.addAction(a1)
    a2 = QAction("Refresh")
    a2.triggered.connect(win._start_load)
    menu.addAction(a2)
    menu.addSeparator()
    a3 = QAction("Quit")
    a3.triggered.connect(app.quit)
    menu.addAction(a3)
    tray.setContextMenu(menu)
    tray.activated.connect(lambda r: win.show() if r == QSystemTrayIcon.Trigger else None)
    tray.show()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()

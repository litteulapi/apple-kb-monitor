"""ApiHub Settings — Desktop app for Apple Keyboard + LG Monitor control.

Architecture:
  - QThread for background I2C reads (not threading.Thread)
  - Lock prevents concurrent I2C access
  - subprocess.run everywhere (no zombie Popen)
  - Proper cleanup on close
"""

import json
import subprocess
import sys
import threading
from functools import partial

from PySide6.QtCore import Qt, QTimer, QThread, Signal, Slot
from PySide6.QtGui import QIcon, QAction, QFont, QColor, QPalette
from PySide6.QtWidgets import (
    QApplication, QMainWindow, QSystemTrayIcon, QMenu,
    QWidget, QVBoxLayout, QHBoxLayout, QGridLayout,
    QLabel, QSlider, QPushButton, QGroupBox,
    QTabWidget, QFrame, QProgressBar, QStatusBar,
)

# ---------------------------------------------------------------------------
# I2C lock — prevents concurrent DDC reads/writes
# ---------------------------------------------------------------------------

_i2c_lock = threading.Lock()


def ddc_write(vcp, value):
    """Write DDC VCP — blocking, with lock."""
    def _do():
        with _i2c_lock:
            subprocess.run(["ddc-tool", "write", "6", str(vcp), str(value)],
                           capture_output=True, timeout=5)
    # Run in thread to not block UI slider
    threading.Thread(target=_do, daemon=True).start()


# ---------------------------------------------------------------------------
# Background data loader (QThread — proper Qt threading)
# ---------------------------------------------------------------------------

class LoaderThread(QThread):
    """Loads monitor + keyboard data in background."""
    data_ready = Signal(str)

    def run(self):
        mon = {}
        kb = {}
        with _i2c_lock:
            try:
                r = subprocess.run(["ddc-tool", "json", "6"],
                                   capture_output=True, text=True, timeout=8)
                if r.returncode == 0 and r.stdout.strip():
                    mon = json.loads(r.stdout)
            except Exception:
                pass

        try:
            r = subprocess.run(["apple-kb-monitor", "--json"],
                               capture_output=True, text=True, timeout=5)
            if r.returncode == 0 and r.stdout.strip():
                kb = json.loads(r.stdout)
        except Exception:
            pass

        self.data_ready.emit(json.dumps({"mon": mon, "kb": kb}))


# ---------------------------------------------------------------------------
# UI Widgets
# ---------------------------------------------------------------------------

class StatusBadge(QFrame):
    def __init__(self, text, parent=None):
        super().__init__(parent)
        layout = QHBoxLayout(self)
        layout.setContentsMargins(8, 2, 8, 2)
        self.label = QLabel(text)
        self.label.setFont(QFont("monospace", 9))
        layout.addWidget(self.label)
        self.set_active(False)

    def set_active(self, on):
        if on:
            self.setStyleSheet(
                "QFrame{background:#1a3a1a;border:1px solid #4CAF50;border-radius:10px}"
                "QLabel{color:#4CAF50}")
        else:
            self.setStyleSheet(
                "QFrame{background:transparent;border:1px solid #555;border-radius:10px}"
                "QLabel{color:#888}")


class ValueSlider(QWidget):
    def __init__(self, label, vcp, max_val=100, parent=None):
        super().__init__(parent)
        self.vcp = vcp
        lay = QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        name = QLabel(label)
        name.setFixedWidth(100)
        lay.addWidget(name)
        self.slider = QSlider(Qt.Horizontal)
        self.slider.setRange(0, max_val)
        self.slider.valueChanged.connect(self._changed)
        lay.addWidget(self.slider)
        self.val = QLabel("--")
        self.val.setFixedWidth(45)
        self.val.setAlignment(Qt.AlignRight | Qt.AlignVCenter)
        self.val.setFont(QFont("monospace", 11, QFont.Bold))
        lay.addWidget(self.val)

    def set_value(self, v):
        self.slider.blockSignals(True)
        self.slider.setValue(v)
        self.slider.blockSignals(False)
        self.val.setText(str(v))

    def _changed(self, v):
        self.val.setText(str(v))
        ddc_write(self.vcp, v)


class ButtonGroup(QWidget):
    def __init__(self, label, vcp, options, parent=None):
        super().__init__(parent)
        self.vcp = vcp
        self.buttons = []
        lay = QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        name = QLabel(label)
        name.setFixedWidth(100)
        lay.addWidget(name)
        for text, val in options:
            btn = QPushButton(text)
            btn.setCheckable(True)
            btn.setMinimumHeight(28)
            btn.clicked.connect(partial(self._click, val))
            self.buttons.append((btn, val))
            lay.addWidget(btn)

    def set_active(self, cur):
        for btn, val in self.buttons:
            btn.setChecked(val == cur)

    def _click(self, val):
        ddc_write(self.vcp, val)
        self.set_active(val)


class InfoRow(QWidget):
    def __init__(self, label, parent=None):
        super().__init__(parent)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        la = QLabel(label + ":")
        la.setFixedWidth(120)
        la.setStyleSheet("color:#888")
        lay.addWidget(la)
        self.v = QLabel("--")
        self.v.setFont(QFont("sans-serif", 10, QFont.Bold))
        lay.addWidget(self.v)

    def setText(self, t):
        self.v.setText(t)


# ---------------------------------------------------------------------------
# Main Window
# ---------------------------------------------------------------------------

class ApiHubWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("ApiHub Settings")
        ico = (QIcon.fromTheme("apihub-scarab")
               if QIcon.hasThemeIcon("apihub-scarab")
               else QIcon.fromTheme("preferences-desktop-peripherals"))
        self.setWindowIcon(ico)
        self.setMinimumSize(620, 520)
        self.resize(680, 580)
        self._dark_theme()

        self._loader = None
        tabs = QTabWidget()
        self.setCentralWidget(tabs)
        tabs.addTab(self._kb_tab(), QIcon.fromTheme("input-keyboard"), "Keyboard")
        tabs.addTab(self._mon_tab(), QIcon.fromTheme("video-display"), "Display")
        tabs.addTab(self._adv_tab(), QIcon.fromTheme("configure"), "Advanced")
        tabs.addTab(self._sys_tab(), QIcon.fromTheme("documentinfo"), "System")

        self.statusBar().showMessage("Starting...")

        self._timer = QTimer(self)
        self._timer.timeout.connect(self._start_load)
        self._timer.start(30000)
        QTimer.singleShot(200, self._start_load)

    def closeEvent(self, event):
        self._timer.stop()
        if self._loader and self._loader.isRunning():
            self._loader.quit()
            self._loader.wait(2000)
        event.accept()

    def _start_load(self):
        if self._loader and self._loader.isRunning():
            return  # Already loading
        self.statusBar().showMessage("Loading...")
        self._loader = LoaderThread()
        self._loader.data_ready.connect(self._on_data)
        self._loader.start()

    @Slot(str)
    def _on_data(self, raw):
        try:
            d = json.loads(raw)
            self._update(d.get("mon", {}), d.get("kb", {}))
        except Exception as e:
            self.statusBar().showMessage(f"Error: {e}")

    def _dark_theme(self):
        p = QPalette()
        for role, c in [
            (QPalette.Window, (30, 30, 30)), (QPalette.WindowText, (220, 220, 220)),
            (QPalette.Base, (25, 25, 25)), (QPalette.AlternateBase, (35, 35, 35)),
            (QPalette.Text, (220, 220, 220)), (QPalette.Button, (45, 45, 45)),
            (QPalette.ButtonText, (220, 220, 220)),
            (QPalette.Highlight, (0, 120, 215)), (QPalette.HighlightedText, (255, 255, 255)),
        ]:
            p.setColor(role, QColor(*c))
        QApplication.instance().setPalette(p)

    # --- Keyboard tab ---
    def _kb_tab(self):
        w = QWidget()
        lo = QVBoxLayout(w)
        lo.setSpacing(8)
        grp = QGroupBox("Battery")
        g = QHBoxLayout(grp)
        self._kb_bat = QLabel("--")
        self._kb_bat.setFont(QFont("monospace", 42, QFont.Bold))
        self._kb_bat.setAlignment(Qt.AlignCenter)
        self._kb_bat.setMinimumWidth(120)
        g.addWidget(self._kb_bat)
        r = QVBoxLayout()
        self._kb_volt = QLabel("-- V")
        self._kb_volt.setFont(QFont("monospace", 13))
        self._kb_rssi = QLabel("-- dBm")
        self._kb_rssi.setFont(QFont("monospace", 13))
        self._kb_bar = QProgressBar()
        self._kb_bar.setRange(0, 100)
        self._kb_bar.setTextVisible(False)
        self._kb_bar.setFixedHeight(6)
        r.addWidget(self._kb_volt)
        r.addWidget(self._kb_rssi)
        r.addWidget(self._kb_bar)
        g.addLayout(r)
        lo.addWidget(grp)

        grp2 = QGroupBox("Device")
        g2 = QVBoxLayout(grp2)
        self._kb = {}
        for k, l in [("model", "Model"), ("firmware", "Firmware"), ("status", "Status"),
                      ("chip", "Controller"), ("mac", "MAC"), ("driver", "Driver"),
                      ("type", "Battery Type"), ("drain", "Discharge"),
                      ("interpolated", "Interpolated"), ("health", "Cell Health"),
                      ("bt_interval", "BT Interval"), ("bt_latency", "BT Latency")]:
            row = InfoRow(l)
            g2.addWidget(row)
            self._kb[k] = row
        lo.addWidget(grp2)
        lo.addStretch()
        return w

    # --- Monitor tab ---
    def _mon_tab(self):
        w = QWidget()
        lo = QVBoxLayout(w)
        lo.setSpacing(6)
        grp = QGroupBox("Display")
        g = QVBoxLayout(grp)
        self._bri = ValueSlider("Brightness", 16)
        self._con = ValueSlider("Contrast", 18)
        self._sha = ValueSlider("Sharpness", 135)
        self._vol = ValueSlider("Volume", 98)
        self._bst = ValueSlider("Black Stab.", 249)
        for s in [self._bri, self._con, self._sha, self._vol, self._bst]:
            g.addWidget(s)
        lo.addWidget(grp)
        grp2 = QGroupBox("Color")
        g2 = QVBoxLayout(grp2)
        self._red = ValueSlider("Red", 22)
        self._grn = ValueSlider("Green", 24)
        self._blu = ValueSlider("Blue", 26)
        for s in [self._red, self._grn, self._blu]:
            g2.addWidget(s)
        lo.addWidget(grp2)
        self._pic = ButtonGroup("Mode", 21, [
            ("Reader", 1), ("Gamer2", 6), ("Custom", 17), ("RTS", 19),
            ("Vivid", 20), ("sRGB", 21), ("FPS1", 40), ("FPS2", 41)])
        self._inp = ButtonGroup("Input", 96, [("DP-1", 15), ("DP-2", 16), ("HDMI-1", 17), ("HDMI-2", 18)])
        self._cpre = ButtonGroup("Color", 20, [("6500K", 5), ("9300K", 8), ("User", 11)])
        lo.addWidget(self._pic)
        lo.addWidget(self._inp)
        lo.addWidget(self._cpre)
        lo.addStretch()
        return w

    # --- Advanced tab ---
    def _adv_tab(self):
        w = QWidget()
        lo = QVBoxLayout(w)
        lo.setSpacing(6)
        self._rt = ButtonGroup("Response", 247, [("Off", 0), ("Fast", 1), ("Normal", 2), ("Slow", 3)])
        self._fs = ButtonGroup("FreeSync", 248, [("Off", 0), ("On", 1)])
        self._gm = ButtonGroup("Gamma", 254, [("Off", 0), ("M0", 1), ("M1", 2), ("M2", 3)])
        self._se = ButtonGroup("Energy", 246, [("Off", 0), ("Low", 1), ("High", 2)])
        self._ar = ButtonGroup("Aspect", 245, [("Wide", 1), ("Original", 2), ("Cinema1", 3), ("Cinema2", 4)])
        self._pl = ButtonGroup("LED", 253, [("Off", 0), ("On", 1)])
        self._sp = ButtonGroup("Split", 215, [("Off", 1), ("50/50", 5), ("66/33", 3), ("PBP", 0)])
        self._mu = ButtonGroup("Audio", 141, [("Mute", 1), ("Unmute", 2)])
        self._lang = ButtonGroup("Language", 204, [("EN", 0), ("FR", 2), ("DE", 3)])
        self._osd = ButtonGroup("OSD Lock", 202, [("Lock", 1), ("Unlock", 2)])
        for g in [self._rt, self._fs, self._gm, self._se, self._ar,
                  self._pl, self._sp, self._mu, self._lang, self._osd]:
            lo.addWidget(g)
        grp = QGroupBox("Reset")
        h = QHBoxLayout(grp)
        for t, v in [("Factory", 4), ("Bri/Con", 5), ("Color", 8)]:
            b = QPushButton(t)
            b.setStyleSheet(
                "QPushButton{color:#F44;border:1px solid #F44;padding:6px}"
                "QPushButton:hover{background:#3a1a1a}")
            b.clicked.connect(partial(ddc_write, v, 1))
            h.addWidget(b)
        lo.addWidget(grp)
        lo.addStretch()
        return w

    # --- System tab ---
    def _sys_tab(self):
        w = QWidget()
        lo = QVBoxLayout(w)
        grp = QGroupBox("Monitor")
        g = QVBoxLayout(grp)
        self._sys = {}
        for k, l in [("model", "Model"), ("panel", "Panel"), ("fw", "Firmware"),
                      ("ctrl", "Controller"), ("vcp", "VCP Version"), ("tech", "Display Tech"),
                      ("hz", "V-Freq"), ("hfreq", "H-Freq"), ("input", "Input"),
                      ("colortemp", "Color Temp"), ("backlight", "Backlight PWM"),
                      ("hours", "Usage"), ("power", "Power")]:
            row = InfoRow(l)
            g.addWidget(row)
            self._sys[k] = row
        lo.addWidget(grp)
        grp2 = QGroupBox("Status")
        h = QHBoxLayout(grp2)
        self._badges = {}
        for n in ["FreeSync", "HDR", "SmartEnergy"]:
            b = StatusBadge(n)
            h.addWidget(b)
            self._badges[n] = b
        lo.addWidget(grp2)
        btn = QPushButton("Refresh All")
        btn.setIcon(QIcon.fromTheme("view-refresh"))
        btn.clicked.connect(self._start_load)
        lo.addWidget(btn)
        lo.addStretch()
        return w

    # --- Update all UI from data ---
    def _update(self, mon, kb):
        if mon:
            def g(k):
                return mon.get(k, {}).get("current", 0)

            self._bri.set_value(g("brightness"))
            self._con.set_value(g("contrast"))
            self._sha.set_value(g("sharpness"))
            self._vol.set_value(g("volume"))
            self._bst.set_value(g("black_stabilizer"))
            self._red.set_value(g("red_gain"))
            self._grn.set_value(g("green_gain"))
            self._blu.set_value(g("blue_gain"))
            self._pic.set_active(g("picture_mode"))
            self._inp.set_active(g("input_source"))
            self._cpre.set_active(g("color_preset"))
            self._rt.set_active(g("response_time"))
            self._fs.set_active(g("freesync"))
            self._gm.set_active(g("gamma"))
            self._se.set_active(g("smart_energy"))
            self._ar.set_active(g("aspect_ratio"))
            self._pl.set_active(g("power_led"))
            self._mu.set_active(g("audio_mute"))
            self._lang.set_active(g("language"))
            self._osd.set_active(g("osd_lock"))
            self._sp.set_active(g("split_mode"))

            fw = g("firmware")
            vv = g("vcp_version")
            inp_names = {15: "DP-1", 16: "DP-2", 17: "HDMI-1", 18: "HDMI-2"}
            tech_names = {3: "LCD Active Matrix (IPS)", 5: "OLED"}

            self._sys["model"].setText("LG 34GN850")
            self._sys["panel"].setText("IPS 3440x1440 10-bit")
            self._sys["fw"].setText(f"{fw >> 8}.{fw & 0xFF}")
            self._sys["ctrl"].setText("Myson Century (ID=6)")
            self._sys["vcp"].setText(f"{vv >> 8}.{vv & 0xFF}")
            self._sys["tech"].setText(tech_names.get(g("display_tech"), str(g("display_tech"))))
            self._sys["hz"].setText(f"{g('v_freq') / 100:.1f} Hz")
            self._sys["hfreq"].setText(f"{g('h_freq') / 100:.2f} kHz")
            self._sys["input"].setText(inp_names.get(g("input_source"), "?"))
            self._sys["colortemp"].setText(f"{g('color_temp_kelvin')} K")
            self._sys["backlight"].setText(f"{g('backlight_pwm')} / 300")
            self._sys["hours"].setText(f"{g('usage_hours')} h ({g('usage_hours') // 24} d)")
            self._sys["power"].setText("On" if g("power_mode") == 1 else str(g("power_mode")))

            self._badges["FreeSync"].set_active(g("freesync") == 1)
            self._badges["SmartEnergy"].set_active(g("smart_energy") > 0)

        if kb:
            bat = kb.get("battery", {})
            pct = bat.get("percentage_fine") or bat.get("percentage") or 0
            self._kb_bat.setText(f"{pct}%")
            self._kb_bar.setValue(pct)
            self._kb_volt.setText(f"{bat.get('voltage', 0):.3f} V")
            radio = kb.get("radio", {})
            self._kb_rssi.setText(f"{radio.get('rssi_dbm', '--')} dBm")

            d = kb.get("device", {})
            self._kb["model"].setText(d.get("model", "--"))
            self._kb["firmware"].setText(kb.get("firmware", {}).get("version", "--"))
            self._kb["status"].setText("Connected" if d.get("mac") else "Offline")
            self._kb["chip"].setText(d.get("chip", "--"))
            self._kb["mac"].setText(d.get("mac", "--"))
            self._kb["driver"].setText(d.get("driver", "--"))

            v = bat.get("voltage")
            if v:
                h = "Fresh" if v >= 2.8 else "Good" if v >= 2.4 else "Low" if v >= 2.1 else "Critical"
                self._kb["health"].setText(f"{h} ({v:.3f}V)")
            interp = bat.get("percentage_interpolated")
            self._kb["interpolated"].setText(f"{interp}%" if interp else "--")

            bt = kb.get("bluetooth", {})
            itv = bt.get("interval")
            if itv:
                self._kb["bt_interval"].setText(f"{itv} ({itv * 1.25:.1f} ms)")
            lat = bt.get("latency")
            if lat is not None:
                self._kb["bt_latency"].setText(str(lat))

            an = kb.get("analysis", {})
            btype = an.get("battery_type", {})
            self._kb["type"].setText(btype.get("detail", "--") if btype else "--")
            dr = an.get("discharge", {})
            self._kb["drain"].setText(dr.get("remaining_display", "--") if dr else "--")

        n = len(mon) if mon else 0
        self.statusBar().showMessage(f"Monitor: {n} VCPs | Keyboard: {'OK' if kb else 'N/A'}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    app = QApplication(sys.argv)
    app.setApplicationName("ApiHub Settings")
    ico = (QIcon.fromTheme("apihub-scarab")
           if QIcon.hasThemeIcon("apihub-scarab")
           else QIcon.fromTheme("preferences-desktop-peripherals"))
    app.setWindowIcon(ico)

    win = ApiHubWindow()

    tray = QSystemTrayIcon(ico, app)
    menu = QMenu()
    a1 = QAction("Open ApiHub Settings")
    a1.triggered.connect(win.show)
    menu.addAction(a1)
    a2 = QAction("Refresh")
    a2.triggered.connect(win._start_load)
    menu.addAction(a2)
    menu.addSeparator()
    a3 = QAction("Quit")
    a3.triggered.connect(app.quit)
    menu.addAction(a3)
    tray.setContextMenu(menu)
    tray.activated.connect(lambda r: win.show() if r == QSystemTrayIcon.Trigger else None)
    tray.show()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()

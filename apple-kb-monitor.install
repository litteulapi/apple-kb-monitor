post_install() {
    # Reload udev rules and re-apply the uaccess ACL on already-connected keyboards
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=hidraw 2>/dev/null || true

    # keyd is optional and never touched by the package (#246): no reload, no
    # restart. `keyd reload` crashes keyd 2.6.0 (dangling active_kbd, SEGV).

    # Initial install only: apply the packaged default (modprobe.d, fnmode=1)
    # right away. post_upgrade never does it: it would overwrite the mode the
    # user chose with `akmctl set fnmode N`.
    if [ -w /sys/module/hid_apple/parameters/fnmode ]; then
        echo 1 > /sys/module/hid_apple/parameters/fnmode 2>/dev/null || true
    fi

    _akm_setcap
    _akm_message
}

post_upgrade() {
    # 3.1.0-6 removed the Python CLI (apple-kb-monitor, apihub-settings) and its unit.
    if [ "$(vercmp "$2" 3.1.0-6)" -lt 0 ]; then
        echo ">>> The Python CLI is gone: use akmctl (status, history, graph, waybar, metrics, led, dump)."
        echo "    If you had enabled its unit:  systemctl --user disable apple-kb-monitor.service"
        echo "    Keep its volatile history:    akmctl history import"
    fi
    if [ "$(vercmp "$2" 3.1.0-7)" -lt 0 ]; then
        echo ">>> rssi-helper is now restricted to the group 'akm' (#209). To keep the signal"
        echo "    indicator:  sudo usermod -aG akm \$USER   (then log in again)."
    fi
    if [ "$(vercmp "$2" 3.1.0-10)" -lt 0 ]; then
        _akm_keyd_notice
    fi
    if [ "$(vercmp "$2" 3.1.0-11)" -lt 0 ]; then
        _akm_hid_suspend_notice
        _akm_kde_keys_hint
    fi
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=hidraw 2>/dev/null || true
    # keyd: never reloaded nor restarted (#246).
    # fnmode is deliberately left alone (user choice / modprobe.d).
    _akm_setcap
}

post_remove() {
    udevadm control --reload-rules 2>/dev/null || true
    if [ -e /etc/udev/hwdb.d/90-apple-kb-monitor.hwdb ]; then
        echo ">>> Your key mapping (akmctl keymap apply) is still installed. To drop it:"
        echo "      sudo rm /etc/udev/hwdb.d/90-apple-kb-monitor.hwdb* && sudo systemd-hwdb update"
        echo "      then switch the keyboard off and on (the kernel keeps the mapping until then)"
    fi
    echo ">>> To disable the daemon:"
    echo "      systemctl --user disable apple-kb-monitord.service"
}

# Up to 3.1.0-9 the package shipped /etc/keyd/apple-keyboard.conf and ran
# `keyd reload`, which crashed keyd 2.6.0 on PC01 (#246). The file is now an
# example under /usr/share/doc; pacman removed it from /etc/keyd (or kept a
# .pacsave if it had been edited). A running keyd keeps the old mapping in
# memory until its next restart: tell the user, do not touch the service.
_akm_keyd_notice() {
    echo ">>> keyd is now optional (#246): /etc/keyd/apple-keyboard.conf is no longer installed."
    echo "    The kernel (hid_apple fnmode=1) already sends brightness, Expose, media and volume;"
    echo "    optional remapping without keyd: akmctl keymap (udev hwdb). keyd is left untouched."
    echo "    - keep keyd off (recommended):  sudo systemctl disable --now keyd"
    echo "    - or keep the keyd macros:      sudo install -Dm644 /usr/share/doc/apple-kb-monitor/examples/keyd/apple-keyboard.conf /etc/keyd/"
    echo "                                    sudo systemctl restart keyd   (never 'keyd reload': it crashes keyd 2.6.0)"
    echo "    Details: /usr/share/doc/apple-kb-monitor/KEYD.md"
}

# F4 (Launchpad) and Eject are bound to nothing in KDE Plasma (#247). The
# package changes no KDE shortcut by itself: it only says how to bind them.
_akm_kde_keys_hint() {
    echo ">>> KDE shortcuts: F4 (Launchpad) and Eject are bound to nothing by default in Plasma."
    echo "    The package does not touch your KDE configuration. To bind F4 to the application"
    echo "    launcher and Eject to the session menu, as a user (no sudo):"
    echo "      akmctl keymap kde-apply --dry-run     # shows what would be added"
    echo "      akmctl keymap kde-apply               # applies it; --undo removes exactly those keys"
    echo "    Which key does what right now: akmctl keys --check"
}

# RSSI helper (#209): file capability cap_net_admin, executable by the members
# of the "akm" group only (root:akm 0750): any local account could otherwise
# read the RSSI / presence of every connected BR/EDR device (phones, headsets).
# Order matters: chown/chmod drop the file capability, setcap comes last.
# Re-applied on every install/upgrade (pacman rewrites the file).
_akm_setcap() {
    h=/usr/lib/apple-kb-monitor/rssi-helper
    systemd-sysusers /usr/lib/sysusers.d/apple-kb-monitor.conf 2>/dev/null || true
    if getent group akm >/dev/null 2>&1 && chgrp akm "$h" && chmod 0750 "$h"; then
        :
    else
        echo ">>> WARNING: group 'akm' unavailable, rssi-helper stays executable by everyone."
    fi
    if ! setcap cap_net_admin+ep "$h" 2>/dev/null; then
        echo ">>> WARNING: setcap failed, RSSI disabled. Run: sudo setcap cap_net_admin+ep $h"
    fi
}

# #244: system units apple-kb-monitor-{suspend,resume}.service, enabled through
# the .wants symlinks of the package (pacman's systemd hook reloads the units).
_akm_hid_suspend_notice() {
    echo ">>> Sleep/wake as macOS (#244): before the computer sleeps each connected Apple"
    echo "    keyboard receives HID_CONTROL SUSPEND (0x13), and EXIT_SUSPEND (0x14) at wake,"
    echo "    one byte on the HID control channel of bluetoothd. Test: akmctl hid-control suspend --dry-run"
    echo "    Turn off: enabled = false in /etc/apple-kb-monitor/hid-suspend.conf, or"
    echo "      sudo systemctl mask apple-kb-monitor-suspend.service apple-kb-monitor-resume.service"
}

_akm_message() {
    echo ""
    echo ">>> apple-kb-monitor installed"
    echo ""
    echo ">>> Keyboard access: no group needed. The udev rule 70-apple-kb-hidraw.rules"
    echo "    tags the hidraw node of Apple Bluetooth KEYBOARDS 'uaccess' (ACL for the"
    echo "    active seat user). Accepted trade-off: any process of that user can read"
    echo "    the keystrokes of that keyboard (see /usr/share/doc/apple-kb-monitor/udev-README.md)."
    echo "    If a keyboard was already connected, reconnect it or run:"
    echo "      sudo udevadm trigger --subsystem-match=hidraw"
    echo ""
    echo ">>> Signal strength (RSSI): the helper that reads it carries cap_net_admin and is"
    echo "    restricted to the group 'akm'. Add your user, then log in again:"
    echo "      sudo usermod -aG akm \$USER"
    echo "    (without it the signal indicator stays empty; nothing else is affected)."
    echo ""
    echo ">>> Self-check every 15 min (akmctl selftest, enabled for every user at next"
    echo "    login): result in ~/.local/state/apple-kb-monitor/selfcheck.json, a notification"
    echo "    on any new grave problem. Start now: systemctl --user daemon-reload &&"
    echo "    systemctl --user start apple-kb-monitor-selfcheck.timer ; opt out: ... mask ..."
    echo ""
    _akm_hid_suspend_notice
    echo ""
    echo ">>> Launch:"
    echo "      apihub-app                     # from terminal"
    echo "      # or search 'ApiHub' in KDE application menu"
    echo ""
    _akm_kde_keys_hint
    echo ""
    echo ">>> Special keys: akmctl keys --check shows what each key does in KDE; optional"
    echo "    remapping: akmctl keymap (udev hwdb, nothing installed by default). keyd is optional:"
    echo "      example config in /usr/share/doc/apple-kb-monitor/examples/keyd/ (see KEYD.md)"
}

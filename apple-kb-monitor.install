post_install() {
    # Reload udev rules
    udevadm control --reload-rules 2>/dev/null || true

    # Reload keyd config
    systemctl restart keyd 2>/dev/null || true

    # Apply fnmode immediately (persistent via modprobe.d)
    echo 1 > /sys/module/hid_apple/parameters/fnmode 2>/dev/null || true

    # KDE Bluedevil patch (backup + apply)
    local qml="/usr/share/plasma/plasmoids/org.kde.plasma.bluetooth/contents/ui/DeviceItem.qml"
    if [ -f "$qml" ] && ! grep -q "model.Battery" "$qml" 2>/dev/null; then
        cp "$qml" "${qml}.orig"
        cp /usr/share/apple-kb-monitor/kde/DeviceItem.qml "$qml"
        echo ">>> KDE Bluedevil panel patched (backup at DeviceItem.qml.orig)"
    fi

    echo ""
    echo ">>> apple-kb-monitor v3.0.0 installed"
    echo ""
    echo ">>> First-time setup:"
    echo "      sudo usermod -aG input \$USER"
    echo "      sudo usermod -aG i2c \$USER    # for DDC/CI monitor control"
    echo "      # Log out and back in"
    echo ""
    echo ">>> Configuration:"
    echo "      mkdir -p ~/.config/apple-kb-monitor"
    echo "      cp /etc/apple-kb-monitor/config.toml.example ~/.config/apple-kb-monitor/config.toml"
    echo ""
    echo ">>> Launch:"
    echo "      apihub-app                     # from terminal"
    echo "      # or search 'ApiHub' in KDE application menu"
    echo ""
    echo ">>> Special keys (via keyd):"
    echo "      F1/F2  = Monitor brightness (DDC/CI + OSD)"
    echo "      F3     = Overview (Expose)"
    echo "      F4     = Grid View (Launchpad)"
    echo "      F5     = Lock Screen"
    echo "      F6     = Show Desktop"
    echo "      F7-F9  = Media controls"
    echo "      F10-12 = Volume"
}

post_upgrade() {
    post_install
}

post_remove() {
    udevadm control --reload-rules 2>/dev/null || true

    # Restore original Bluedevil QML
    local qml="/usr/share/plasma/plasmoids/org.kde.plasma.bluetooth/contents/ui/DeviceItem.qml"
    if [ -f "${qml}.orig" ]; then
        mv "${qml}.orig" "$qml"
        echo ">>> KDE Bluedevil panel restored to original"
    fi

    echo ">>> To disable the legacy CLI daemon:"
    echo "      systemctl --user disable apple-kb-monitor.service"
}

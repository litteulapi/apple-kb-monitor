post_install() {
    # Reload udev rules and re-apply the uaccess ACL on already-connected keyboards
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=hidraw 2>/dev/null || true

    # keyd: touch it only if the user runs it (never start a disabled unit)
    _akm_keyd_reload

    # Initial install only: apply the packaged default (modprobe.d, fnmode=1)
    # right away. post_upgrade never does it: it would overwrite the mode the
    # user chose with `akmctl set fnmode N`.
    if [ -w /sys/module/hid_apple/parameters/fnmode ]; then
        echo 1 > /sys/module/hid_apple/parameters/fnmode 2>/dev/null || true
    fi

    _akm_setcap
    _akm_message
}

post_upgrade() {
    # 3.1.0-6 removed the Python CLI (apple-kb-monitor, apihub-settings) and its unit.
    if [ "$(vercmp "$2" 3.1.0-6)" -lt 0 ]; then
        echo ">>> The Python CLI is gone: use akmctl (status, history, graph, waybar, metrics, led, dump)."
        echo "    If you had enabled its unit:  systemctl --user disable apple-kb-monitor.service"
        echo "    Keep its volatile history:    akmctl history import"
    fi
    if [ "$(vercmp "$2" 3.1.0-7)" -lt 0 ]; then
        echo ">>> rssi-helper is now restricted to the group 'akm' (#209). To keep the signal"
        echo "    indicator:  sudo usermod -aG akm \$USER   (then log in again)."
    fi
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=hidraw 2>/dev/null || true
    _akm_keyd_reload
    # fnmode is deliberately left alone (user choice / modprobe.d).
    _akm_setcap
}

post_remove() {
    udevadm control --reload-rules 2>/dev/null || true
    echo ">>> To disable the daemon:"
    echo "      systemctl --user disable apple-kb-monitord.service"
}

_akm_keyd_reload() {
    if systemctl is-active --quiet keyd 2>/dev/null; then
        keyd reload 2>/dev/null || systemctl try-restart keyd 2>/dev/null || true
    fi
}

# RSSI helper (#209): file capability cap_net_admin, executable by the members
# of the "akm" group only (root:akm 0750): any local account could otherwise
# read the RSSI / presence of every connected BR/EDR device (phones, headsets).
# Order matters: chown/chmod drop the file capability, setcap comes last.
# Re-applied on every install/upgrade (pacman rewrites the file).
_akm_setcap() {
    h=/usr/lib/apple-kb-monitor/rssi-helper
    systemd-sysusers /usr/lib/sysusers.d/apple-kb-monitor.conf 2>/dev/null || true
    if getent group akm >/dev/null 2>&1 && chgrp akm "$h" && chmod 0750 "$h"; then
        :
    else
        echo ">>> WARNING: group 'akm' unavailable, rssi-helper stays executable by everyone."
    fi
    if ! setcap cap_net_admin+ep "$h" 2>/dev/null; then
        echo ">>> WARNING: setcap failed, RSSI disabled. Run: sudo setcap cap_net_admin+ep $h"
    fi
}

_akm_message() {
    echo ""
    echo ">>> apple-kb-monitor installed"
    echo ""
    echo ">>> Keyboard access: no group needed. The udev rule 70-apple-kb-hidraw.rules"
    echo "    tags the hidraw node of Apple Bluetooth KEYBOARDS 'uaccess' (ACL for the"
    echo "    active seat user). Accepted trade-off: any process of that user can read"
    echo "    the keystrokes of that keyboard (see /usr/share/doc/apple-kb-monitor/udev-README.md)."
    echo "    If a keyboard was already connected, reconnect it or run:"
    echo "      sudo udevadm trigger --subsystem-match=hidraw"
    echo ""
    echo ">>> Signal strength (RSSI): the helper that reads it carries cap_net_admin and is"
    echo "    restricted to the group 'akm'. Add your user, then log in again:"
    echo "      sudo usermod -aG akm \$USER"
    echo "    (without it the signal indicator stays empty; nothing else is affected)."
    echo ""
    echo ">>> Self-check every 15 min (akmctl selftest, enabled for every user at next"
    echo "    login): result in ~/.local/state/apple-kb-monitor/selfcheck.json, a notification"
    echo "    on any new grave problem. Start now: systemctl --user daemon-reload &&"
    echo "    systemctl --user start apple-kb-monitor-selfcheck.timer ; opt out: ... mask ..."
    echo ""
    echo ">>> Launch:"
    echo "      apihub-app                     # from terminal"
    echo "      # or search 'ApiHub' in KDE application menu"
    echo ""
    echo ">>> Special keys (via keyd, device 05ac:0256):"
    echo "      F3 = Overview, F4 = Grid View, F5 = Lock Screen, F6 = Show Desktop"
    echo "      F1/F2 and the other keys are passed through to the system"
}

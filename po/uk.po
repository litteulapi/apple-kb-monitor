#: apihub-app/akm-core/src/advice.rs
#, rust-format
msgid "Batteries replaced too often: {first} d then {second} d (under 30 d)"
msgstr ""
"Батарейки міняються надто часто: {first} д, потім {second} д (менше 30 д)"

#: apihub-app/akm-core/src/advice.rs
msgid ""
"Check the declared chemistry ([battery] chemistry), try fresh cells of "
"another batch or low self-discharge NiMH cells, and switch the keyboard off "
"when it is not used."
msgstr ""
"Перевірте вказану хімію ([battery] chemistry), спробуйте свіжі елементи з "
"іншої партії або NiMH-елементи з низьким саморозрядом і вимикайте "
"клавіатуру, коли вона не використовується."

#: apihub-app/akm-core/src/alias.rs
#, rust-format
msgid "name too long (max {max_chars} characters, {max_bytes} bytes)"
msgstr "ім'я задовге (не більше {max_chars} символів, {max_bytes} байтів)"

#: apihub-app/akm-core/src/alias.rs
msgid "name must not start with '-'"
msgstr "ім'я не має починатися з «-»"

#: apihub-app/akm-core/src/alias.rs
#, rust-format
msgid "name contains a forbidden character (U+{code})"
msgstr "ім'я містить заборонений символ (U+{code})"

#: apihub-app/akm-core/src/batteries.rs
msgid "no battery history"
msgstr "немає історії батарейок"

#: apihub-app/akm-core/src/batteries.rs
msgid "#  installed            days   from  ->  to    state"
msgstr "#  встановлені          днів   з     ->  до    стан"

#: apihub-app/akm-core/src/batteries.rs
msgid "replaced"
msgstr "замінені"

#: apihub-app/akm-core/src/batteries.rs
msgid "in use"
msgstr "використовуються"

#: apihub-app/akm-core/src/batteries.rs
#, rust-format
msgid "Keyboard {mac}:"
msgstr "Клавіатура {mac}:"

#: apihub-app/akm-core/src/batteries.rs
msgid "Samples recorded without a keyboard address:"
msgstr "Заміри, записані без адреси клавіатури:"

#: apihub-app/akm-core/src/devname.rs
msgid "empty name"
msgstr "порожнє ім'я"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "{n} characters, at most {max} (what 0x51-0x54 can show back)"
msgstr "{n} символів, не більше {max} (стільки можуть повернути 0x51-0x54)"

#: apihub-app/akm-core/src/devname.rs
msgid "leading or trailing space"
msgstr "пробіл на початку або в кінці"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "control character U+{code}"
msgstr "керівний символ U+{code}"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "non-ASCII character {c} (the keyboard stores ASCII)"
msgstr "символ поза ASCII {c} (клавіатура зберігає ASCII)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "character {c} refused (escape character of BlueZ's key file)"
msgstr "символ {c} відхилено (екранувальний символ файлу ключів BlueZ)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "backup schema {schema} unknown"
msgstr "невідома схема копії {schema}"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "fragment {i} is not hex"
msgstr "фрагмент {i} не в шістнадцятковому вигляді"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "fragment {i} has {n} bytes, expected {expected}"
msgstr "у фрагменті {i} {n} байтів, очікувалося {expected}"

#: apihub-app/akm-core/src/devname.rs
msgid "bytes after the NUL terminator: refused (not a name this tool restores)"
msgstr ""
"байти після завершального NUL: відхилено (це не ім'я, яке відновлює цей "
"інструмент)"

#: apihub-app/akm-core/src/devname.rs
msgid "the saved name is empty: refused"
msgstr "збережене ім'я порожнє: відхилено"

#: apihub-app/akm-core/src/devname.rs
msgid "the fragments do not spell the saved name"
msgstr "фрагменти не складаються у збережене ім'я"

#: apihub-app/akm-core/src/devname.rs apihub-app/crates/akmctl/src/forget.rs
msgid "keyboard not connected"
msgstr "клавіатуру не під'єднано"

#: apihub-app/akm-core/src/devname.rs
msgid "battery below 20 % and state not 'normal' (or unknown)"
msgstr "заряд нижче 20 % і стан не «normal» (або невідомий)"

#: apihub-app/akm-core/src/devname.rs apihub-app/crates/akmctl/src/forget.rs
msgid "circuit breaker open: the keyboard stopped answering"
msgstr "запобіжник розімкнено: клавіатура перестала відповідати"

#: apihub-app/akm-core/src/devname.rs
msgid "the last hardware read failed or was incomplete"
msgstr "останнє читання обладнання не вдалося або було неповним"

#: apihub-app/akm-core/src/devname.rs
msgid "`akmctl doctor` is not green (link health, pairing, configuration)"
msgstr ""
"`akmctl doctor` не зелений (стан зв'язку, з'єднання в пару, налаштування)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel unknown: it must be read (akm-"
"helper hid-inspect, read-only) and be >= {min} before a 66-byte frame is sent"
msgstr ""
"вихідний MTU керівного каналу L2CAP невідомий: його треба прочитати (akm-"
"helper hid-inspect, лише читання), і він має бути >= {min} до надсилання 66-"
"байтового кадру"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel is {m}, below {min}: a 66-byte "
"frame cannot be sent in one piece (Linux hidp does not fragment; the HID "
"session would be terminated)"
msgstr ""
"вихідний MTU керівного каналу L2CAP дорівнює {m}, менше {min}: 66-байтовий "
"кадр не можна надіслати цілим (hidp у Linux не фрагментує; сеанс HID було б "
"розірвано)"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - up to date (latest public version known)"
msgstr "Мікропрограма: {v} — актуальна (остання відома публічна версія)"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - update available from Apple (latest known: {l})"
msgstr "Мікропрограма: {v} — Apple має оновлення (остання відома: {l})"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - no public Apple update for this model"
msgstr "Мікропрограма: {v} — для цієї моделі немає публічних оновлень Apple"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - unknown (model or version not in the table)"
msgstr "Мікропрограма: {v} — невідомо (моделі або версії немає в таблиці)"


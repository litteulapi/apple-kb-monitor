msgstr "Maskinlæsbar JSON (skema 1) på én linje"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print help"
msgstr "Vis hjælp"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Read a setting"
msgstr "Læs en indstilling"

#: apihub-app/crates/akmctl/src/cli_strings.rs

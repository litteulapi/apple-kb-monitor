msgid "Fn key has no effect"
msgstr "Fn キーは無効"

#: apihub-app/akm-core/src/hid_params.rs
msgid "disabled (Fn key has no effect)"
msgstr "disabled (Fn キーは無効)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "media keys first"
msgstr "メディアキー優先"

#: apihub-app/akm-core/src/hid_params.rs
msgid "fkeyslast (media keys by default, Fn+Fx = F-key)"
msgstr "fkeyslast (既定でメディアキー、Fn+Fx = F キー)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "F1–F12 first"
msgstr "F1–F12 優先"

#: apihub-app/akm-core/src/hid_params.rs
msgid "fkeysfirst (F-keys by default, Fn+Fx = media key)"
msgstr "fkeysfirst (既定で F キー、Fn+Fx = メディアキー)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "media keys first (auto)"
msgstr "メディアキー優先 (自動)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "auto (media keys by default on Apple keyboards, Fn+Fx = F-key)"
msgstr "自動 (Apple キーボードでは既定でメディアキー、Fn+Fx = F キー)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "F-keys disabled"
msgstr "F キー無効"

#: apihub-app/akm-core/src/hid_params.rs
msgid "fkeysdisabled (F-keys disabled, media keys only)"
msgstr "fkeysdisabled (F キー無効、メディアキーのみ)"


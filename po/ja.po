msgstr "不明なプリセット {preset} (apple、fkeys、linux-pc)"

#: apihub-app/akm-core/src/keymap.rs
msgid "expected a quoted string"
msgstr "引用符で囲まれた文字列が必要です"

#: apihub-app/akm-core/src/keymap.rs
msgid "unterminated string"
msgstr "文字列が閉じられていません"

#: apihub-app/akm-core/src/keymap.rs
msgid "escapes and control characters are not allowed in strings"
msgstr "文字列内ではエスケープと制御文字は使用できません"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "unexpected text {r}"
msgstr "予期しないテキスト {r}"

#: apihub-app/akm-core/src/keymap.rs
msgid "expected , or ] in array"
msgstr "配列内には , または ] が必要です"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "bad value {tok} (string, integer or array of strings)"
msgstr "無効な値 {tok} (文字列、整数、または文字列の配列)"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "bad integer {tok}"
msgstr "無効な整数 {tok}"

#: apihub-app/akm-core/src/keymap.rs
msgid "expected a key"
msgstr "キーが必要です"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format

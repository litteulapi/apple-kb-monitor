msgstr "キー {key} が重複しています"

#: apihub-app/akm-core/src/keymap.rs
msgid "unterminated section header"
msgstr "セクション見出しが閉じられていません"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid ""
"unknown section [{section}] (profile.NAME, profile.NAME.keys, "
"profile.NAME.params)"
msgstr ""
"不明なセクション [{section}] (profile.名前、profile.名前.keys、profile.名"
"前.params)"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "bad profile name {name} (a-z 0-9 - _, 1-32 characters)"
msgstr "無効なプロファイル名 {name} (a-z 0-9 - _、1〜32 文字)"

#: apihub-app/akm-core/src/keymap.rs
msgid "models: 1 to 9 entries"
msgstr "models: 1～9 項目"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "duplicate model {m}"
msgstr "モデル {m} が重複しています"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid ""
"unknown or ill-typed key {k} in [profile.{n}] (preset = \"apple\", models = "

msgstr "PID {pid} が 2 回照合されました"

#: apihub-app/akm-core/src/keymap.rs
msgid "expected KEYBOARD_KEY_<scancode>=<name>"
msgstr "KEYBOARD_KEY_<スキャンコード>=<名前> が必要です"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format

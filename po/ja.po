msgstr ""
"[profile.{n}] のキー {k} が不明か型が誤っています (preset = \"apple\", "
"models = [\"05ac:0256\"])"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "unknown hid_apple parameter {key} ({known})"
msgstr "不明な hid_apple パラメーター {key} ({known})"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "{key} must be an integer"
msgstr "{key} は整数である必要があります"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "{key} = {v} out of range {min}..={max} ({help})"
msgstr "{key} = {v} が範囲 {min}..={max} 外です ({help})"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "{key} must be a \"KEY_*\" string"
msgstr "{key} は \"KEY_*\" 文字列である必要があります"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format

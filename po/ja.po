#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid ""
"unknown key {key}: use a key name (F1..F12, Eject, Fn, LeftCmd...; see "
"`akmctl keys --all`) or a HID usage like 0x7003a"
msgstr ""
"不明なキー {key}: キー名 (F1..F12、Eject、Fn、LeftCmd...。`akmctl keys --"
"all` を参照) または 0x7003a のような HID usage を使用してください"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid ""
"scancode {code} is not remappable (allowed: keyboard page 0x7xxxx with a "
"kernel default, Eject 0xc00b8, Fn 0xff0003)"
msgstr ""
"スキャンコード {code} は割り当てを変更できません (許可: カーネル既定コードを"
"持つキーボードページ 0x7xxxx、Eject 0xc00b8、Fn 0xff0003)"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "did you mean {key}?"
msgstr "{key} のことですか?"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid ""
"unknown key code {code}: expected a KEY_* name of linux/input-event-"
"codes.h{hint}"
msgstr ""
"不明なキーコード {code}: linux/input-event-codes.h の KEY_* 名が必要です"
"{hint}"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid ""
"bad model {s}: expected 05ac:PPPP with PPPP an Apple Wireless Keyboard "
"(aluminium) product id"
msgstr ""
"無効なモデル {s}: 05ac:PPPP の形式で、PPPP は Apple Wireless Keyboard (アルミ"
"ニウム) の製品 ID である必要があります"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "invalid {name} value {s} (expected {min}..={max}: {help})"
msgstr "{name} の値 {s} が無効です ({min}..={max} が必要: {help})"

#: apihub-app/akm-core/src/keymap.rs
msgid ""
"NumLock: with the NumLock LED on, hid_apple turns J K L U I O 7 8 9 M 0 ; / "
"P - into keypad keys (APPLE_NUMLOCK_EMULATION); press again to leave"
msgstr ""
"NumLock: NumLock の LED が点灯している間、hid_apple は J K L U I O 7 8 9 M "
"0 ; / P - をテンキーに変えます (APPLE_NUMLOCK_EMULATION)。もう一度押すと解除"
"されます"

#: apihub-app/akm-core/src/keymap.rs
msgid "Fn remapped: the Fn layer of hid_apple is lost"
msgstr "Fn を再割り当て: hid_apple の Fn レイヤーが失われます"

#: apihub-app/akm-core/src/keymap.rs
msgid "remapped before hid_apple: no Fn layer on this key any more"
msgstr "hid_apple より前で再割り当て: このキーには Fn レイヤーがなくなります"

#: apihub-app/akm-core/src/keymap.rs
msgid ""
"iso_layout=-1: hid_apple swaps these two keys when the keyboard reports the "
"ISO country code"
msgstr ""
"iso_layout=-1: キーボードが ISO 国コードを報告すると、hid_apple はこの 2 つの"
"キーを入れ替えます"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "line {line}: {m}"
msgstr "{line} 行目: {m}"

#: apihub-app/akm-core/src/keymap.rs
msgid "Apple (key legends)"
msgstr "Apple (キーの刻印どおり)"

#: apihub-app/akm-core/src/keymap.rs
msgid "Classic F1-F12"
msgstr "従来の F1-F12"

#: apihub-app/akm-core/src/keymap.rs
msgid "Linux PC (Cmd↔Alt)"
msgstr "Linux PC (Cmd↔Alt)"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format

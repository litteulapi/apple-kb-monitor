msgstr ""
"neplatný model {s}: očekáváno 05ac:PPPP, kde PPPP je ID produktu Apple "
"Wireless Keyboard (hliníkové)"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "invalid {name} value {s} (expected {min}..={max}: {help})"
msgstr "neplatná hodnota {s} pro {name} (očekáváno {min}..={max}: {help})"

#: apihub-app/akm-core/src/keymap.rs
msgid ""
"NumLock: with the NumLock LED on, hid_apple turns J K L U I O 7 8 9 M 0 ; / "

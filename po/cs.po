msgstr ""
"neznámá klávesa {key}: použijte název klávesy (F1..F12, Eject, Fn, "
"LeftCmd...; viz `akmctl keys --all`) nebo HID usage jako 0x7003a"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid ""
"scancode {code} is not remappable (allowed: keyboard page 0x7xxxx with a "
"kernel default, Eject 0xc00b8, Fn 0xff0003)"
msgstr ""
"scancode {code} nelze přemapovat (povoleno: stránka klávesnice 0x7xxxx s "
"výchozím kódem jádra, Eject 0xc00b8, Fn 0xff0003)"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid "did you mean {key}?"
msgstr "mysleli jste {key}?"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid ""
"unknown key code {code}: expected a KEY_* name of linux/input-event-"
"codes.h{hint}"
msgstr ""
"neznámý kód klávesy {code}: očekáván název KEY_* z linux/input-event-"
"codes.h{hint}"

#: apihub-app/akm-core/src/keymap.rs
#, rust-format
msgid ""
"bad model {s}: expected 05ac:PPPP with PPPP an Apple Wireless Keyboard "

msgid "fkeyslast (media keys by default, Fn+Fx = F-key)"
msgstr "fkeyslast (ve výchozím stavu multimediální klávesy, Fn+Fx = klávesa F)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "F1–F12 first"
msgstr "nejprve F1–F12"

#: apihub-app/akm-core/src/hid_params.rs
msgid "fkeysfirst (F-keys by default, Fn+Fx = media key)"
msgstr ""
"fkeysfirst (ve výchozím stavu klávesy F, Fn+Fx = multimediální klávesa)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "media keys first (auto)"
msgstr "nejprve multimediální klávesy (auto)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "auto (media keys by default on Apple keyboards, Fn+Fx = F-key)"
msgstr ""
"auto (na klávesnicích Apple výchozí multimediální klávesy, Fn+Fx = klávesa F)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "F-keys disabled"
msgstr "Klávesy F vypnuty"

#: apihub-app/akm-core/src/hid_params.rs
msgid "fkeysdisabled (F-keys disabled, media keys only)"
msgstr "fkeysdisabled (klávesy F vypnuty, pouze multimediální klávesy)"


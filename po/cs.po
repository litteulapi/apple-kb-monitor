msgstr ""
"Předběžná kontrola: ok (doctor zelený, baterie {battery} %, jistič sepnut)\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
#, rust-format
msgid ""
"Pre-flight: ok (doctor green, breaker closed, outgoing MTU {mtu} >= {min})\n"
msgstr ""
"Předběžná kontrola: ok (doctor zelený, jistič sepnut, odchozí MTU {mtu} >= "
"{min})\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
msgid "Pre-flight: ok (doctor green, breaker closed)\n"
msgstr "Předběžná kontrola: ok (doctor zelený, jistič sepnut)\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
msgid ""
"Refused: no terminal to confirm. Add --yes to write without the question. "
"Nothing was touched.\n"
msgstr ""
"Odmítnuto: žádný terminál pro potvrzení. Přidejte --yes pro zápis bez "
"dotazu. Ničeho se nedotklo.\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs

msgstr "Zjištěno disasemblací (docs/RENAME-KEYBOARD.md):"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
msgid "Measured on the keyboard (firmware 0x0050):\n"
msgstr "Změřeno na klávesnici (firmware 0x0050):\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
msgid "Not measured:\n"
msgstr "Nezměřeno:\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
msgid "Experiments:\n"
msgstr "Experimenty:\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
msgid ""
"Frame sent (the one of Lion 10.7.5 setDeviceName:, established by "

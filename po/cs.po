#: apihub-app/akm-core/src/advice.rs
#, rust-format
msgid "Batteries replaced too often: {first} d then {second} d (under 30 d)"
msgstr ""
"Baterie se mění příliš často: {first} d, pak {second} d (méně než 30 d)"

#: apihub-app/akm-core/src/advice.rs
msgid ""
"Check the declared chemistry ([battery] chemistry), try fresh cells of "
"another batch or low self-discharge NiMH cells, and switch the keyboard off "
"when it is not used."
msgstr ""
"Zkontrolujte uvedenou chemii ([battery] chemistry), zkuste nové články z "
"jiné šarže nebo NiMH články s nízkým samovybíjením a vypínejte klávesnici, "
"když ji nepoužíváte."

#: apihub-app/akm-core/src/alias.rs
#, rust-format
msgid "name too long (max {max_chars} characters, {max_bytes} bytes)"
msgstr "název je příliš dlouhý (nejvýše {max_chars} znaků, {max_bytes} bajtů)"

#: apihub-app/akm-core/src/alias.rs
msgid "name must not start with '-'"
msgstr "název nesmí začínat znakem „-“"

#: apihub-app/akm-core/src/alias.rs
#, rust-format
msgid "name contains a forbidden character (U+{code})"
msgstr "název obsahuje zakázaný znak (U+{code})"

#: apihub-app/akm-core/src/batteries.rs
msgid "no battery history"
msgstr "žádná historie baterií"

#: apihub-app/akm-core/src/batteries.rs
msgid "#  installed            days   from  ->  to    state"
msgstr "#  vloženy              dny    od    ->  do    stav"

#: apihub-app/akm-core/src/batteries.rs
msgid "replaced"
msgstr "vyměněny"

#: apihub-app/akm-core/src/batteries.rs
msgid "in use"
msgstr "používány"

#: apihub-app/akm-core/src/batteries.rs
#, rust-format
msgid "Keyboard {mac}:"
msgstr "Klávesnice {mac}:"

#: apihub-app/akm-core/src/batteries.rs
msgid "Samples recorded without a keyboard address:"
msgstr "Vzorky zaznamenané bez adresy klávesnice:"

#: apihub-app/akm-core/src/devname.rs
msgid "empty name"
msgstr "prázdný název"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "{n} characters, at most {max} (what 0x51-0x54 can show back)"
msgstr "{n} znaků, nejvýše {max} (co dokážou 0x51-0x54 vrátit)"

#: apihub-app/akm-core/src/devname.rs
msgid "leading or trailing space"
msgstr "mezera na začátku nebo na konci"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "control character U+{code}"
msgstr "řídicí znak U+{code}"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "non-ASCII character {c} (the keyboard stores ASCII)"
msgstr "znak mimo ASCII {c} (klávesnice ukládá ASCII)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "character {c} refused (escape character of BlueZ's key file)"
msgstr "znak {c} odmítnut (únikový znak souboru klíčů BlueZ)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "backup schema {schema} unknown"
msgstr "neznámé schéma zálohy {schema}"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "fragment {i} is not hex"
msgstr "fragment {i} není šestnáctkový"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "fragment {i} has {n} bytes, expected {expected}"
msgstr "fragment {i} má {n} bajtů, očekáváno {expected}"

#: apihub-app/akm-core/src/devname.rs
msgid "bytes after the NUL terminator: refused (not a name this tool restores)"
msgstr ""
"bajty za ukončovacím NUL: odmítnuto (není to název, který tento nástroj "
"obnovuje)"

#: apihub-app/akm-core/src/devname.rs
msgid "the saved name is empty: refused"
msgstr "uložený název je prázdný: odmítnuto"

#: apihub-app/akm-core/src/devname.rs
msgid "the fragments do not spell the saved name"
msgstr "fragmenty neodpovídají uloženému názvu"

#: apihub-app/akm-core/src/devname.rs apihub-app/crates/akmctl/src/forget.rs
msgid "keyboard not connected"
msgstr "klávesnice nepřipojena"

#: apihub-app/akm-core/src/devname.rs
msgid "battery below 20 % and state not 'normal' (or unknown)"
msgstr "baterie pod 20 % a stav jiný než „normal“ (nebo neznámý)"

#: apihub-app/akm-core/src/devname.rs apihub-app/crates/akmctl/src/forget.rs
msgid "circuit breaker open: the keyboard stopped answering"
msgstr "jistič rozepnut: klávesnice přestala odpovídat"

#: apihub-app/akm-core/src/devname.rs
msgid "the last hardware read failed or was incomplete"
msgstr "poslední čtení hardwaru selhalo nebo bylo neúplné"

#: apihub-app/akm-core/src/devname.rs
msgid "`akmctl doctor` is not green (link health, pairing, configuration)"
msgstr "`akmctl doctor` není zelený (stav spojení, spárování, konfigurace)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel unknown: it must be read (akm-"
"helper hid-inspect, read-only) and be >= {min} before a 66-byte frame is sent"
msgstr ""
"odchozí MTU řídicího kanálu L2CAP neznámé: musí se přečíst (akm-helper hid-"
"inspect, jen čtení) a být >= {min}, než se odešle 66bajtový rámec"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel is {m}, below {min}: a 66-byte "
"frame cannot be sent in one piece (Linux hidp does not fragment; the HID "
"session would be terminated)"
msgstr ""
"odchozí MTU řídicího kanálu L2CAP je {m}, pod {min}: 66bajtový rámec nelze "
"odeslat vcelku (hidp v Linuxu nefragmentuje; relace HID by byla ukončena)"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - up to date (latest public version known)"
msgstr "Firmware: {v} - aktuální (nejnovější známá veřejná verze)"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - update available from Apple (latest known: {l})"
msgstr "Firmware: {v} - Apple nabízí aktualizaci (nejnovější známá: {l})"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - no public Apple update for this model"
msgstr "Firmware: {v} - pro tento model neexistuje veřejná aktualizace Apple"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - unknown (model or version not in the table)"
msgstr "Firmware: {v} - neznámý (model nebo verze nejsou v tabulce)"

#: apihub-app/akm-core/src/forecast.rs
#, rust-format
msgid "≈ {n} day"
msgid_plural "≈ {n} days"
msgstr[0] "≈ {n} den"
msgstr[1] "≈ {n} dny"
msgstr[2] "≈ {n} dní"

#: apihub-app/akm-core/src/forecast.rs
#, rust-format
msgid "≈ {h} h"
msgstr "≈ {h} h"


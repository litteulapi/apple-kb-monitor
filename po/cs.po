msgstr ""
"NumLock: při rozsvícené LED NumLock mění hid_apple J K L U I O 7 8 9 M 0 ; / "
"P - na klávesy numerické klávesnice (APPLE_NUMLOCK_EMULATION); dalším "
"stiskem se vrátíte"

#: apihub-app/akm-core/src/keymap.rs
msgid "Fn remapped: the Fn layer of hid_apple is lost"
msgstr "Fn přemapováno: vrstva Fn ovladače hid_apple se ztratí"

#: apihub-app/akm-core/src/keymap.rs
msgid "remapped before hid_apple: no Fn layer on this key any more"
msgstr "přemapováno před hid_apple: tato klávesa už nemá vrstvu Fn"

#: apihub-app/akm-core/src/keymap.rs
msgid ""
"iso_layout=-1: hid_apple swaps these two keys when the keyboard reports the "

msgid "name must not start with '-'"
msgstr "il nome non deve iniziare con «-»"

#: apihub-app/akm-core/src/alias.rs
#, rust-format
msgid "name contains a forbidden character (U+{code})"
msgstr "il nome contiene un carattere vietato (U+{code})"

#: apihub-app/akm-core/src/batteries.rs
msgid "no battery history"
msgstr "nessuno storico delle batterie"


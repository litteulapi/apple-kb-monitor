msgid "leading or trailing space"
msgstr "välilyönti alussa tai lopussa"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "control character U+{code}"
msgstr "ohjausmerkki U+{code}"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "non-ASCII character {c} (the keyboard stores ASCII)"
msgstr "muu kuin ASCII-merkki {c} (näppäimistö tallentaa ASCII-merkkejä)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "character {c} refused (escape character of BlueZ's key file)"
msgstr "merkki {c} hylätty (BlueZ:n avaintiedoston escape-merkki)"


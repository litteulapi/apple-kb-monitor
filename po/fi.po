msgstr "Koneluettava JSON (skeema 1) yhdellä rivillä"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print help"
msgstr "Näytä ohje"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Read a setting"
msgstr "Lue asetus"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Current Fn mode (0-4), read from /sys/module/hid_apple/parameters/fnmode"
msgstr ""
"Nykyinen Fn-tila (0-4), luettu tiedostosta /sys/module/hid_apple/parameters/"
"fnmode"

#: apihub-app/crates/akmctl/src/cli_strings.rs

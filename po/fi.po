#, rust-format
msgid "fragment {i} has {n} bytes, expected {expected}"
msgstr "fragmentissa {i} on {n} tavua, odotettiin {expected}"

#: apihub-app/akm-core/src/devname.rs
msgid "bytes after the NUL terminator: refused (not a name this tool restores)"
msgstr ""
"tavuja NUL-päätteen jälkeen: hylätty (ei nimi, jonka tämä työkalu palauttaa)"

#: apihub-app/akm-core/src/devname.rs
msgid "the saved name is empty: refused"
msgstr "tallennettu nimi on tyhjä: hylätty"

#: apihub-app/akm-core/src/devname.rs
msgid "the fragments do not spell the saved name"
msgstr "fragmentit eivät muodosta tallennettua nimeä"

#: apihub-app/akm-core/src/devname.rs apihub-app/crates/akmctl/src/forget.rs
msgid "keyboard not connected"
msgstr "näppäimistö ei ole yhdistetty"

#: apihub-app/akm-core/src/devname.rs
msgid "battery below 20 % and state not 'normal' (or unknown)"
msgstr "paristo alle 20 % ja tila ei ole ”normal” (tai tuntematon)"

#: apihub-app/akm-core/src/devname.rs apihub-app/crates/akmctl/src/forget.rs
msgid "circuit breaker open: the keyboard stopped answering"
msgstr "katkaisin auki: näppäimistö lakkasi vastaamasta"

#: apihub-app/akm-core/src/devname.rs
msgid "the last hardware read failed or was incomplete"
msgstr "viimeisin laitteistoluku epäonnistui tai jäi vajaaksi"

#: apihub-app/akm-core/src/devname.rs
msgid "`akmctl doctor` is not green (link health, pairing, configuration)"
msgstr "`akmctl doctor` ei ole vihreä (yhteyden kunto, paritus, asetukset)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel unknown: it must be read (akm-"
"helper hid-inspect, read-only) and be >= {min} before a 66-byte frame is sent"
msgstr ""
"L2CAP-ohjauskanavan lähtevä MTU tuntematon: se on luettava (akm-helper hid-"
"inspect, vain luku) ja sen on oltava >= {min} ennen 66-tavuisen kehyksen "
"lähettämistä"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel is {m}, below {min}: a 66-byte "
"frame cannot be sent in one piece (Linux hidp does not fragment; the HID "
"session would be terminated)"
msgstr ""
"L2CAP-ohjauskanavan lähtevä MTU on {m}, alle {min}: 66-tavuista kehystä ei "
"voi lähettää yhtenä palana (Linuxin hidp ei pilko; HID-istunto katkeaisi)"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - up to date (latest public version known)"
msgstr "Laiteohjelmisto: {v} - ajan tasalla (uusin tunnettu julkinen versio)"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - update available from Apple (latest known: {l})"
msgstr ""
"Laiteohjelmisto: {v} - Applelta on saatavilla päivitys (uusin tunnettu: {l})"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - no public Apple update for this model"
msgstr "Laiteohjelmisto: {v} - tälle mallille ei ole julkista Apple-päivitystä"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - unknown (model or version not in the table)"
msgstr ""
"Laiteohjelmisto: {v} - tuntematon (mallia tai versiota ei ole taulukossa)"


#: apihub-app/akm-core/src/advice.rs
#, rust-format
msgid "Batteries replaced too often: {first} d then {second} d (under 30 d)"
msgstr ""
"Paristot vaihdetaan liian usein: {first} pv ja sitten {second} pv (alle "
"30 pv)"

#: apihub-app/akm-core/src/advice.rs
msgid ""
"Check the declared chemistry ([battery] chemistry), try fresh cells of "
"another batch or low self-discharge NiMH cells, and switch the keyboard off "
"when it is not used."
msgstr ""
"Tarkista ilmoitettu kemia ([battery] chemistry), kokeile uusia kennoja "
"toisesta erästä tai vähän itsepurkautuvia NiMH-kennoja ja sammuta "
"näppäimistö, kun sitä ei käytetä."

#: apihub-app/akm-core/src/alias.rs
#, rust-format
msgid "name too long (max {max_chars} characters, {max_bytes} bytes)"
msgstr "nimi on liian pitkä (enintään {max_chars} merkkiä, {max_bytes} tavua)"

#: apihub-app/akm-core/src/alias.rs
msgid "name must not start with '-'"
msgstr "nimi ei saa alkaa merkillä '-'"

#: apihub-app/akm-core/src/alias.rs
#, rust-format
msgid "name contains a forbidden character (U+{code})"
msgstr "nimessä on kielletty merkki (U+{code})"

#: apihub-app/akm-core/src/batteries.rs
msgid "no battery history"
msgstr "ei paristohistoriaa"

#: apihub-app/akm-core/src/batteries.rs
msgid "#  installed            days   from  ->  to    state"
msgstr "#  asennettu            päiviä alku  ->  loppu tila"

#: apihub-app/akm-core/src/batteries.rs
msgid "replaced"
msgstr "vaihdettu"

#: apihub-app/akm-core/src/batteries.rs
msgid "in use"
msgstr "käytössä"

#: apihub-app/akm-core/src/batteries.rs
#, rust-format
msgid "Keyboard {mac}:"
msgstr "Näppäimistö {mac}:"

#: apihub-app/akm-core/src/batteries.rs
msgid "Samples recorded without a keyboard address:"
msgstr "Ilman näppäimistön osoitetta tallennetut mittaukset:"

#: apihub-app/akm-core/src/devname.rs
msgid "empty name"
msgstr "tyhjä nimi"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "{n} characters, at most {max} (what 0x51-0x54 can show back)"
msgstr ""
"{n} merkkiä, enintään {max} (sen verran kuin 0x51-0x54 voivat palauttaa)"


#: apihub-app/crates/akmctl/src/cli_i18n.rs
msgid "Commands"
msgstr "Befehle"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Control and query the Apple keyboard monitor"
msgstr "Apple-Tastaturmonitor steuern und abfragen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Control and query the Apple keyboard monitor (apple-kb-monitord).\n"
"\n"
"The Fn mode is a parameter of the hid_apple kernel module: it applies to ALL "
"Apple keyboards connected to this computer, not to a single one. Changing it "
"requires administrator rights (polkit authentication)."
msgstr ""
"Apple-Tastaturmonitor (apple-kb-monitord) steuern und abfragen.\n"
"\n"
"Der Fn-Modus ist ein Parameter des Kernelmoduls hid_apple: Er gilt für ALLE "
"an diesen Computer angeschlossenen Apple-Tastaturen, nicht nur für eine. Zum "
"Ändern sind Administratorrechte nötig (polkit-Authentifizierung)."

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"EXIT CODES:\n"
"  0   success\n"
"  1   error (D-Bus failure, write refused, bad data)\n"
"  2   daemon absent (apple-kb-monitord not on the session bus)\n"
"  64  usage error (invalid arguments)\n"
"\n"
"FN MODES (hid_apple.fnmode, global to every Apple keyboard):\n"
"  0  disabled   Fn key has no effect\n"
"  1  fkeyslast  media keys by default, Fn+Fx = F-key\n"
"  2  fkeysfirst F-keys by default, Fn+Fx = media key\n"
"  3  auto       kernel default: = 1 on an Apple keyboard\n"
"  4  fkeysdisabled F-keys disabled (media keys only)"
msgstr ""
"EXIT-CODES:\n"
"  0   Erfolg\n"
"  1   Fehler (D-Bus-Fehler, Schreiben verweigert, ungültige Daten)\n"
"  2   Dienst fehlt (apple-kb-monitord nicht auf dem Sitzungsbus)\n"
"  64  Aufruffehler (ungültige Argumente)\n"
"\n"
"FN-MODI (hid_apple.fnmode, global für alle Apple-Tastaturen):\n"
"  0  disabled   Fn-Taste ohne Wirkung\n"
"  1  fkeyslast  standardmäßig Medientasten, Fn+Fx = F-Taste\n"
"  2  fkeysfirst standardmäßig F-Tasten, Fn+Fx = Medientaste\n"
"  3  auto       Kernel-Standard: = 1 bei einer Apple-Tastatur\n"
"  4  fkeysdisabled F-Tasten deaktiviert (nur Medientasten)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print help (see more with '--help')"
msgstr "Hilfe anzeigen (mehr mit '--help')"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print help (see a summary with '-h')"
msgstr "Hilfe anzeigen (Zusammenfassung mit '-h')"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print version"
msgstr "Version anzeigen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Show keyboard state (battery, connection, RSSI, Fn mode)"
msgstr "Tastaturzustand anzeigen (Batterie, Verbindung, RSSI, Fn-Modus)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Machine-readable JSON (schema 1) on a single line"
msgstr "Maschinenlesbares JSON (Schema 1) in einer einzigen Zeile"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print help"
msgstr "Hilfe anzeigen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Read a setting"
msgstr "Eine Einstellung lesen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Current Fn mode (0-4), read from /sys/module/hid_apple/parameters/fnmode"
msgstr ""
"Aktueller Fn-Modus (0-4), gelesen aus /sys/module/hid_apple/parameters/fnmode"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "hid_apple parameters (all of them, or one)"
msgstr "hid_apple-Parameter (alle oder einer)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print this message or the help of the given subcommand(s)"
msgstr "Diese Meldung oder die Hilfe der angegebenen Unterbefehle anzeigen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Change a setting (administrator authentication required)"
msgstr "Eine Einstellung ändern (Administrator-Authentifizierung erforderlich)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Set the Fn mode of hid_apple (0-4). Global to ALL Apple keyboards; asks for "
"administrator authentication through polkit (pkexec akm-helper)"
msgstr ""
"Fn-Modus von hid_apple setzen (0-4). Global für ALLE Apple-Tastaturen; "
"fordert eine Administrator-Authentifizierung über polkit an (pkexec akm-"
"helper)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "0 disabled, 1 fkeyslast, 2 fkeysfirst, 3 auto, 4 fkeysdisabled"
msgstr "0 disabled, 1 fkeyslast, 2 fkeysfirst, 3 auto, 4 fkeysdisabled"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Also write it to /etc/modprobe.d/hid_apple.conf so it survives reboots"
msgstr ""
"Auch in /etc/modprobe.d/hid_apple.conf schreiben, damit es Neustarts "
"übersteht"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Set a hid_apple parameter (fnmode 0-4, iso_layout -1..1, swap_opt_cmd 0-2, "
"swap_ctrl_cmd 0-1, swap_fn_leftctrl 0-1). Global to ALL Apple keyboards"
msgstr ""
"Einen hid_apple-Parameter setzen (fnmode 0-4, iso_layout -1..1, swap_opt_cmd "
"0-2, swap_ctrl_cmd 0-1, swap_fn_leftctrl 0-1). Global für ALLE Apple-"
"Tastaturen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Also write it to /etc/modprobe.d/hid_apple.conf"
msgstr "Auch in /etc/modprobe.d/hid_apple.conf schreiben"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Rename the keyboard on this computer (BlueZ alias; nothing is written into "
"the keyboard). With --device-name: the name stored IN the keyboard"
msgstr ""
"Tastatur auf diesem Computer umbenennen (BlueZ-Alias; nichts wird in die "
"Tastatur geschrieben). Mit --device-name: der IN der Tastatur gespeicherte "
"Name"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"TWO NAMES:\n"
"  akmctl rename <name>                 alias of THIS computer (BlueZ Alias): "
"nothing written into the keyboard\n"
"  akmctl rename --device-name <name>   WRITES the name stored IN the "
"keyboard (seen by every host):\n"
"                                       pre-flight, backup of the current "
"name, ONE confirmation [y/N]\n"
"                                       (--yes skips it and works without a "
"terminal), one write, immediate\n"
"                                       read-back, verdict. No password in "
"the active local session.\n"
"                                       --check: whole pre-flight and backup, "
"nothing written, nothing asked\n"
"                                       --dry-run: shows the bytes, no "
"pkexec, nothing written\n"
"                                       --verbose: frames, wire bytes, proof, "
"[devname] journal\n"
"  akmctl rename --device-name --show   name stored in the keyboard, from the "
"daemon's cache\n"
"  akmctl rename --device-name --restore <backup.json> [--yes]   write a "
"backup back (same flow)\n"
"Exit codes of --device-name: 0 written and read back identical (or --check "
"green), 10 no terminal and\n"
"no --yes, 11 pre-flight refused, 12 cancelled, 13 written but not read back "
"(check with --show),\n"
"14 read back different (rollback command printed), 15 write uncertain (the "
"write failed on its way:\n"
"a frame may have been sent, check with --show). Persistence across a battery "
"change is not measured\n"
"(docs/RENAME-KEYBOARD.md)."
msgstr ""
"ZWEI NAMEN:\n"
"  akmctl rename <name>                 Alias DIESES Computers (BlueZ Alias): "
"nichts wird in die Tastatur geschrieben\n"
"  akmctl rename --device-name <name>   SCHREIBT den IN der Tastatur "
"gespeicherten Namen (für jeden Host sichtbar):\n"
"                                       Vorabprüfung, Sicherung des aktuellen "
"Namens, EINE Bestätigung [y/N]\n"
"                                       (--yes überspringt sie und "
"funktioniert ohne Terminal), ein Schreibvorgang,\n"
"                                       sofortiges Zurücklesen, Ergebnis. "
"Kein Passwort in der aktiven lokalen Sitzung.\n"
"                                       --check: komplette Vorabprüfung und "
"Sicherung, nichts geschrieben, nichts gefragt\n"
"                                       --dry-run: zeigt die Bytes, kein "
"pkexec, nichts geschrieben\n"
"                                       --verbose: Frames, Bytes auf der "
"Leitung, Nachweis, Journal [devname]\n"
"  akmctl rename --device-name --show   in der Tastatur gespeicherter Name, "
"aus dem Cache des Dienstes\n"
"  akmctl rename --device-name --restore <backup.json> [--yes]   eine "
"Sicherung zurückschreiben (gleicher Ablauf)\n"
"Exit-Codes von --device-name: 0 geschrieben und identisch zurückgelesen "
"(oder --check grün), 10 kein Terminal und\n"
"kein --yes, 11 Vorabprüfung verweigert, 12 abgebrochen, 13 geschrieben, aber "
"nicht zurückgelesen (mit --show prüfen),\n"
"14 abweichend zurückgelesen (Rückgängig-Befehl ausgegeben), 15 Schreiben "
"unsicher (das Schreiben schlug unterwegs fehl:\n"
"ein Frame wurde eventuell gesendet, mit --show prüfen). Die Beständigkeit "
"über einen Batteriewechsel ist nicht gemessen\n"
"(docs/RENAME-KEYBOARD.md)."

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "New alias (max 64 characters, no control characters)"
msgstr "Neuer Alias (max. 64 Zeichen, keine Steuerzeichen)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Restore the keyboard's own name"
msgstr "Eigenen Namen der Tastatur wiederherstellen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keyboard to rename (default: the one the daemon reports)"
msgstr "Umzubenennende Tastatur (Standard: die vom Dienst gemeldete)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Write the name stored IN the keyboard (printable ASCII, 1-32 characters); "
"without a value: with --show or --restore"
msgstr ""
"Den IN der Tastatur gespeicherten Namen schreiben (druckbares ASCII, 1-32 "
"Zeichen); ohne Wert: mit --show oder --restore"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Do not ask the confirmation (works without a terminal)"
msgstr "Nicht nach Bestätigung fragen (funktioniert ohne Terminal)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Show the bytes that would be sent, write nothing, no pkexec"
msgstr "Die zu sendenden Bytes anzeigen, nichts schreiben, kein pkexec"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Whole pre-flight (control-channel MTU read via ONE pkexec, read-only) and "
"backup; nothing written, nothing asked"
msgstr ""
"Komplette Vorabprüfung (MTU des Steuerkanals über EIN pkexec gelesen, nur "
"lesend) und Sicherung; nichts geschrieben, nichts gefragt"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Accepted for compatibility, no effect: --device-name writes by default"
msgstr ""
"Aus Kompatibilitätsgründen akzeptiert, ohne Wirkung: --device-name schreibt "
"standardmäßig"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Show the name stored in the keyboard (daemon cache, no hardware read)"
msgstr ""
"Den in der Tastatur gespeicherten Namen anzeigen (Cache des Dienstes, kein "
"Hardwarezugriff)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Write back a backup made by a previous --device-name run"
msgstr ""
"Eine bei einem früheren --device-name-Lauf erstellte Sicherung "
"zurückschreiben"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Byte-by-byte detail (frames, wire, proof, [devname] journal)"
msgstr "Byte-genaue Details (Frames, Leitung, Nachweis, Journal [devname])"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Follow StateChanged signals: one JSON line per change, until interrupted"
msgstr ""
"StateChanged-Signale verfolgen: eine JSON-Zeile pro Änderung, bis zur "
"Unterbrechung"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Battery history (single store: $XDG_STATE_HOME/apple-kb-monitor/"
"history.jsonl)"
msgstr ""
"Batterieverlauf (einziger Speicher: $XDG_STATE_HOME/apple-kb-monitor/"
"history.jsonl)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Oldest entry: 90m, 24h, 7d, 2w, YYYY-MM-DD or \"YYYY-MM-DD HH:MM\" (UTC)"
msgstr ""
"Ältester Eintrag: 90m, 24h, 7d, 2w, YYYY-MM-DD oder \"YYYY-MM-DD HH:MM\" "
"(UTC)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Newest entry (same formats)"
msgstr "Neuester Eintrag (gleiche Formate)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keep only the last N entries"
msgstr "Nur die letzten N Einträge behalten"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "JSON array on one line instead of the table"
msgstr "JSON-Array in einer Zeile statt der Tabelle"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Export the history on stdout"
msgstr "Den Verlauf auf stdout exportieren"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "CSV format (the only one; header included)"
msgstr "CSV-Format (das einzige; mit Kopfzeile)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Import a history file of the former Python CLI into the single store. The "
"source is not modified; existing lines are not duplicated"
msgstr ""
"Eine Verlaufsdatei der früheren Python-CLI in den einzigen Speicher "
"importieren. Die Quelle wird nicht verändert; vorhandene Zeilen werden nicht "
"dupliziert"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "File to import (history.jsonl of the Python CLI)"
msgstr "Zu importierende Datei (history.jsonl der Python-CLI)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Terminal chart of the battery (percentage and voltage) over 24 h or 7 days"
msgstr ""
"Terminal-Diagramm der Batterie (Prozent und Spannung) über 24 h oder 7 Tage"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Time window"
msgstr "Zeitfenster"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"JSON for a waybar/polybar custom module (classes: good, warning, critical, "
"disconnected)"
msgstr ""
"JSON für ein benutzerdefiniertes waybar/polybar-Modul (Klassen: good, "
"warning, critical, disconnected)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Prometheus text exposition of the keyboard state (one page)"
msgstr "Prometheus-Textausgabe des Tastaturzustands (eine Seite)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Switch a keyboard LED (NumLock can only be switched off)"
msgstr "Eine Tastatur-LED schalten (NumLock kann nur ausgeschaltet werden)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Ask the daemon to send WillShutdown (Feature 0x40, id only) to the keyboard, "
"as macOS does at shutdown: once, only if connected and `[apple] "
"will_shutdown` is on. Run by the shutdown unit"
msgstr ""
"Den Dienst bitten, WillShutdown (Feature 0x40, nur ID) an die Tastatur zu "
"senden, wie macOS beim Herunterfahren: einmal, nur wenn verbunden und "
"`[apple] will_shutdown` aktiv ist. Wird von der Shutdown-Unit ausgeführt"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Do nothing unless the system is shutting down or restarting (`systemctl is-"
"system-running` = stopping): used by the unit, so that a logout or a service "
"restart never sends it"
msgstr ""
"Nichts tun, außer das System fährt herunter oder startet neu (`systemctl is-"
"system-running` = stopping): von der Unit verwendet, damit eine Abmeldung "
"oder ein Dienstneustart es nie sendet"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Send HID_CONTROL SUSPEND (0x13) or EXIT_SUSPEND (0x14) to the connected "
"Apple keyboards, as macOS bluetoothd does at sleep and wake: one byte on the "
"HID control channel of bluetoothd, administrator authentication. The system "
"units send it by themselves at every sleep/wake; this is the manual test. --"
"dry-run writes nothing"
msgstr ""
"HID_CONTROL SUSPEND (0x13) oder EXIT_SUSPEND (0x14) an die verbundenen Apple-"
"Tastaturen senden, wie macOS bluetoothd beim Ruhezustand und Aufwachen: ein "
"Byte auf dem HID-Steuerkanal von bluetoothd, Administrator-"
"Authentifizierung. Die System-Units senden es bei jedem Ruhezustand/"
"Aufwachen selbst; dies ist der manuelle Test. --dry-run schreibt nichts"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"suspend: HID_CONTROL SUSPEND, byte 0x13 (what the suspend unit sends before "
"sleep); exit-suspend: HID_CONTROL EXIT_SUSPEND, byte 0x14 (what the resume "
"unit sends at wake)"
msgstr ""
"suspend: HID_CONTROL SUSPEND, Byte 0x13 (was die Suspend-Unit vor dem "
"Ruhezustand sendet); exit-suspend: HID_CONTROL EXIT_SUSPEND, Byte 0x14 (was "
"die Resume-Unit beim Aufwachen sendet)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Only this keyboard (must be a connected Apple keyboard)"
msgstr "Nur diese Tastatur (muss eine verbundene Apple-Tastatur sein)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Show the bluetoothd socket that would be used (pid, fd, MAC, PSM, state) and "
"send nothing"
msgstr ""
"Den zu verwendenden bluetoothd-Socket anzeigen (pid, fd, MAC, PSM, Zustand) "
"und nichts senden"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Register map of the keyboard (every known HID report: name, size, safety "
"class) with the values the daemon has cached, \"never read\" otherwise. "
"Never reads the keyboard"
msgstr ""
"Registerkarte der Tastatur (jeder bekannte HID-Report: Name, Größe, "
"Sicherheitsklasse) mit den vom Dienst zwischengespeicherten Werten, sonst "
"\"nie gelesen\". Liest die Tastatur nie"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Machine-readable JSON"
msgstr "Maschinenlesbares JSON"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Firmware version of the keyboard against the embedded table of Apple's "
"public firmware updates, where one exists (read once per connection by the "
"daemon; no network, never flashes)"
msgstr ""
"Firmware-Version der Tastatur im Vergleich zur eingebetteten Tabelle der "
"öffentlichen Firmware-Updates von Apple, sofern vorhanden (vom Dienst einmal "
"pro Verbindung gelesen; kein Netzwerk, flasht nie)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Read the 3 allowed HID reports (0x47, 0x46, 0x49) with the safe read policy: "
"no scan, never 0x4C / 0xFE / 0x01. Press a key first (an idle keyboard is "
"left alone)"
msgstr ""
"Die 3 erlaubten HID-Reports (0x47, 0x46, 0x49) mit der sicheren Lese-"
"Richtlinie lesen: kein Scan, nie 0x4C / 0xFE / 0x01. Zuerst eine Taste "
"drücken (eine ruhende Tastatur bleibt unberührt)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Diagnose the Bluetooth link in one command (BlueZ, pairing, adapter power "
"management, BlueZ/UPower configuration, journal, hidraw, daemon). Read-only "
"unless --fix; run with sudo to also compare the stored and kernel link keys"
msgstr ""
"Die Bluetooth-Verbindung mit einem Befehl diagnostizieren (BlueZ, Kopplung, "
"Energieverwaltung des Adapters, BlueZ/UPower-Konfiguration, Journal, hidraw, "
"Dienst). Nur lesend außer mit --fix; mit sudo ausführen, um auch die "
"gespeicherten und Kernel-Verbindungsschlüssel zu vergleichen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keyboard to check (default: the paired one)"
msgstr "Zu prüfende Tastatur (Standard: die gekoppelte)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Apply the corrections of the system files the diagnostic proposes (BlueZ "
"main.conf, udev rule of the adapter), through the privileged helper: one "
"administrator authentication, the previous file kept as <name>.akm-bak"
msgstr ""
"Die von der Diagnose vorgeschlagenen Korrekturen der Systemdateien anwenden "
"(BlueZ main.conf, udev-Regel des Adapters), über das privilegierte "
"Hilfsprogramm: eine Administrator-Authentifizierung, die vorherige Datei "
"wird als <name>.akm-bak behalten"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "With --fix: show what would change, write nothing (no password)"
msgstr ""
"Mit --fix: anzeigen, was sich ändern würde, nichts schreiben (kein Passwort)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"With --fix: also restart bluetooth / upower so the corrected file is read "
"now (drops every Bluetooth link for a few seconds)"
msgstr ""
"Mit --fix: auch bluetooth / upower neu starten, damit die korrigierte Datei "
"sofort gelesen wird (trennt alle Bluetooth-Verbindungen für einige Sekunden)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "With --fix: also apply the corrections marked \"optional\" (UPower)"
msgstr ""
"Mit --fix: auch die als \"optional\" markierten Korrekturen anwenden (UPower)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Guided repair of the link: wake + reconnect first; re-pair only after a "
"typed confirmation (the pairing is never removed otherwise)"
msgstr ""
"Geführte Reparatur der Verbindung: zuerst Aufwecken + Neuverbinden; erneutes "
"Koppeln nur nach einer eingetippten Bestätigung (die Kopplung wird sonst nie "
"entfernt)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keyboard to repair (default: the paired one)"
msgstr "Zu reparierende Tastatur (Standard: die gekoppelte)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Offer re-pairing even if the link looks healthy"
msgstr "Erneutes Koppeln anbieten, auch wenn die Verbindung gesund aussieht"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Effective table of the special keys (F1-F12, Eject; --all: every known key): "
"physical key -> evdev code (after hwdb and hid_apple, per fnmode) -> keysym "
"-> KDE global shortcut. Never reads a key press, except with --live"
msgstr ""
"Effektive Tabelle der Sondertasten (F1-F12, Eject; --all: alle bekannten "
"Tasten): physische Taste -> evdev-Code (nach hwdb und hid_apple, je nach "
"fnmode) -> Keysym -> globales KDE-Kürzel. Liest nie einen Tastendruck, außer "
"mit --live"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Verdict per key ([ok] = a KDE shortcut is bound) and what to test"
msgstr ""
"Ergebnis pro Taste ([ok] = ein KDE-Kürzel ist zugewiesen) und was zu testen "
"ist"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "All known keys (modifiers, arrows, Fn...), not only the top row"
msgstr ""
"Alle bekannten Tasten (Modifikatoren, Pfeile, Fn ...), nicht nur die obere "
"Reihe"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Machine-readable JSON (with the KDE actions)"
msgstr "Maschinenlesbares JSON (mit den KDE-Aktionen)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Live view of the key events of the Apple keyboard instead of the table: HID "
"usage, evdev code, name, one line per press and release. Reads the evdev "
"node (read-only, group \"input\"), records nothing. Leave with Escape held 2 "
"s, or Ctrl-C"
msgstr ""
"Live-Ansicht der Tastenereignisse der Apple-Tastatur statt der Tabelle: HID-"
"Usage, evdev-Code, Name, eine Zeile pro Drücken und Loslassen. Liest den "
"evdev-Knoten (nur lesend, Gruppe \"input\"), zeichnet nichts auf. Beenden "
"durch 2 s Halten von Escape oder Ctrl-C"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Manual key mapping without keyd ($XDG_CONFIG_HOME/apple-kb-monitor/"
"keymap.toml -> udev hwdb, installed with administrator authentication)"
msgstr ""
"Manuelle Tastenbelegung ohne keyd ($XDG_CONFIG_HOME/apple-kb-monitor/"
"keymap.toml -> udev-hwdb, mit Administrator-Authentifizierung installiert)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Show the profiles of keymap.toml (--hwdb: the file `apply` would install)"
msgstr ""
"Die Profile von keymap.toml anzeigen (--hwdb: die Datei, die `apply` "
"installieren würde)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Remap a key: KEY = F1..F12, Eject, Fn, LeftCmd... or a HID usage (0x7003a); "
"CODE = a KEY_* name of linux/input-event-codes.h. Applied by `apply`"
msgstr ""
"Eine Taste umbelegen: KEY = F1..F12, Eject, Fn, LeftCmd ... oder eine HID-"
"Usage (0x7003a); CODE = ein KEY_*-Name aus linux/input-event-codes.h. "
"Angewendet durch `apply`"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Profile to edit (default: the active one)"
msgstr "Zu bearbeitendes Profil (Standard: das aktive)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Back to the kernel mapping for one key (in keymap.toml)"
msgstr "Für eine Taste zur Kernel-Belegung zurückkehren (in keymap.toml)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Preset of a profile (hid_apple parameters): apple (Apple legend, fnmode=1 "
"swap_opt_cmd=0), fkeys (F1-F12 first, fnmode=2), linux-pc (Cmd<->Alt, "
"swap_opt_cmd=1), none (parameters left as they are, the default)"
msgstr ""
"Vorgabe eines Profils (hid_apple-Parameter): apple (Apple-Beschriftung, "
"fnmode=1 swap_opt_cmd=0), fkeys (F1-F12 zuerst, fnmode=2), linux-pc (Cmd<-"
">Alt, swap_opt_cmd=1), none (Parameter bleiben unverändert, der Standard)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Select the active profile (created with the apple preset if new)"
msgstr ""
"Das aktive Profil wählen (bei Neuanlage mit der Vorgabe apple erstellt)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Install the active profile: udev hwdb (akm-helper install-keymap) and "
"hid_apple parameters (akm-helper, persistent, ALL Apple keyboards)"
msgstr ""
"Das aktive Profil installieren: udev-hwdb (akm-helper install-keymap) und "
"hid_apple-Parameter (akm-helper, dauerhaft, ALLE Apple-Tastaturen)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Show what would change, change nothing"
msgstr "Anzeigen, was sich ändern würde, nichts ändern"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Remove the installed hwdb (kernel mapping back at once) and clear the keys "
"of the active profile"
msgstr ""
"Die installierte hwdb entfernen (Kernel-Belegung sofort zurück) und die "
"Tasten des aktiven Profils leeren"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Restore the previously installed hwdb file"
msgstr "Die zuvor installierte hwdb-Datei wiederherstellen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Add the KDE shortcuts the Apple legend needs and KDE lacks (F4 = Launch (D) "
"-> application launcher), never replacing a binding"
msgstr ""
"Die KDE-Kürzel hinzufügen, die die Apple-Beschriftung braucht und KDE fehlen "
"(F4 = Launch (D) -> Anwendungsstarter), ohne je eine Zuweisung zu ersetzen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Remove exactly the keys kde-apply added"
msgstr "Genau die von kde-apply hinzugefügten Tasten entfernen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Health self-check (daemon, link, journal, crashes, disk), run by apple-kb-"
"monitor-selfcheck.timer"
msgstr ""
"Gesundheits-Selbsttest (Dienst, Verbindung, Journal, Abstürze, Festplatte), "
"ausgeführt von apple-kb-monitor-selfcheck.timer"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print the result as JSON (the same object as selfcheck.json)"
msgstr "Das Ergebnis als JSON ausgeben (dasselbe Objekt wie selfcheck.json)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Desktop notification for each NEW grave problem (deduplicated)"
msgstr "Desktop-Benachrichtigung für jedes NEUE schwere Problem (dedupliziert)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Also open one Gitea issue per new grave problem (deduplicated; needs "
"AKM_GITEA_API, AKM_GITEA_REPO and ~/.config/gitea/token). Off by default"
msgstr ""
"Zusätzlich ein Gitea-Issue pro neuem schweren Problem öffnen (dedupliziert; "
"benötigt AKM_GITEA_API, AKM_GITEA_REPO und ~/.config/gitea/token). "
"Standardmäßig aus"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Result file (default: $XDG_STATE_HOME/apple-kb-monitor/selfcheck.json)"
msgstr ""
"Ergebnisdatei (Standard: $XDG_STATE_HOME/apple-kb-monitor/selfcheck.json)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Do not write the result file (dry run)"
msgstr "Die Ergebnisdatei nicht schreiben (Probelauf)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print a shell completion script on stdout"
msgstr "Ein Shell-Vervollständigungsskript auf stdout ausgeben"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print the manual page (roff) on stdout"
msgstr "Die Handbuchseite (roff) auf stdout ausgeben"

#: apihub-app/crates/akmctl/src/devnamecmd.rs

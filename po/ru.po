#: apihub-app/akm-core/src/advice.rs
#, rust-format
msgid "Batteries replaced too often: {first} d then {second} d (under 30 d)"
msgstr ""
"Батарейки меняются слишком часто: {first} д, затем {second} д (меньше 30 д)"

#: apihub-app/akm-core/src/advice.rs
msgid ""
"Check the declared chemistry ([battery] chemistry), try fresh cells of "
"another batch or low self-discharge NiMH cells, and switch the keyboard off "
"when it is not used."
msgstr ""
"Проверьте указанную химию ([battery] chemistry), попробуйте свежие элементы "
"из другой партии или NiMH-элементы с низким саморазрядом и выключайте "
"клавиатуру, когда она не используется."

#: apihub-app/akm-core/src/alias.rs
#, rust-format
msgid "name too long (max {max_chars} characters, {max_bytes} bytes)"
msgstr "имя слишком длинное (не более {max_chars} символов, {max_bytes} байт)"

#: apihub-app/akm-core/src/alias.rs
msgid "name must not start with '-'"
msgstr "имя не должно начинаться с «-»"

#: apihub-app/akm-core/src/alias.rs
#, rust-format
msgid "name contains a forbidden character (U+{code})"
msgstr "имя содержит запрещённый символ (U+{code})"

#: apihub-app/akm-core/src/batteries.rs
msgid "no battery history"
msgstr "нет истории батареек"

#: apihub-app/akm-core/src/batteries.rs
msgid "#  installed            days   from  ->  to    state"
msgstr "#  установлены          дней   с     ->  до    состояние"

#: apihub-app/akm-core/src/batteries.rs
msgid "replaced"
msgstr "заменены"

#: apihub-app/akm-core/src/batteries.rs
msgid "in use"
msgstr "используются"

#: apihub-app/akm-core/src/batteries.rs
#, rust-format
msgid "Keyboard {mac}:"
msgstr "Клавиатура {mac}:"

#: apihub-app/akm-core/src/batteries.rs
msgid "Samples recorded without a keyboard address:"
msgstr "Замеры, записанные без адреса клавиатуры:"

#: apihub-app/akm-core/src/devname.rs
msgid "empty name"
msgstr "пустое имя"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "{n} characters, at most {max} (what 0x51-0x54 can show back)"
msgstr "{n} символов, не более {max} (столько могут вернуть 0x51-0x54)"

#: apihub-app/akm-core/src/devname.rs
msgid "leading or trailing space"
msgstr "пробел в начале или в конце"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "control character U+{code}"
msgstr "управляющий символ U+{code}"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "non-ASCII character {c} (the keyboard stores ASCII)"
msgstr "символ вне ASCII {c} (клавиатура хранит ASCII)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "character {c} refused (escape character of BlueZ's key file)"
msgstr "символ {c} отклонён (экранирующий символ файла ключей BlueZ)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "backup schema {schema} unknown"
msgstr "неизвестная схема копии {schema}"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "fragment {i} is not hex"
msgstr "фрагмент {i} не в шестнадцатеричном виде"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid "fragment {i} has {n} bytes, expected {expected}"
msgstr "во фрагменте {i} {n} байт, ожидалось {expected}"

#: apihub-app/akm-core/src/devname.rs
msgid "bytes after the NUL terminator: refused (not a name this tool restores)"
msgstr ""
"байты после завершающего NUL: отклонено (это не имя, которое восстанавливает "
"эта программа)"

#: apihub-app/akm-core/src/devname.rs
msgid "the saved name is empty: refused"
msgstr "сохранённое имя пустое: отклонено"

#: apihub-app/akm-core/src/devname.rs
msgid "the fragments do not spell the saved name"
msgstr "фрагменты не складываются в сохранённое имя"

#: apihub-app/akm-core/src/devname.rs apihub-app/crates/akmctl/src/forget.rs
msgid "keyboard not connected"
msgstr "клавиатура не подключена"

#: apihub-app/akm-core/src/devname.rs
msgid "battery below 20 % and state not 'normal' (or unknown)"
msgstr "заряд ниже 20 % и состояние не «normal» (или неизвестно)"

#: apihub-app/akm-core/src/devname.rs apihub-app/crates/akmctl/src/forget.rs
msgid "circuit breaker open: the keyboard stopped answering"
msgstr "предохранитель разомкнут: клавиатура перестала отвечать"

#: apihub-app/akm-core/src/devname.rs
msgid "the last hardware read failed or was incomplete"
msgstr "последнее чтение оборудования не удалось или было неполным"

#: apihub-app/akm-core/src/devname.rs
msgid "`akmctl doctor` is not green (link health, pairing, configuration)"
msgstr "`akmctl doctor` не зелёный (состояние связи, сопряжение, настройка)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel unknown: it must be read (akm-"
"helper hid-inspect, read-only) and be >= {min} before a 66-byte frame is sent"
msgstr ""
"исходящий MTU управляющего канала L2CAP неизвестен: его нужно прочитать (akm-"
"helper hid-inspect, только чтение), и он должен быть >= {min} до отправки 66-"
"байтового кадра"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel is {m}, below {min}: a 66-byte "
"frame cannot be sent in one piece (Linux hidp does not fragment; the HID "
"session would be terminated)"
msgstr ""
"исходящий MTU управляющего канала L2CAP равен {m}, меньше {min}: 66-байтовый "
"кадр нельзя отправить целиком (hidp в Linux не фрагментирует; сеанс HID был "
"бы разорван)"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - up to date (latest public version known)"
msgstr "Микропрограмма: {v} — актуальна (последняя известная публичная версия)"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - update available from Apple (latest known: {l})"
msgstr ""
"Микропрограмма: {v} — у Apple есть обновление (последняя известная: {l})"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - no public Apple update for this model"
msgstr "Микропрограмма: {v} — для этой модели нет публичных обновлений Apple"

#: apihub-app/akm-core/src/firmware.rs
#, rust-format
msgid "Firmware: {v} - unknown (model or version not in the table)"
msgstr "Микропрограмма: {v} — неизвестно (модели или версии нет в таблице)"


msgstr "fkeyslast (по умолчанию медиаклавиши, Fn+Fx = F-клавиша)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "F1–F12 first"
msgstr "Сначала F1–F12"

#: apihub-app/akm-core/src/hid_params.rs
msgid "fkeysfirst (F-keys by default, Fn+Fx = media key)"
msgstr "fkeysfirst (по умолчанию F-клавиши, Fn+Fx = медиаклавиша)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "media keys first (auto)"
msgstr "сначала медиаклавиши (авто)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "auto (media keys by default on Apple keyboards, Fn+Fx = F-key)"
msgstr ""
"авто (на клавиатурах Apple по умолчанию мультимедийные клавиши, Fn+Fx = "
"клавиша F)"

#: apihub-app/akm-core/src/hid_params.rs
msgid "F-keys disabled"
msgstr "клавиши F отключены"

#: apihub-app/akm-core/src/hid_params.rs
msgid "fkeysdisabled (F-keys disabled, media keys only)"
msgstr "fkeysdisabled (клавиши F отключены, только мультимедийные клавиши)"


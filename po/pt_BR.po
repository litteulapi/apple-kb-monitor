#: apihub-app/akm-core/src/advice.rs
#, rust-format
msgid "Batteries replaced too often: {first} d then {second} d (under 30 d)"
msgstr ""
"Pilhas substituídas com demasiada frequência: {first} d e depois {second} d "
"(menos de 30 d)"

#: apihub-app/akm-core/src/advice.rs
msgid ""
"Check the declared chemistry ([battery] chemistry), try fresh cells of "
"another batch or low self-discharge NiMH cells, and switch the keyboard off "
"when it is not used."
msgstr ""
"Verifique a química declarada ([battery] chemistry), experimente pilhas "
"novas de outro lote ou pilhas NiMH de baixa autodescarga e desligue o "
"teclado quando ele não estiver em uso."

#: apihub-app/akm-core/src/alias.rs
#, rust-format
msgid "name too long (max {max_chars} characters, {max_bytes} bytes)"
msgstr ""
"nome longo demais (máximo de {max_chars} caracteres, {max_bytes} bytes)"

#: apihub-app/akm-core/src/alias.rs
msgid "name must not start with '-'"
msgstr "o nome não pode começar com '-'"

#: apihub-app/akm-core/src/alias.rs
#, rust-format
msgid "name contains a forbidden character (U+{code})"
msgstr "o nome contém um caractere proibido (U+{code})"


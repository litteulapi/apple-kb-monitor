msgid ""
"EXIT CODES:\n"
"  0   success\n"
"  1   error (D-Bus failure, write refused, bad data)\n"
"  2   daemon absent (apple-kb-monitord not on the session bus)\n"
"  64  usage error (invalid arguments)\n"
"\n"
"FN MODES (hid_apple.fnmode, global to every Apple keyboard):\n"
"  0  disabled   Fn key has no effect\n"
"  1  fkeyslast  media keys by default, Fn+Fx = F-key\n"
"  2  fkeysfirst F-keys by default, Fn+Fx = media key\n"
"  3  auto       kernel default: = 1 on an Apple keyboard\n"
"  4  fkeysdisabled F-keys disabled (media keys only)"
msgstr ""
"CÓDIGOS DE SAÍDA:\n"
"  0   sucesso\n"
"  1   erro (falha de D-Bus, escrita recusada, dados inválidos)\n"
"  2   serviço ausente (apple-kb-monitord não está no barramento de sessão)\n"
"  64  erro de uso (argumentos inválidos)\n"
"\n"
"MODOS FN (hid_apple.fnmode, global a todos os teclados Apple):\n"
"  0  disabled   a tecla Fn não tem efeito\n"
"  1  fkeyslast  teclas de mídia por padrão, Fn+Fx = tecla F\n"
"  2  fkeysfirst teclas F por padrão, Fn+Fx = tecla de mídia\n"
"  3  auto       padrão do kernel: = 1 em um teclado Apple\n"
"  4  fkeysdisabled teclas F desativadas (só teclas de mídia)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print help (see more with '--help')"
msgstr "Mostrar a ajuda (mais com '--help')"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print help (see a summary with '-h')"
msgstr "Mostrar a ajuda (um resumo com '-h')"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print version"
msgstr "Mostrar a versão"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Show keyboard state (battery, connection, RSSI, Fn mode)"
msgstr "Mostrar o estado do teclado (pilha, conexão, RSSI, modo Fn)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Machine-readable JSON (schema 1) on a single line"
msgstr "JSON legível por máquina (esquema 1) em uma só linha"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print help"
msgstr "Mostrar a ajuda"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Read a setting"
msgstr "Ler uma configuração"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Current Fn mode (0-4), read from /sys/module/hid_apple/parameters/fnmode"
msgstr "Modo Fn atual (0-4), lido de /sys/module/hid_apple/parameters/fnmode"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "hid_apple parameters (all of them, or one)"
msgstr "Parâmetros de hid_apple (todos, ou um)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print this message or the help of the given subcommand(s)"
msgstr "Mostrar esta mensagem ou a ajuda dos subcomandos indicados"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Change a setting (administrator authentication required)"
msgstr "Alterar uma configuração (autenticação de administrador necessária)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Set the Fn mode of hid_apple (0-4). Global to ALL Apple keyboards; asks for "
"administrator authentication through polkit (pkexec akm-helper)"
msgstr ""
"Definir o modo Fn de hid_apple (0-4). Global a TODOS os teclados Apple; pede "
"autenticação de administrador através do polkit (pkexec akm-helper)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "0 disabled, 1 fkeyslast, 2 fkeysfirst, 3 auto, 4 fkeysdisabled"
msgstr "0 disabled, 1 fkeyslast, 2 fkeysfirst, 3 auto, 4 fkeysdisabled"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Also write it to /etc/modprobe.d/hid_apple.conf so it survives reboots"
msgstr ""
"Escrevê-lo também em /etc/modprobe.d/hid_apple.conf para que sobreviva aos "
"reinícios"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Set a hid_apple parameter (fnmode 0-4, iso_layout -1..1, swap_opt_cmd 0-2, "
"swap_ctrl_cmd 0-1, swap_fn_leftctrl 0-1). Global to ALL Apple keyboards"
msgstr ""
"Definir um parâmetro de hid_apple (fnmode 0-4, iso_layout -1..1, "
"swap_opt_cmd 0-2, swap_ctrl_cmd 0-1, swap_fn_leftctrl 0-1). Global a TODOS "
"os teclados Apple"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Also write it to /etc/modprobe.d/hid_apple.conf"
msgstr "Escrevê-lo também em /etc/modprobe.d/hid_apple.conf"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Rename the keyboard on this computer (BlueZ alias; nothing is written into "
"the keyboard). With --device-name: the name stored IN the keyboard"
msgstr ""
"Renomear do teclado neste computador (alias do BlueZ; nada é escrito no "
"teclado). Com --device-name: o nome guardado NO teclado"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"TWO NAMES:\n"
"  akmctl rename <name>                 alias of THIS computer (BlueZ Alias): "
"nothing written into the keyboard\n"
"  akmctl rename --device-name <name>   WRITES the name stored IN the "
"keyboard (seen by every host):\n"
"                                       pre-flight, backup of the current "
"name, ONE confirmation [y/N]\n"
"                                       (--yes skips it and works without a "
"terminal), one write, immediate\n"
"                                       read-back, verdict. No password in "
"the active local session.\n"
"                                       --check: whole pre-flight and backup, "
"nothing written, nothing asked\n"
"                                       --dry-run: shows the bytes, no "
"pkexec, nothing written\n"
"                                       --verbose: frames, wire bytes, proof, "
"[devname] journal\n"
"  akmctl rename --device-name --show   name stored in the keyboard, from the "
"daemon's cache\n"
"  akmctl rename --device-name --restore <backup.json> [--yes]   write a "
"backup back (same flow)\n"
"Exit codes of --device-name: 0 written and read back identical (or --check "
"green), 10 no terminal and\n"
"no --yes, 11 pre-flight refused, 12 cancelled, 13 written but not read back "
"(check with --show),\n"
"14 read back different (rollback command printed), 15 write uncertain (the "
"write failed on its way:\n"
"a frame may have been sent, check with --show). Persistence across a battery "
"change is not measured\n"
"(docs/RENAME-KEYBOARD.md)."
msgstr ""
"DOIS NOMES:\n"
"  akmctl rename <name>                 alias DESTE computador (BlueZ Alias): "
"nada é escrito no teclado\n"
"  akmctl rename --device-name <name>   ESCREVE o nome guardado NO teclado "
"(visto por todos os hosts):\n"
"                                       verificação prévia, cópia do nome "
"atual, UMA confirmação [y/N]\n"
"                                       (--yes a pula e funciona sem "
"terminal), uma escrita, releitura\n"
"                                       imediata, veredicto. Sem senha na "
"sessão local ativa.\n"
"                                       --check: verificação prévia completa "
"e cópia, nada escrito, nada perguntado\n"
"                                       --dry-run: mostra os bytes, sem "
"pkexec, nada escrito\n"
"                                       --verbose: quadros, bytes no link, "
"prova, log [devname]\n"
"  akmctl rename --device-name --show   nome guardado no teclado, a partir da "
"cache do serviço\n"
"  akmctl rename --device-name --restore <backup.json> [--yes]   reescrever "
"uma cópia (mesmo fluxo)\n"
"Códigos de saída de --device-name: 0 escrito e relido idêntico (ou --check "
"verde), 10 sem terminal e\n"
"sem --yes, 11 verificação prévia recusada, 12 cancelado, 13 escrito mas não "
"relido (verifique com --show),\n"
"14 relido diferente (comando de reversão mostrado), 15 escrita incerta (a "
"escrita falhou pelo caminho:\n"
"pode ter sido enviada uma quadro, verifique com --show). A persistência após "
"uma troca de pilhas não está medida\n"
"(docs/RENAME-KEYBOARD.md)."

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "New alias (max 64 characters, no control characters)"
msgstr "Novo alias (máx. 64 caracteres, sem caracteres de controle)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Restore the keyboard's own name"
msgstr "Restaurar o nome próprio do teclado"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keyboard to rename (default: the one the daemon reports)"
msgstr "Teclado para renomear (por padrão: o indicado pelo serviço)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Write the name stored IN the keyboard (printable ASCII, 1-32 characters); "
"without a value: with --show or --restore"
msgstr ""
"Escrever o nome guardado NO teclado (ASCII imprimível, 1-32 caracteres); sem "
"valor: com --show ou --restore"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Do not ask the confirmation (works without a terminal)"
msgstr "Não pedir a confirmação (funciona sem terminal)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Show the bytes that would be sent, write nothing, no pkexec"
msgstr "Mostrar os bytes que seriam enviados, não escrever nada, sem pkexec"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Whole pre-flight (control-channel MTU read via ONE pkexec, read-only) and "
"backup; nothing written, nothing asked"
msgstr ""
"Verificação prévia completa (MTU do canal de controle lida através de UM "
"pkexec, só leitura) e cópia; nada escrito, nada perguntado"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Accepted for compatibility, no effect: --device-name writes by default"
msgstr ""
"Aceite por compatibilidade, sem efeito: --device-name escreve por padrão"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Show the name stored in the keyboard (daemon cache, no hardware read)"
msgstr ""
"Mostrar o nome guardado no teclado (cache do serviço, sem leitura do "
"hardware)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Write back a backup made by a previous --device-name run"
msgstr "Reescrever uma cópia feita por uma execução anterior de --device-name"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Byte-by-byte detail (frames, wire, proof, [devname] journal)"
msgstr "Detalhe byte a byte (quadros, link, prova, log [devname])"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Follow StateChanged signals: one JSON line per change, until interrupted"
msgstr ""
"Seguir os sinais StateChanged: uma linha JSON por alteração, até ser "
"interrompido"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Battery history (single store: $XDG_STATE_HOME/apple-kb-monitor/"
"history.jsonl)"
msgstr ""
"Histórico da pilha (armazenamento único: $XDG_STATE_HOME/apple-kb-monitor/"
"history.jsonl)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Oldest entry: 90m, 24h, 7d, 2w, YYYY-MM-DD or \"YYYY-MM-DD HH:MM\" (UTC)"
msgstr ""
"Entrada mais antiga: 90m, 24h, 7d, 2w, YYYY-MM-DD ou \"YYYY-MM-DD HH:MM\" "
"(UTC)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Newest entry (same formats)"
msgstr "Entrada mais recente (mesmos formatos)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keep only the last N entries"
msgstr "Manter só as últimas N entradas"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "JSON array on one line instead of the table"
msgstr "Array JSON em uma linha em vez da tabela"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Export the history on stdout"
msgstr "Exportar o histórico para stdout"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "CSV format (the only one; header included)"
msgstr "Formato CSV (o único; cabeçalho incluído)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Import a history file of the former Python CLI into the single store. The "
"source is not modified; existing lines are not duplicated"
msgstr ""
"Importar um arquivo de histórico da antiga CLI Python para o armazenamento "
"único. A origem não é modificada; as linhas existentes não são duplicadas"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "File to import (history.jsonl of the Python CLI)"
msgstr "Arquivo para importar (history.jsonl da CLI Python)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Terminal chart of the battery (percentage and voltage) over 24 h or 7 days"
msgstr "Gráfico no terminal da pilha (percentagem e tensão) em 24 h ou 7 dias"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Time window"
msgstr "Intervalo de tempo"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"JSON for a waybar/polybar custom module (classes: good, warning, critical, "
"disconnected)"
msgstr ""
"JSON para um módulo personalizado do waybar/polybar (classes: good, warning, "
"critical, disconnected)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Prometheus text exposition of the keyboard state (one page)"
msgstr "Exposição de texto Prometheus do estado do teclado (uma página)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Switch a keyboard LED (NumLock can only be switched off)"
msgstr "Ligar/desligar um LED do teclado (o NumLock só pode ser desligado)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Ask the daemon to send WillShutdown (Feature 0x40, id only) to the keyboard, "
"as macOS does at shutdown: once, only if connected and `[apple] "
"will_shutdown` is on. Run by the shutdown unit"
msgstr ""
"Pedir ao serviço que envie WillShutdown (Feature 0x40, só id) ao teclado, "
"como o macOS faz ao encerrar: uma vez, só se conectado e se `[apple] "
"will_shutdown` estiver ativo. Executado pela unidade de encerramento"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Do nothing unless the system is shutting down or restarting (`systemctl is-"
"system-running` = stopping): used by the unit, so that a logout or a service "
"restart never sends it"
msgstr ""
"Não fazer nada a menos que o sistema esteja encerrando ou reiniciando "
"(`systemctl is-system-running` = stopping): usado pela unidade, para que um "
"fim de sessão ou um reinício do serviço nunca o envie"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Send HID_CONTROL SUSPEND (0x13) or EXIT_SUSPEND (0x14) to the connected "
"Apple keyboards, as macOS bluetoothd does at sleep and wake: one byte on the "
"HID control channel of bluetoothd, administrator authentication. The system "
"units send it by themselves at every sleep/wake; this is the manual test. --"
"dry-run writes nothing"
msgstr ""
"Enviar HID_CONTROL SUSPEND (0x13) ou EXIT_SUSPEND (0x14) aos teclados Apple "
"conectados, como o bluetoothd do macOS faz ao suspender e retomar: um byte "
"no canal de controle HID do bluetoothd, autenticação de administrador. As "
"unidades do sistema o enviam sozinhas em cada suspensão/retoma; este é o "
"teste manual. --dry-run não escreve nada"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"suspend: HID_CONTROL SUSPEND, byte 0x13 (what the suspend unit sends before "
"sleep); exit-suspend: HID_CONTROL EXIT_SUSPEND, byte 0x14 (what the resume "
"unit sends at wake)"
msgstr ""
"suspend: HID_CONTROL SUSPEND, byte 0x13 (o que a unidade de suspensão envia "
"antes de suspender); exit-suspend: HID_CONTROL EXIT_SUSPEND, byte 0x14 (o "
"que a unidade de retomada envia ao acordar)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Only this keyboard (must be a connected Apple keyboard)"
msgstr "Só este teclado (tem que ser um teclado Apple conectado)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Show the bluetoothd socket that would be used (pid, fd, MAC, PSM, state) and "
"send nothing"
msgstr ""
"Mostrar o socket do bluetoothd que seria usado (pid, fd, MAC, PSM, estado) e "
"não enviar nada"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Register map of the keyboard (every known HID report: name, size, safety "
"class) with the values the daemon has cached, \"never read\" otherwise. "
"Never reads the keyboard"
msgstr ""
"Mapa de registros do teclado (cada relatório HID conhecido: nome, tamanho, "
"classe de segurança) com os valores na cache do serviço, \"nunca lido\" caso "
"contrário. Nunca lê o teclado"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Machine-readable JSON"
msgstr "JSON legível por máquina"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Firmware version of the keyboard against the embedded table of Apple's "
"public firmware updates, where one exists (read once per connection by the "
"daemon; no network, never flashes)"
msgstr ""
"Versão de firmware do teclado comparada com a tabela integrada das "
"atualizações públicas de firmware da Apple, quando existe (lida uma vez por "
"conexão pelo serviço; sem rede, nunca atualiza o firmware)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Read the 3 allowed HID reports (0x47, 0x46, 0x49) with the safe read policy: "
"no scan, never 0x4C / 0xFE / 0x01. Press a key first (an idle keyboard is "
"left alone)"
msgstr ""
"Ler os 3 relatórios HID permitidos (0x47, 0x46, 0x49) com a política de "
"leitura segura: sem varredura, nunca 0x4C / 0xFE / 0x01. Pressione primeiro "
"uma tecla (um teclado inativo não é tocado)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Diagnose the Bluetooth link in one command (BlueZ, pairing, adapter power "
"management, BlueZ/UPower configuration, journal, hidraw, daemon). Read-only "
"unless --fix; run with sudo to also compare the stored and kernel link keys"
msgstr ""
"Diagnosticar a conexão Bluetooth com um único comando (BlueZ, pareamento, "
"gerenciamento de energia do adaptador, configuração BlueZ/UPower, log, "
"hidraw, serviço). Só leitura exceto com --fix; execute com sudo para "
"comparar também as chaves de link guardada e do kernel"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keyboard to check (default: the paired one)"
msgstr "Teclado para verificar (por padrão: o pareado)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Apply the corrections of the system files the diagnostic proposes (BlueZ "
"main.conf, udev rule of the adapter), through the privileged helper: one "
"administrator authentication, the previous file kept as <name>.akm-bak"
msgstr ""
"Aplicar as correções dos arquivos de sistema propostas pelo diagnóstico "
"(BlueZ main.conf, regra udev do adaptador), através do assistente "
"privilegiado: uma autenticação de administrador, o arquivo anterior é "
"guardado como <name>.akm-bak"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "With --fix: show what would change, write nothing (no password)"
msgstr "Com --fix: mostrar o que mudaria, não escrever nada (sem senha)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"With --fix: also restart bluetooth / upower so the corrected file is read "
"now (drops every Bluetooth link for a few seconds)"
msgstr ""
"Com --fix: reiniciar também bluetooth / upower para que o arquivo corrigido "
"seja lido já (corta todas as conexões Bluetooth durante alguns segundos)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "With --fix: also apply the corrections marked \"optional\" (UPower)"
msgstr ""
"Com --fix: aplicar também as correções marcadas como \"optional\" (UPower)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Guided repair of the link: wake + reconnect first; re-pair only after a "
"typed confirmation (the pairing is never removed otherwise)"
msgstr ""
"Reparação guiada da conexão: primeiro acordar + reconectar; novo pareamento "
"só após uma confirmação escrita (caso contrário o pareamento nunca é "
"removido)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keyboard to repair (default: the paired one)"
msgstr "Teclado para reparar (por padrão: o pareado)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Offer re-pairing even if the link looks healthy"
msgstr "Propor novo pareamento mesmo que a conexão pareça saudável"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Effective table of the special keys (F1-F12, Eject; --all: every known key): "
"physical key -> evdev code (after hwdb and hid_apple, per fnmode) -> keysym "
"-> KDE global shortcut. Never reads a key press, except with --live"
msgstr ""
"Tabela efetiva das teclas especiais (F1-F12, Eject; --all: todas as teclas "
"conhecidas): tecla física -> código evdev (após hwdb e hid_apple, conforme o "
"fnmode) -> keysym -> atalho global do KDE. Nunca lê um toque de tecla, "
"exceto com --live"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Verdict per key ([ok] = a KDE shortcut is bound) and what to test"
msgstr ""
"Veredicto por tecla ([ok] = um atalho do KDE está associado) e o que testar"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "All known keys (modifiers, arrows, Fn...), not only the top row"
msgstr ""
"Todas as teclas conhecidas (modificadores, setas, Fn...), não só a fila "
"superior"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Machine-readable JSON (with the KDE actions)"
msgstr "JSON legível por máquina (com as ações do KDE)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Live view of the key events of the Apple keyboard instead of the table: HID "
"usage, evdev code, name, one line per press and release. Reads the evdev "
"node (read-only, group \"input\"), records nothing. Leave with Escape held 2 "
"s, or Ctrl-C"
msgstr ""
"Vista em direto dos eventos de teclas do teclado Apple em vez da tabela: "
"usage HID, código evdev, nome, uma linha por pressão e libertação. Lê o nó "
"evdev (só leitura, grupo \"input\"), não registra nada. Saia mantendo Escape "
"pressionado 2 s, ou com Ctrl-C"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Manual key mapping without keyd ($XDG_CONFIG_HOME/apple-kb-monitor/"
"keymap.toml -> udev hwdb, installed with administrator authentication)"
msgstr ""
"Mapeamento manual de teclas sem keyd ($XDG_CONFIG_HOME/apple-kb-monitor/"
"keymap.toml -> hwdb udev, instalado com autenticação de administrador)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Show the profiles of keymap.toml (--hwdb: the file `apply` would install)"
msgstr ""
"Mostrar os perfis de keymap.toml (--hwdb: o arquivo que `apply` instalaria)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Remap a key: KEY = F1..F12, Eject, Fn, LeftCmd... or a HID usage (0x7003a); "
"CODE = a KEY_* name of linux/input-event-codes.h. Applied by `apply`"
msgstr ""
"Remapear uma tecla: KEY = F1..F12, Eject, Fn, LeftCmd... ou um usage HID "

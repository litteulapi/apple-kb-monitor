msgstr "o fragmento {i} tem {n} bytes, esperados {expected}"

#: apihub-app/akm-core/src/devname.rs
msgid "bytes after the NUL terminator: refused (not a name this tool restores)"
msgstr ""
"bytes após o terminador NUL: recusado (não é um nome que esta ferramenta "
"restaura)"

#: apihub-app/akm-core/src/devname.rs
msgid "the saved name is empty: refused"
msgstr "o nome salvo está vazio: recusado"

#: apihub-app/akm-core/src/devname.rs

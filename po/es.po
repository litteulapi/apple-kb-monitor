msgid "keyboard not connected"
msgstr "teclado no conectado"

#: apihub-app/akm-core/src/devname.rs
msgid "battery below 20 % and state not 'normal' (or unknown)"
msgstr ""
"pilas por debajo del 20 % y estado distinto de «normal» (o desconocido)"

#: apihub-app/akm-core/src/devname.rs apihub-app/crates/akmctl/src/forget.rs
msgid "circuit breaker open: the keyboard stopped answering"
msgstr "disyuntor abierto: el teclado dejó de responder"

#: apihub-app/akm-core/src/devname.rs
msgid "the last hardware read failed or was incomplete"
msgstr "la última lectura del hardware falló o quedó incompleta"

#: apihub-app/akm-core/src/devname.rs
msgid "`akmctl doctor` is not green (link health, pairing, configuration)"
msgstr ""
"`akmctl doctor` no está en verde (estado del enlace, emparejamiento, "
"configuración)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel unknown: it must be read (akm-"
"helper hid-inspect, read-only) and be >= {min} before a 66-byte frame is sent"
msgstr ""
"MTU de salida del canal de control L2CAP desconocida: debe leerse (akm-"
"helper hid-inspect, solo lectura) y ser >= {min} antes de enviar una trama "
"de 66 bytes"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel is {m}, below {min}: a 66-byte "
"frame cannot be sent in one piece (Linux hidp does not fragment; the HID "
"session would be terminated)"
msgstr ""
"la MTU de salida del canal de control L2CAP es {m}, menor que {min}: una "
"trama de 66 bytes no puede enviarse de una vez (hidp de Linux no fragmenta; "
"la sesión HID se cerraría)"


msgid "Fn key has no effect"
msgstr "Fn 키 효과 없음"

#: apihub-app/akm-core/src/hid_params.rs
msgid "disabled (Fn key has no effect)"
msgstr "disabled (Fn 키가 동작하지 않음)"


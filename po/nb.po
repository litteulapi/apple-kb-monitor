msgid "circuit breaker open: the keyboard stopped answering"
msgstr "bryteren er åpen: tastaturet sluttet å svare"

#: apihub-app/akm-core/src/devname.rs
msgid "the last hardware read failed or was incomplete"
msgstr "den siste maskinvarelesingen mislyktes eller var ufullstendig"

#: apihub-app/akm-core/src/devname.rs
msgid "`akmctl doctor` is not green (link health, pairing, configuration)"
msgstr ""
"`akmctl doctor` er ikke grønn (tilkoblingens tilstand, paring, konfigurasjon)"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel unknown: it must be read (akm-"
"helper hid-inspect, read-only) and be >= {min} before a 66-byte frame is sent"
msgstr ""
"utgående MTU for L2CAP-kontrollkanalen ukjent: den må leses (akm-helper hid-"
"inspect, kun lesing) og være >= {min} før en ramme på 66 byte sendes"

#: apihub-app/akm-core/src/devname.rs
#, rust-format
msgid ""
"outgoing MTU of the L2CAP control channel is {m}, below {min}: a 66-byte "
"frame cannot be sent in one piece (Linux hidp does not fragment; the HID "
"session would be terminated)"
msgstr ""
"utgående MTU for L2CAP-kontrollkanalen er {m}, under {min}: en ramme på 66 "
"byte kan ikke sendes i ett stykke (Linux hidp fragmenterer ikke; HID-økten "
"ville blitt avsluttet)"


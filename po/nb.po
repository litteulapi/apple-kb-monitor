#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Set a hid_apple parameter (fnmode 0-4, iso_layout -1..1, swap_opt_cmd 0-2, "
"swap_ctrl_cmd 0-1, swap_fn_leftctrl 0-1). Global to ALL Apple keyboards"
msgstr ""
"Sett en hid_apple-parameter (fnmode 0-4, iso_layout -1..1, swap_opt_cmd 0-2, "
"swap_ctrl_cmd 0-1, swap_fn_leftctrl 0-1). Felles for ALLE Apple-tastaturer"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Also write it to /etc/modprobe.d/hid_apple.conf"
msgstr "Skriv den også til /etc/modprobe.d/hid_apple.conf"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Rename the keyboard on this computer (BlueZ alias; nothing is written into "
"the keyboard). With --device-name: the name stored IN the keyboard"
msgstr ""
"Gi tastaturet nytt navn på denne datamaskinen (BlueZ-alias; ingenting "
"skrives til tastaturet). Med --device-name: navnet lagret I tastaturet"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"TWO NAMES:\n"
"  akmctl rename <name>                 alias of THIS computer (BlueZ Alias): "
"nothing written into the keyboard\n"
"  akmctl rename --device-name <name>   WRITES the name stored IN the "
"keyboard (seen by every host):\n"
"                                       pre-flight, backup of the current "
"name, ONE confirmation [y/N]\n"
"                                       (--yes skips it and works without a "
"terminal), one write, immediate\n"
"                                       read-back, verdict. No password in "
"the active local session.\n"
"                                       --check: whole pre-flight and backup, "
"nothing written, nothing asked\n"
"                                       --dry-run: shows the bytes, no "
"pkexec, nothing written\n"
"                                       --verbose: frames, wire bytes, proof, "
"[devname] journal\n"
"  akmctl rename --device-name --show   name stored in the keyboard, from the "
"daemon's cache\n"
"  akmctl rename --device-name --restore <backup.json> [--yes]   write a "
"backup back (same flow)\n"
"Exit codes of --device-name: 0 written and read back identical (or --check "
"green), 10 no terminal and\n"
"no --yes, 11 pre-flight refused, 12 cancelled, 13 written but not read back "
"(check with --show),\n"
"14 read back different (rollback command printed), 15 write uncertain (the "
"write failed on its way:\n"
"a frame may have been sent, check with --show). Persistence across a battery "
"change is not measured\n"
"(docs/RENAME-KEYBOARD.md)."
msgstr ""
"TO NAVN:\n"
"  akmctl rename <navn>                 alias på DENNE datamaskinen (BlueZ "
"Alias): ingenting skrives til tastaturet\n"
"  akmctl rename --device-name <navn>   SKRIVER navnet lagret I tastaturet "
"(sett av alle verter):\n"
"                                       forhåndssjekk, sikkerhetskopi av "
"nåværende navn, ÉN bekreftelse [y/N]\n"
"                                       (--yes hopper over den og virker uten "
"terminal), én skriving, umiddelbar\n"
"                                       tilbakelesing, vurdering. Intet "
"passord i den aktive lokale økten.\n"
"                                       --check: full forhåndssjekk og "
"sikkerhetskopi, ingenting skrevet, ingenting spurt\n"
"                                       --dry-run: viser bytene, ingen "
"pkexec, ingenting skrevet\n"
"                                       --verbose: rammer, byte på linjen, "
"bevis, [devname]-journal\n"
"  akmctl rename --device-name --show   navn lagret i tastaturet, fra "
"tjenestens hurtigbuffer\n"
"  akmctl rename --device-name --restore <kopi.json> [--yes]   skriv tilbake "
"en sikkerhetskopi (samme forløp)\n"
"Avslutningskoder for --device-name: 0 skrevet og lest tilbake likt (eller --"
"check grønn), 10 ingen terminal og\n"
"ingen --yes, 11 forhåndssjekk avvist, 12 avbrutt, 13 skrevet, men ikke lest "
"tilbake (sjekk med --show),\n"
"14 lest tilbake ulikt (tilbakerullingskommando skrevet ut), 15 skriving "
"usikker (skrivingen mislyktes underveis:\n"
"en ramme kan ha blitt sendt, sjekk med --show). Varighet etter batteribytte "
"er ikke målt\n"
"(docs/RENAME-KEYBOARD.md)."

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "New alias (max 64 characters, no control characters)"
msgstr "Nytt alias (maks. 64 tegn, ingen kontrolltegn)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Restore the keyboard's own name"
msgstr "Gjenopprett tastaturets eget navn"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keyboard to rename (default: the one the daemon reports)"
msgstr "Tastatur som skal få nytt navn (standard: det tjenesten melder)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Write the name stored IN the keyboard (printable ASCII, 1-32 characters); "
"without a value: with --show or --restore"
msgstr ""
"Skriv navnet lagret I tastaturet (skrivbar ASCII, 1-32 tegn); uten verdi: "
"med --show eller --restore"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Do not ask the confirmation (works without a terminal)"
msgstr "Ikke spør om bekreftelse (virker uten terminal)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Show the bytes that would be sent, write nothing, no pkexec"
msgstr "Vis bytene som ville blitt sendt, skriv ingenting, ingen pkexec"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Whole pre-flight (control-channel MTU read via ONE pkexec, read-only) and "
"backup; nothing written, nothing asked"
msgstr ""
"Full forhåndssjekk (MTU for kontrollkanalen lest via ÉN pkexec, kun lesing) "
"og sikkerhetskopi; ingenting skrevet, ingenting spurt"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Accepted for compatibility, no effect: --device-name writes by default"
msgstr ""
"Godtatt for kompatibilitet, ingen virkning: --device-name skriver som "
"standard"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Show the name stored in the keyboard (daemon cache, no hardware read)"
msgstr ""
"Vis navnet lagret i tastaturet (tjenestens hurtigbuffer, ingen "
"maskinvarelesing)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Write back a backup made by a previous --device-name run"
msgstr ""
"Skriv tilbake en sikkerhetskopi laget av en tidligere kjøring med --device-"
"name"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Byte-by-byte detail (frames, wire, proof, [devname] journal)"
msgstr "Detaljer byte for byte (rammer, linje, bevis, [devname]-journal)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Follow StateChanged signals: one JSON line per change, until interrupted"
msgstr "Følg StateChanged-signaler: én JSON-linje per endring, til avbrudd"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Battery history (single store: $XDG_STATE_HOME/apple-kb-monitor/"
"history.jsonl)"
msgstr ""
"Batterihistorikk (ett enkelt lager: $XDG_STATE_HOME/apple-kb-monitor/"
"history.jsonl)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Oldest entry: 90m, 24h, 7d, 2w, YYYY-MM-DD or \"YYYY-MM-DD HH:MM\" (UTC)"
msgstr ""
"Eldste oppføring: 90m, 24h, 7d, 2w, YYYY-MM-DD eller \"YYYY-MM-DD HH:MM\" "
"(UTC)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Newest entry (same formats)"
msgstr "Nyeste oppføring (samme formater)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keep only the last N entries"
msgstr "Behold bare de siste N oppføringene"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "JSON array on one line instead of the table"
msgstr "JSON-tabell på én linje i stedet for tabellen"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Export the history on stdout"
msgstr "Eksporter historikken til stdout"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "CSV format (the only one; header included)"
msgstr "CSV-format (det eneste; med overskriftslinje)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Import a history file of the former Python CLI into the single store. The "
"source is not modified; existing lines are not duplicated"
msgstr ""
"Importer en historikkfil fra det tidligere Python-CLI-et til det felles "
"lageret. Kilden endres ikke; eksisterende linjer dupliseres ikke"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "File to import (history.jsonl of the Python CLI)"
msgstr "Fil som skal importeres (history.jsonl fra Python-CLI-et)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Terminal chart of the battery (percentage and voltage) over 24 h or 7 days"
msgstr ""
"Terminaldiagram over batteriet (prosent og spenning) over 24 t eller 7 dager"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Time window"
msgstr "Tidsvindu"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"JSON for a waybar/polybar custom module (classes: good, warning, critical, "
"disconnected)"
msgstr ""
"JSON for en egendefinert waybar/polybar-modul (klasser: good, warning, "
"critical, disconnected)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Prometheus text exposition of the keyboard state (one page)"
msgstr "Tastaturets tilstand i Prometheus-tekstformat (én side)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Switch a keyboard LED (NumLock can only be switched off)"
msgstr "Slå en lysdiode på tastaturet av eller på (NumLock kan bare slås av)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Ask the daemon to send WillShutdown (Feature 0x40, id only) to the keyboard, "
"as macOS does at shutdown: once, only if connected and `[apple] "
"will_shutdown` is on. Run by the shutdown unit"
msgstr ""
"Be tjenesten sende WillShutdown (Feature 0x40, bare id) til tastaturet, slik "
"macOS gjør ved avslåing: én gang, bare hvis tilkoblet og `[apple] "
"will_shutdown` er på. Kjøres av avslåingsenheten"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Do nothing unless the system is shutting down or restarting (`systemctl is-"
"system-running` = stopping): used by the unit, so that a logout or a service "
"restart never sends it"
msgstr ""
"Ikke gjør noe med mindre systemet slås av eller startes på nytt (`systemctl "
"is-system-running` = stopping): brukes av enheten, slik at en utlogging "
"eller omstart av tjenesten aldri sender det"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Send HID_CONTROL SUSPEND (0x13) or EXIT_SUSPEND (0x14) to the connected "
"Apple keyboards, as macOS bluetoothd does at sleep and wake: one byte on the "
"HID control channel of bluetoothd, administrator authentication. The system "
"units send it by themselves at every sleep/wake; this is the manual test. --"
"dry-run writes nothing"
msgstr ""
"Send HID_CONTROL SUSPEND (0x13) eller EXIT_SUSPEND (0x14) til de tilkoblede "
"Apple-tastaturene, slik bluetoothd i macOS gjør ved hvilemodus og "
"oppvåkning: én byte på HID-kontrollkanalen til bluetoothd, "
"administratorautentisering. Systemenhetene sender det selv ved hver hvile/"
"oppvåkning; dette er den manuelle testen. --dry-run skriver ingenting"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"suspend: HID_CONTROL SUSPEND, byte 0x13 (what the suspend unit sends before "
"sleep); exit-suspend: HID_CONTROL EXIT_SUSPEND, byte 0x14 (what the resume "
"unit sends at wake)"
msgstr ""
"suspend: HID_CONTROL SUSPEND, byte 0x13 (det hvilemodusenheten sender før "
"hvilemodus); exit-suspend: HID_CONTROL EXIT_SUSPEND, byte 0x14 (det "
"gjenopptakingsenheten sender ved oppvåkning)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Only this keyboard (must be a connected Apple keyboard)"
msgstr "Bare dette tastaturet (må være et tilkoblet Apple-tastatur)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Show the bluetoothd socket that would be used (pid, fd, MAC, PSM, state) and "
"send nothing"
msgstr ""
"Vis bluetoothd-socketen som ville blitt brukt (pid, fd, MAC, PSM, tilstand), "
"og send ingenting"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Register map of the keyboard (every known HID report: name, size, safety "
"class) with the values the daemon has cached, \"never read\" otherwise. "
"Never reads the keyboard"
msgstr ""
"Registeroversikt over tastaturet (hver kjente HID-rapport: navn, størrelse, "
"sikkerhetsklasse) med verdiene fra tjenestens hurtigbuffer, ellers \"aldri "
"lest\". Leser aldri tastaturet"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Machine-readable JSON"
msgstr "Maskinlesbar JSON"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Firmware version of the keyboard against the embedded table of Apple's "
"public firmware updates, where one exists (read once per connection by the "
"daemon; no network, never flashes)"
msgstr ""
"Tastaturets fastvareversjon sammenlignet med den innebygde tabellen over "
"Apples offentlige fastvareoppdateringer, der en slik finnes (leses én gang "
"per tilkobling av tjenesten; intet nettverk, flasher aldri)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Read the 3 allowed HID reports (0x47, 0x46, 0x49) with the safe read policy: "
"no scan, never 0x4C / 0xFE / 0x01. Press a key first (an idle keyboard is "
"left alone)"
msgstr ""
"Les de 3 tillatte HID-rapportene (0x47, 0x46, 0x49) med den sikre "
"lesepolicyen: ingen skanning, aldri 0x4C / 0xFE / 0x01. Trykk først på en "
"tast (et inaktivt tastatur får være i fred)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Diagnose the Bluetooth link in one command (BlueZ, pairing, adapter power "
"management, BlueZ/UPower configuration, journal, hidraw, daemon). Read-only "
"unless --fix; run with sudo to also compare the stored and kernel link keys"
msgstr ""
"Diagnostiser Bluetooth-forbindelsen med én kommando (BlueZ, paring, "
"adapterens strømstyring, BlueZ/UPower-oppsett, journal, hidraw, tjeneste). "
"Bare lesing med mindre --fix; kjør med sudo for også å sammenligne lagret "
"nøkkel med kjernens forbindelsesnøkkel"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keyboard to check (default: the paired one)"
msgstr "Tastatur som skal sjekkes (standard: det parede)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Apply the corrections of the system files the diagnostic proposes (BlueZ "
"main.conf, udev rule of the adapter), through the privileged helper: one "
"administrator authentication, the previous file kept as <name>.akm-bak"
msgstr ""
"Bruk rettingene av systemfiler som diagnosen foreslår (BlueZ main.conf, "
"adapterens udev-regel), via den privilegerte hjelperen: én "
"administratorautentisering, forrige fil beholdt som <navn>.akm-bak"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "With --fix: show what would change, write nothing (no password)"
msgstr "Med --fix: vis hva som ville endres, skriv ingenting (intet passord)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"With --fix: also restart bluetooth / upower so the corrected file is read "
"now (drops every Bluetooth link for a few seconds)"
msgstr ""
"Med --fix: start også bluetooth / upower på nytt slik at den rettede filen "
"leses nå (bryter alle Bluetooth-forbindelser i noen sekunder)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "With --fix: also apply the corrections marked \"optional\" (UPower)"
msgstr "Med --fix: bruk også rettingene merket \"valgfri\" (UPower)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Guided repair of the link: wake + reconnect first; re-pair only after a "
"typed confirmation (the pairing is never removed otherwise)"
msgstr ""
"Veiledet reparasjon av forbindelsen: vekking + gjentilkobling først; ny "
"paring bare etter en skrevet bekreftelse (ellers fjernes paringen aldri)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Keyboard to repair (default: the paired one)"
msgstr "Tastatur som skal repareres (standard: det parede)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Offer re-pairing even if the link looks healthy"
msgstr "Tilby ny paring selv om forbindelsen ser frisk ut"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Effective table of the special keys (F1-F12, Eject; --all: every known key): "
"physical key -> evdev code (after hwdb and hid_apple, per fnmode) -> keysym "
"-> KDE global shortcut. Never reads a key press, except with --live"
msgstr ""
"Faktisk tabell over spesialtastene (F1-F12, Eject; --all: alle kjente "
"taster): fysisk tast -> evdev-kode (etter hwdb og hid_apple, per fnmode) -> "
"keysym -> global KDE-snarvei. Leser aldri et tastetrykk, unntatt med --live"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Verdict per key ([ok] = a KDE shortcut is bound) and what to test"
msgstr ""
"Vurdering per tast ([ok] = en KDE-snarvei er bundet) og hva som skal testes"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "All known keys (modifiers, arrows, Fn...), not only the top row"
msgstr ""
"Alle kjente taster (modifikatorer, piltaster, Fn...), ikke bare den øverste "
"raden"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Machine-readable JSON (with the KDE actions)"
msgstr "Maskinlesbar JSON (med KDE-handlingene)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Live view of the key events of the Apple keyboard instead of the table: HID "
"usage, evdev code, name, one line per press and release. Reads the evdev "
"node (read-only, group \"input\"), records nothing. Leave with Escape held 2 "
"s, or Ctrl-C"
msgstr ""
"Direktevisning av Apple-tastaturets tastehendelser i stedet for tabellen: "
"HID-bruk, evdev-kode, navn, én linje per trykk og slipp. Leser evdev-noden "
"(bare lesing, gruppen \"input\"), tar ikke opp noe. Avslutt ved å holde "
"Escape i 2 s, eller Ctrl-C"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Manual key mapping without keyd ($XDG_CONFIG_HOME/apple-kb-monitor/"
"keymap.toml -> udev hwdb, installed with administrator authentication)"
msgstr ""
"Manuell tastetilordning uten keyd ($XDG_CONFIG_HOME/apple-kb-monitor/"
"keymap.toml -> udev hwdb, installert med administratorautentisering)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Show the profiles of keymap.toml (--hwdb: the file `apply` would install)"
msgstr ""
"Vis profilene i keymap.toml (--hwdb: filen som `apply` ville installert)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"Remap a key: KEY = F1..F12, Eject, Fn, LeftCmd... or a HID usage (0x7003a); "
"CODE = a KEY_* name of linux/input-event-codes.h. Applied by `apply`"
msgstr ""

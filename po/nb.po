msgstr "Maskinlesbar JSON (skjema 1) på én linje"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print help"
msgstr "Vis hjelp"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Read a setting"
msgstr "Les en innstilling"

#: apihub-app/crates/akmctl/src/cli_strings.rs

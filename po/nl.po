#: apihub-app/crates/akmctl/src/cli_i18n.rs
msgid "Options"
msgstr "Opties"

#: apihub-app/crates/akmctl/src/cli_i18n.rs
msgid "Arguments"
msgstr "Argumenten"

#: apihub-app/crates/akmctl/src/cli_i18n.rs
msgid "Usage:"
msgstr "Gebruik:"


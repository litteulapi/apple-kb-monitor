msgid "Measured on the keyboard (firmware 0x0050):\n"
msgstr "Zmierzone na klawiaturze (oprogramowanie 0x0050):\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
msgid "Not measured:\n"
msgstr "Niezmierzone:\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
msgid "Experiments:\n"
msgstr "Eksperymenty:\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs

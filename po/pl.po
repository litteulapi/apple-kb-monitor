#: apihub-app/crates/akmctl/src/devnamecmd.rs
#, rust-format
msgid ""
"Pre-flight: ok (doctor green, breaker closed, outgoing MTU {mtu} >= {min})\n"
msgstr ""
"Kontrola wstępna: ok (doctor na zielono, bezpiecznik zamknięty, wychodzące "
"MTU {mtu} >= {min})\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
msgid "Pre-flight: ok (doctor green, breaker closed)\n"
msgstr "Kontrola wstępna: ok (doctor na zielono, bezpiecznik zamknięty)\n"


msgstr ""
"Odrzucono: ta kopia zapasowa pochodzi z klawiatury {backup}, klawiatura "
"docelowa to {target}. Niczego nie zmieniono.\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
msgid ""
"✓ --check: pre-flight green, backup made, nothing was written, nothing was "
"asked.\n"
msgstr ""
"✓ --check: kontrola wstępna na zielono, kopia wykonana, nic nie zapisano, o "
"nic nie pytano.\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs
msgid "Cancelled: nothing was written into the keyboard.\n"
msgstr "Anulowano: nic nie zapisano w klawiaturze.\n"

#: apihub-app/crates/akmctl/src/devnamecmd.rs

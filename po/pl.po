msgstr "JSON do odczytu maszynowego (schemat 1) w jednym wierszu"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print help"
msgstr "Wyświetl pomoc"

#: apihub-app/crates/akmctl/src/cli_strings.rs

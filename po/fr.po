msgid ""
"Control and query the Apple keyboard monitor (apple-kb-monitord).\n"
"\n"
"The Fn mode is a parameter of the hid_apple kernel module: it applies to ALL "
"Apple keyboards connected to this computer, not to a single one. Changing it "
"requires administrator rights (polkit authentication)."
msgstr ""
"Piloter et interroger le moniteur de clavier Apple (apple-kb-monitord).\n"
"\n"
"Le mode Fn est un paramètre du module noyau hid_apple : il s'applique à TOUS "
"les claviers Apple connectés à cet ordinateur, pas à un seul. Le changer "
"demande les droits d'administrateur (authentification polkit)."

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid ""
"EXIT CODES:\n"
"  0   success\n"
"  1   error (D-Bus failure, write refused, bad data)\n"
"  2   daemon absent (apple-kb-monitord not on the session bus)\n"
"  64  usage error (invalid arguments)\n"
"\n"
"FN MODES (hid_apple.fnmode, global to every Apple keyboard):\n"
"  0  disabled   Fn key has no effect\n"
"  1  fkeyslast  media keys by default, Fn+Fx = F-key\n"
"  2  fkeysfirst F-keys by default, Fn+Fx = media key\n"
"  3  auto       kernel default: = 1 on an Apple keyboard\n"
"  4  fkeysdisabled F-keys disabled (media keys only)"
msgstr ""
"CODES DE SORTIE :\n"
"  0   succès\n"
"  1   erreur (échec D-Bus, écriture refusée, données invalides)\n"
"  2   démon absent (apple-kb-monitord absent du bus de session)\n"
"  64  erreur d'utilisation (arguments invalides)\n"
"\n"
"MODES FN (hid_apple.fnmode, commun à tous les claviers Apple) :\n"
"  0  disabled   la touche Fn n'a aucun effet\n"
"  1  fkeyslast  touches multimédia par défaut, Fn+Fx = touche F\n"
"  2  fkeysfirst touches F par défaut, Fn+Fx = touche multimédia\n"
"  3  auto       défaut du noyau : = 1 sur un clavier Apple\n"
"  4  fkeysdisabled touches F désactivées (touches multimédia seules)"

#: apihub-app/crates/akmctl/src/cli_strings.rs
msgid "Print help (see more with '--help')"
msgstr "Afficher l'aide (plus de détails avec '--help')"

#: apihub-app/crates/akmctl/src/cli_strings.rs

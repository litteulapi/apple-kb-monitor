#!/usr/bin/env bash
# Pre-push guard: the fast subset of scripts/ci-local.sh (version
# consistency, secrets, rustfmt on changed files, clippy -D warnings, the
# whole test suite with a hang timeout, shell syntax). A failure REFUSES the
# push; the report is in scripts/out/latest/.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass (emergency only, say why in the commit): git push --no-verify
set -uo pipefail
top=$(git rev-parse --show-toplevel) || exit 1

# Only deletions pushed (local sha all zeros), or nothing: nothing to check.
any=0
while read -r _lref lsha _rref _rsha; do
  [ "$lsha" != 0000000000000000000000000000000000000000 ] && any=1
done
[ $any = 0 ] && exit 0

# The checks run on the working tree: refuse if it differs from what is pushed.
if [ -n "$(git -C "$top" status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: uncommitted changes in tracked files; the checks would not test what you push." >&2
  echo "          commit or stash them first (git stash -k), then push again." >&2
  exit 1
fi

echo "pre-push: scripts/ci-local.sh --fast (fmt, clippy, tests, secrets, versions)..." >&2
if ! AKM_CI_TEST_TIMEOUT=${AKM_CI_TEST_TIMEOUT:-600} "$top/scripts/ci-local.sh" --fast >&2; then
  echo "" >&2
  echo "pre-push: REFUSED - fix the failing step (report: scripts/out/latest/report.txt)" >&2
  exit 1
fi

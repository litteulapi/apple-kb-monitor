[Unit]
Description=Apple Wireless Keyboard telemetry monitor and BlueZ battery provider (system)
Documentation=https://gitea.pika.agenceapi.fr/adminapi/apple-kb-monitor
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/apple-kb-monitor --threshold 15 --interval 300
Restart=on-failure
RestartSec=10
# Hardening
ProtectHome=read-only
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target

[Unit]
Description=MQTT-DDC Bridge for LG 34GN850
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/adminapi/apple-kb-monitor/mqtt-bridge.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

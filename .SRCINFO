pkgbase = apple-kb-monitor
	pkgdesc = Telemetry and key mapping for Apple Bluetooth keyboards (BCM2042/BCM20733): battery, voltage, RSSI, BlueZ battery provider, KDE integration
	pkgver = 3.1.0
	pkgrel = 6
	url = https://gitea.pika.agenceapi.fr/adminapi/apple-kb-monitor
	install = apple-kb-monitor.install
	arch = x86_64
	license = GPL-2.0-or-later
	makedepends = rust
	makedepends = gcc
	depends = bluez
	depends = keyd
	depends = polkit
	depends = dbus
	depends = systemd
	depends = libcap
	depends = wayland
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = libglvnd
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxrandr
	optdepends = bluez-utils: bluetoothctl CLI for BT management
	optdepends = libnotify: desktop notifications on low battery
	options = !lto
	backup = etc/keyd/apple-keyboard.conf
	backup = etc/modprobe.d/hid_apple.conf
	source = com.agenceapi.AppleKbMonitor.desktop
	sha256sums = SKIP

pkgname = apple-kb-monitor
